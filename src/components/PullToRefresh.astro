<div id="pull-to-refresh" aria-hidden="true" hidden>
  <span class="refresh-wheel">
    {Array.from({ length: 8 }, (_, index) => (
      <span class="refresh-spoke" style={`--spoke: ${index}`}></span>
    ))}
  </span>
</div>
<span id="pull-to-refresh-status" role="status"></span>

<script>
  const indicator = document.getElementById('pull-to-refresh');
  const status = document.getElementById('pull-to-refresh-status');
  const standalone = matchMedia('(display-mode: standalone)').matches ||
    ('standalone' in navigator && navigator.standalone === true);

  if (standalone && indicator && status) {
    const root = document.documentElement;
    const threshold = 80;
    const slop = 12;
    const passive = { passive: true };
    let start: Touch | undefined;
    let refreshing = false;

    const atTop = () => window.scrollY <= 0 && (window.visualViewport?.scale ?? 1) === 1;
    const showProgress = (distance: number) => {
      const pull = Math.max(0, distance - slop);
      const offset = 96 * (1 - Math.exp(-pull / 100));
      const progress = Math.min(1, pull / (threshold - slop));
      root.style.setProperty('--app-pull-offset', `${offset}px`);
      root.toggleAttribute('data-pull-open', offset > 0);
      indicator.style.setProperty('--visible-spokes', String(Math.ceil(progress * 8)));
      if (offset > 0) indicator.hidden = false;
    };
    const reset = () => {
      start = undefined;
      root.removeAttribute('data-pull-dragging');
      if (!refreshing) {
        root.removeAttribute('data-pull-open');
        root.style.removeProperty('--app-pull-offset');
      }
    };
    const isNestedScroll = (target: Element) => {
      for (let element: Element | null = target; element && element !== document.body; element = element.parentElement) {
        if (element.scrollHeight > element.clientHeight && /^(auto|scroll)$/.test(getComputedStyle(element).overflowY)) {
          return true;
        }
      }
      return false;
    };

    root.classList.add('app-pull-to-refresh');

    document.addEventListener('touchstart', event => {
      reset();
      if (refreshing || event.touches.length !== 1 || !atTop()) return;
      const target = event.target;
      if (!(target instanceof Element) ||
          target.closest('input, textarea, select, [contenteditable], dialog, [role="dialog"]') ||
          isNestedScroll(target)) return;
      start = event.touches[0];
      root.setAttribute('data-pull-dragging', '');
    }, passive);

    document.addEventListener('touchmove', event => {
      if (!start) return;
      if (event.touches.length !== 1 || !atTop()) {
        reset();
        return;
      }
      const touch = event.touches[0];
      const down = touch.clientY - start.clientY;
      const across = Math.abs(touch.clientX - start.clientX);
      if (down < -slop || (across > slop && across >= down)) {
        reset();
        return;
      }
      showProgress(down);
    }, passive);

    document.addEventListener('touchend', event => {
      if (!start) return;
      const touch = event.changedTouches[0];
      const down = touch.clientY - start.clientY;
      const across = Math.abs(touch.clientX - start.clientX);
      if (touch.identifier !== start.identifier || event.touches.length ||
          !atTop() || down < threshold || down <= across) {
        reset();
        return;
      }
      refreshing = true;
      reset();
      showProgress(threshold);
      indicator.dataset.refreshing = '';
      status.textContent = '새로고침 중';
      requestAnimationFrame(() => requestAnimationFrame(() => window.location.reload()));
    }, passive);

    document.addEventListener('touchcancel', reset, passive);
    window.addEventListener('pageshow', event => {
      if (!event.persisted) return;
      refreshing = false;
      delete indicator.dataset.refreshing;
      status.textContent = '';
      reset();
    });
  }
</script>

<style>
  :global(html.app-pull-to-refresh) { overscroll-behavior-y: none; }
  :global(html.app-pull-to-refresh > body) { transition: translate 180ms ease-out; }
  :global(html.app-pull-to-refresh[data-pull-open] > body) { translate: 0 var(--app-pull-offset); }
  :global(html.app-pull-to-refresh[data-pull-dragging] > body) { transition-duration: 0s; }
  #pull-to-refresh {
    position: absolute;
    bottom: 100%;
    inset-inline: 0;
    height: var(--app-pull-offset, 0px);
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    background: #f6f6f6;
    pointer-events: none;
    transition: height 180ms ease-out;
  }
  #pull-to-refresh[hidden] { display: none; }
  :global(html[data-pull-dragging]) #pull-to-refresh { transition-duration: 0s; }
  .refresh-wheel { display: block; position: relative; width: 22px; height: 22px; }
  .refresh-spoke {
    position: absolute;
    inset: 0;
    transform: rotate(calc(var(--spoke) * 45deg));
    opacity: clamp(.15, calc(var(--visible-spokes) - var(--spoke)), .85);
  }
  .refresh-spoke::before {
    content: '';
    position: absolute;
    top: 0;
    left: 10px;
    width: 2px;
    height: 6px;
    border-radius: 2px;
    background: #777;
  }
  #pull-to-refresh[data-refreshing] .refresh-spoke { opacity: calc(.9 - var(--spoke) * .1); }
  #pull-to-refresh[data-refreshing] .refresh-wheel { animation: refresh-spin .85s steps(8) infinite; }
  @keyframes refresh-spin { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) {
    :global(html.app-pull-to-refresh > body), #pull-to-refresh { transition-duration: 0s; }
    #pull-to-refresh[data-refreshing] .refresh-wheel { animation: none; }
  }
  #pull-to-refresh-status {
    position: fixed;
    top: 0;
    left: 0;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
</style>
