---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';
import NumberPad from './NumberPad.astro';
import { board, size } from '../lib/kakuro.js';
const puzzleId = '261118_01';
---
<PuzzleLayout title="261118 카쿠로" {puzzleId}
  subtitle="가로·세로 단서의 합에 맞춰 흰 칸에 1~9를 채우세요"
  description="가로·세로 합 단서에 맞춰 흰 칸을 채우는 카쿠로">
  <div slot="rules">
    <p>모든 흰 칸에 1부터 9까지의 숫자를 하나씩 채우세요.</p>
    <ul>
      <li>가로나 세로로 이어진 흰 칸에는 합 힌트가 없어도 같은 숫자를 두 번 사용할 수 없습니다.</li>
      <li>회색 칸으로 나뉘어 있다면 같은 행이나 열에서도 같은 숫자를 사용할 수 있습니다.</li>
      <li>회색 칸의 오른쪽 위 숫자는 바로 오른쪽으로 이어진 흰 칸들의 합이고, 왼쪽 아래 숫자는 바로 아래로 이어진 흰 칸들의 합입니다.</li>
    </ul>
  </div>
  <div slot="controls">흰 칸을 누른 뒤 숫자 버튼으로 입력하세요. 메모하기 버튼이나 M으로 메모 입력을 켜고 끄세요. 지우기로 선택한 칸의 숫자와 메모를 지우세요.</div>
  <section id="kakuroGame" data-puzzle-id={puzzleId} aria-label="카쿠로">
    <div class="board-tools"><button id="kakuroNotes" type="button" aria-pressed="false">메모하기</button></div>
    <div id="kakuroBoard" role="grid" aria-label="9행 9열 카쿠로 격자">
      {board.flat().map((clue, index) => {
        const position = `${Math.floor(index / size) + 1}행 ${index % size + 1}열`;
        return clue === null
          ? <button type="button" role="gridcell" class="kakuro-cell" data-index={index} tabindex="-1" aria-label={`${position}, 빈칸`} />
          : <div role="gridcell" class:list={['kakuro-clue', { diagonal: clue.right || clue.down, right: clue.right, down: clue.down }]}
              aria-label={[`${position}, 회색 칸`, clue.right && `오른쪽 합 ${clue.right}`, clue.down && `아래 합 ${clue.down}`].filter(Boolean).join(', ')}>
              {clue.right && <span class="right-sum" data-clue={`${index}-right`}>{clue.right}</span>}
              {clue.down && <span class="down-sum" data-clue={`${index}-down`}>{clue.down}</span>}
            </div>;
      })}
    </div>
    <NumberPad max={9} />
    <div class="bottom-buttons"><button id="kakuroErase" type="button">지우기</button><button id="kakuroReset" class="danger" type="button">초기화</button></div>
    <p id="kakuroStatus" class="sr-only" role="status" aria-live="polite"></p>
  </section>
  <PuzzleCompletion slot="completion" id="kakuroComplete" />
</PuzzleLayout>
<script>import '../scripts/kakuro.js';</script>
<style>
  p{margin:0}ul{padding-left:20px;margin-bottom:0}
  #kakuroGame{width:100%;max-width:480px;margin-inline:auto}
  .board-tools{display:flex;justify-content:flex-end;margin-bottom:8px}
  #kakuroNotes{background:none;border:0;border-bottom:1px solid #ccc;border-radius:0;padding:0 0 1px;color:#888;font:inherit;font-size:.82rem;cursor:pointer}
  #kakuroNotes[aria-pressed=true]{color:#4a6fa5;border-color:#4a6fa5;font-weight:700}
  #kakuroBoard{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));border:2px solid #444;background:#fff;user-select:none;-webkit-user-select:none}
  .kakuro-cell,.kakuro-clue{position:relative;aspect-ratio:1;min-width:0;box-sizing:border-box;border:0;border-right:1px solid #aaa;border-bottom:1px solid #aaa;border-radius:0;padding:0;margin:0;font-family:inherit;font-variant-numeric:tabular-nums}
  #kakuroBoard>:nth-child(9n){border-right:0}#kakuroBoard>:nth-last-child(-n+9){border-bottom:0}
  .kakuro-cell{appearance:none;display:flex;align-items:center;justify-content:center;background:#fff;color:#4a6fa5;font-size:clamp(18px,5vw,27px);font-weight:700;cursor:pointer;touch-action:manipulation;-webkit-tap-highlight-color:transparent}
  .kakuro-cell.selected{background:#e8edf5}.kakuro-cell.conflict{background:#fbeaea;color:#b05050}
  #kakuroGame :global(button:focus){outline:none;box-shadow:none}
  .kakuro-clue{background:#575757;color:#181818;font-size:clamp(12px,3.4vw,19px);font-weight:700;line-height:1}
  .kakuro-clue.diagonal{background:linear-gradient(to top right,var(--lower,#575757) calc(50% - .65px),#444 50%,var(--upper,#575757) calc(50% + .65px))}
  .kakuro-clue.right{--upper:#ccc}.kakuro-clue.down{--lower:#ccc}
  [data-clue].satisfied{color:#236332}
  .right-sum{position:absolute;right:7%;top:9%}.down-sum{position:absolute;left:7%;bottom:8%}
  .kakuro-cell :global(.notes){position:absolute;inset:3px;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);font-size:clamp(8px,2.1vw,12px);font-weight:500;color:#606975}
  .kakuro-cell :global(.notes span){display:flex;align-items:center;justify-content:center}
  .bottom-buttons{gap:8px}.bottom-buttons button{flex:1;min-width:0}
  .sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
</style>
