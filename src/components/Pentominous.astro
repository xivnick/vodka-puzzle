---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';
import { pentominous260929 as puzzle, pentominoes } from '../lib/pentominous.js';
const puzzleId = 'test-pentominous-260929';
const shapeOrder = 'FILNPTUVWXYZ'.split('');
---
<PuzzleLayout
  title="260929 펜토미너스"
  {puzzleId}
  subtitle="격자를 펜토미노 영역으로 나누세요"
  description="알파벳 단서를 따라 격자를 펜토미노로 분할하는 퍼즐"
  showCloud={false}
  showLeaderboard={false}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div slot="rules">
    <p>격자를 아래 규칙을 따르는 펜토미노들로 완전히 분할하세요.</p>
    <ul>
      <li>펜토미노는 자유롭게 돌리거나 뒤집을 수 있습니다.</li>
      <li>같은 모양의 펜토미노끼리는 변을 맞댈 수 없습니다. 대각선으로는 닿아도 됩니다.</li>
      <li>알파벳 칸은 해당 모양의 펜토미노가 차지해야 합니다.</li>
      <li>한 영역에 알파벳이 여러 개 있거나 없어도 됩니다. 같은 펜토미노를 여러 번 사용할 수 있으며, 쓰지 않는 모양이 있어도 됩니다.</li>
    </ul>
  </div>
  <div slot="controls">
    <p>칸 사이의 선을 누르거나 선을 따라 드래그하여 영역의 경계를 그리세요. 그려진 선을 다시 누르거나 드래그하면 지워집니다.</p>
    <p>키보드에서는 방향키로 칸을 옮기고 Shift + 방향키로 이동한 방향의 경계를 그리거나 지웁니다. Ctrl/⌘ + Z로 되돌릴 수 있습니다.</p>
  </div>
  <section id="pentominousGame" data-puzzle={JSON.stringify(puzzle)} aria-label="260929 펜토미너스">
    <svg id="pentominousBoard" role="application" tabindex="0" aria-label="15행 15열 펜토미너스 격자. 칸 사이의 경계를 누르거나 드래그하세요"></svg>
    <div class="bottom-buttons">
      <button id="pentominousUndo" type="button">되돌리기</button>
      <button id="pentominousReset" class="danger" type="button">초기화</button>
    </div>
    <p id="pentominousStatus" role="status" aria-live="polite" class="sr-only"></p>
    <PuzzleCompletion id="pentominousComplete" />
    <details class="shape-reference">
      <summary>펜토미노 모양 보기</summary>
      <div class="shape-grid">
        {shapeOrder.map(name => {
          const points = pentominoes[name];
          const width = Math.max(...points.map(([x]) => x)) + 1;
          const height = Math.max(...points.map(([, y]) => y)) + 1;
          return <div class="shape-item" aria-label={`${name} 펜토미노`}>
            <strong>{name}</strong>
            <svg viewBox={`0 0 ${width * 20} ${height * 20}`} aria-hidden="true">
              {points.map(([x, y]) => <rect x={x * 20 + 1} y={y * 20 + 1} width="18" height="18" rx="2" />)}
            </svg>
          </div>;
        })}
      </div>
    </details>
  </section>
</PuzzleLayout>
<script>import '../scripts/pentominous.js';</script>
<style>
  p { margin: 0; }
  ul { padding-left: 20px; margin: 8px 0 0; }
  #pentominousBoard { display: block; width: 100%; height: auto; background: white; touch-action: none; user-select: none; }
  #pentominousBoard:focus { outline: none; }
  #pentominousBoard:focus-visible { outline: 2px solid #4a6fa5; outline-offset: 3px; }
  .shape-reference { margin-top: 22px; font-size: 14px; }
  .shape-reference summary { color: #4a6fa5; cursor: pointer; }
  .shape-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 12px 4px; margin-top: 12px; }
  .shape-item { display: flex; flex-direction: column; align-items: center; gap: 4px; min-height: 82px; }
  .shape-item svg { width: 42px; height: 58px; fill: #dce8f5; }
  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
  @media (max-width: 420px) { .shape-grid { grid-template-columns: repeat(4, 1fr); } }
</style>
