---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';
import NumberPad from './NumberPad.astro';

const { puzzle, title = puzzle.title, puzzleId = puzzle.id, preview = false } = Astro.props;
const size = puzzle.givens.length;
const givens = puzzle.givens.flat();

---
<PuzzleLayout
  title={title}
  puzzleId={puzzleId}
  subtitle="바깥의 두 숫자가 서로의 위치를 가리키도록 채우세요"
  description="바깥 단서의 두 참조 조건 중 하나 이상을 만족하는 스도쿠"
  preview={preview} showCloud={!preview}
  showLeaderboard={!preview}
>
  <div slot="rules" class="mutual-rules">
    <p>각 가로줄, 세로줄, 3×3 영역에 1부터 9까지의 숫자가 한 번씩 들어가도록 채우세요.</p>
    <p>격자 바깥의 각 숫자 쌍을 X와 Y라고 할 때, 그쪽 가장자리에서 세어 다음 조건 중 적어도 하나를 만족해야 합니다.</p>
    <p>① Y번째 칸의 숫자가 X입니다.<br />② X번째 칸의 숫자가 Y입니다.</p>
    <p>예를 들어 단서가 2와 5이면, 그 방향의 5번째 칸이 2이거나 2번째 칸이 5여야 합니다. 두 조건을 모두 만족해도 됩니다.</p>
  </div>
  <div slot="controls">
    칸을 누른 뒤 숫자 버튼으로 입력하세요.<br />
    메모하기 버튼이나 M을 눌러 메모 입력을 켜고 끄세요.<br />
    다른 칸을 눌러 이동하고, 지우기로 숫자와 메모를 지우세요.
  </div>
  <section
    id="mutualGame"
    class="mutual-game"
    data-puzzle={JSON.stringify(puzzle)}
    data-puzzle-id={puzzleId}
    data-preview={String(preview)}
    style={`--sudoku-size:${size}`}
    aria-label={title}
  >
    <div class="mutual-board-tools"><button id="mutualNotes" class="mutual-notes-toggle" type="button" tabindex="-1" aria-pressed="false">메모하기</button></div>
    <div class="mutual-frame">
      {Object.entries(puzzle.clues).map(([side, clues]) => clues.map((pair, index) => {
        if (!pair) return null;
        const vertical = side === 'top' || side === 'bottom';
        const style = vertical
          ? `grid-column:${index + 2};grid-row:${side === 'top' ? 1 : 11}`
          : `grid-row:${index + 2};grid-column:${side === 'left' ? 1 : 11}`;
        return <span class:list={['mutual-clue', { vertical }]} style={style} data-clue={`${side}-${index}`} aria-label={`${{top:'위쪽',bottom:'아래쪽',left:'왼쪽',right:'오른쪽'}[side]} ${index + 1}${vertical ? '열' : '행'} 단서 ${pair.join(', ')}`}><span>{pair[0]}</span><span>{pair[1]}</span></span>;
      }))}
    <div id="mutualBoard" class="mutual-board" role="grid" aria-label={`${size}행 ${size}열 상호 지시 스도쿠`}>
      {givens.map((given, index) => {
        const row = Math.floor(index / size);
        const column = index % size;
        return <button
          type="button"
          role="gridcell"
          class:list={['mutual-cell', { given: Boolean(given) }]}
          data-cell={index}
          tabindex={index === 0 ? '0' : '-1'}
          aria-label={`${row + 1}행 ${column + 1}열${given ? `, 주어진 숫자 ${given}` : ', 빈칸'}`}
        >{given || ''}</button>;
      })}
    </div>
    </div>
    <div class="mutual-input"><NumberPad id="mutualNumbers" max={size} /></div>
    <div class="bottom-buttons">
      <button id="mutualErase" type="button">지우기</button>
      <button id="mutualReset" class="danger" type="button">초기화</button>
    </div>
    <span id="mutualStatus" class="sr-only" role="status" aria-live="polite"></span>
  </section>
  <PuzzleCompletion slot="completion" id="mutualComplete" />
</PuzzleLayout>
<script>import '../scripts/mutual-sudoku.js';</script>
<style>
.mutual-rules{line-height:1.7}.mutual-rules p{margin:0}.mutual-rules p+p{margin-top:8px}
.mutual-game{width:100%;margin-inline:auto}.mutual-board-tools{display:flex;justify-content:flex-end;margin-bottom:8px}.mutual-notes-toggle{background:none;border:0;border-bottom:1px solid #ccc;border-radius:0;padding:0 0 1px;color:#888;font-family:inherit;font-size:.82rem;line-height:1.5;cursor:pointer}.mutual-notes-toggle[aria-pressed=true]{color:#4a6fa5;border-color:#4a6fa5;font-weight:700}
.mutual-board{grid-column:2 / 11;grid-row:2 / 11;display:grid;grid-template-columns:repeat(var(--sudoku-size),minmax(0,1fr));border:2px solid #444;background:#fff}
.mutual-cell{appearance:none;position:relative;display:flex;align-items:center;justify-content:center;aspect-ratio:1;min-width:0;padding:0;margin:0;overflow:hidden;border:0;border-right:1px solid #aaa;border-bottom:1px solid #aaa;border-radius:0;background:#fff;color:#4a6fa5;font:700 clamp(18px,5vw,27px) 'Noto Sans KR',sans-serif;cursor:pointer;touch-action:manipulation}
.mutual-cell:nth-child(3n){border-right:2px solid #444}.mutual-cell:nth-child(9n){border-right:0}.mutual-cell:nth-child(n+19):nth-child(-n+27),.mutual-cell:nth-child(n+46):nth-child(-n+54){border-bottom:2px solid #444}.mutual-cell:nth-child(n+73){border-bottom:0}
.mutual-cell:hover{box-shadow:inset 0 0 0 999px rgba(244,241,235,.45)}.mutual-cell.selected{background:#e1e9f3}.mutual-cell.selected:hover{box-shadow:none}.mutual-cell.given{color:#222}.mutual-cell.conflict{background:#fbe0e0}.mutual-cell.conflict:hover{box-shadow:none}.mutual-cell:focus{outline:none}
.mutual-cell :global(.notes){position:absolute;inset:3px;display:grid;grid-template-columns:repeat(3,minmax(0,1fr));grid-template-rows:repeat(3,minmax(0,1fr));font-size:clamp(8px,2.2vw,12px);font-weight:500;line-height:1;color:#555f6b}.mutual-cell :global(.notes span){display:flex;align-items:center;justify-content:center;min-width:0;min-height:0;overflow:hidden}
.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}

.mutual-frame{display:grid;grid-template-columns:7% repeat(9,minmax(0,1fr)) 7%;grid-template-rows:44px repeat(9,minmax(0,1fr)) 44px}
.mutual-clue{display:flex;align-items:center;justify-content:space-evenly;color:#333;font-size:clamp(11px,3vw,17px);line-height:1.3;font-variant-numeric:tabular-nums}
.mutual-clue.vertical{flex-direction:column;justify-content:center;gap:2px}.mutual-clue.error{color:#a43d3d}.mutual-clue.satisfied{color:#34804a}
.mutual-board-tools,.mutual-input,.mutual-game .bottom-buttons{width:86%;margin-inline:auto}.mutual-game .bottom-buttons{margin:12px auto 0!important}
.mutual-cell{font-size:clamp(16px,4.5vw,25px)}
</style>
