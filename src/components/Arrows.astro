---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';
import { arrows261023, directions } from '../lib/arrows.js';
const { puzzleId } = Astro.props;
---
<PuzzleLayout title="261023 화살표" {puzzleId}
  subtitle="바깥 칸의 화살표로 각 숫자만큼 격자의 칸을 가리키세요"
  description="바깥 칸에 8방향 화살표를 넣어 숫자만큼 칸을 가리키는 퍼즐">
  <div slot="rules">
    <p>메인 격자판 바깥에 있는 모든 칸에 화살표를 하나씩 그려 넣으세요.</p>
    <p>화살표는 동서남북과 대각선을 포함한 8방향 중 하나이며, 메인 격자의 칸을 최소 한 개 이상 가리켜야 합니다.</p>
    <p>하나의 화살표는 진행 방향에 있는 모든 칸을 가리킵니다. 칸의 숫자는 그 칸을 가리키는 화살표의 개수입니다.</p>
  </div>
  <div slot="controls">바깥 칸을 선택한 뒤 방향 버튼을 누르세요. 지우기로 선택한 화살표를 지웁니다.</div>
  <section id="arrowsGame" data-puzzle={JSON.stringify(arrows261023)} data-puzzle-id={puzzleId} aria-label="화살표">
    <svg id="arrowsBoard" role="group" aria-label="6행 6열 화살표 격자"></svg>
    <div class="direction-pad" aria-label="화살표 방향">
      {directions.map((d, i) => <button type="button" data-direction={i} aria-label={`${d.label}쪽 화살표`} style={`grid-row:${d.dr + 2};grid-column:${d.dc + 2}`}><svg viewBox="0 0 32 32" aria-hidden="true"><path d="M7 16H25M18 9L25 16L18 23" transform={`rotate(${Math.atan2(d.dr, d.dc) * 180 / Math.PI} 16 16)`} /></svg></button>)}
      <button type="button" id="arrowsErase" class="erase">지우기</button>
    </div>
    <div class="bottom-buttons"><button id="arrowsReset" class="danger" type="button">초기화</button></div>
    <p id="arrowsStatus" role="status" aria-live="polite" class="sr-only"></p>
  </section>
  <PuzzleCompletion slot="completion" id="arrowsComplete" />
</PuzzleLayout>
<script>import '../scripts/arrows.js';</script>
<style>
  p { margin:0; } p+p { margin-top:8px; }
  #arrowsBoard { display:block; width:100%; height:auto; background:white; user-select:none; -webkit-user-select:none; touch-action:manipulation; }
  .direction-pad { display:grid; grid-template-columns:repeat(3,48px); grid-template-rows:repeat(3,44px); gap:5px; justify-content:center; margin:16px auto 0; }
  .direction-pad button { padding:5px; margin:0; border:1px solid #ccc; background:#fff; border-radius:4px; cursor:pointer; color:#334f72; }
  .direction-pad button:disabled { opacity:.25; cursor:default; }
  .direction-pad button[aria-pressed="true"] { background:#e1ebf7; border-color:#8da9c9; }
  .direction-pad svg { width:28px; height:28px; fill:none; stroke:currentColor; stroke-width:2.3; stroke-linecap:round; stroke-linejoin:round; }
  .erase { grid-row:2; grid-column:2; font:inherit; font-size:11px; }
  .sr-only { position:absolute; width:1px; height:1px; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
</style>
