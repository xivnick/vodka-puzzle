---
import PageLayout from '../layouts/PageLayout.astro';
import '../styles/home.css';
const ideas = [
  ['한 줄 배치', '목록 제목, 난이도, 미해결을 한 줄에 배치한다.'],
  ['두 줄 배치', '기존 제목과 미해결을 유지하고, 바로 아래에 난이도를 둔다.'],
  ['펼침 메뉴', '난이도를 누르면 선택 메뉴가 열린다.'],
  ['연결형 버튼', '아래쪽 난이도 버튼을 하나의 묶음으로 연결한다.'],
  ['여러 난이도 선택', '마름모 버튼을 각각 켜고 끈다. 선택을 모두 해제하면 전체를 본다.'],
];
const puzzles = [
  { title: '야지린', difficulty: 1, completed: false },
  { title: '레고 하우스', difficulty: 2, completed: true },
  { title: '별의 고리', difficulty: 3, completed: false },
];
const levels = [1, 2, 3];
---
<PageLayout title="난이도 필터 제안" heading="난이도 필터" subtitle="목록 상단 비교 · 5가지" home>
  <p class="comparison-note">각 예시에서 버튼을 눌러보실 수 있습니다. 문제와 완료 표시는 비교용 예시입니다.</p>
  <div class="filter-comparison">
    {ideas.map(([title, description], index) => <section id={`option-${index + 1}`} class:list={['filter-example', `option-${index + 1}`]} data-example={index + 1} aria-labelledby={`example-title-${index + 1}`}>
      <h2 id={`example-title-${index + 1}`}>{index + 1}. {title}</h2>
      <p class="example-description">{description}</p>
      <div class="list-head">
        <div class="list-title" data-count>문제 (3)</div>
        {[0, 2, 4].includes(index) && <div class="head-actions">
          {index === 2 ? <details class="difficulty-menu">
            <summary class="rank-tab" aria-label="난이도 선택"><span data-menu-label>난이도</span><span class="menu-arrow" aria-hidden="true">⌄</span></summary>
            <div class="menu-options" role="group" aria-label="난이도">
              <button class="rank-tab active" type="button" data-level="all" aria-pressed="true">전체</button>
              {levels.map(level => <button class="rank-tab" type="button" data-level={level} aria-pressed="false" aria-label={`난이도 ${level}`}><span class="filter-diamonds" aria-hidden="true">{levels.slice(0, level).map(() => <i />)}</span></button>)}
            </div>
          </details> : <div class="difficulty-buttons" role="group" aria-label={index === 4 ? '난이도 여러 개 선택' : '난이도'}>
            {index !== 4 && <button class="rank-tab active" type="button" data-level="all" aria-pressed="true">전체</button>}
            {levels.map(level => <button class="rank-tab" type="button" data-level={level} aria-pressed="false" aria-label={`난이도 ${level}`}><span class="filter-diamonds" aria-hidden="true">{levels.slice(0, level).map(() => <i />)}</span></button>)}
          </div>}
          <button class="rank-tab unsolved-toggle" type="button" aria-pressed="false">미해결</button>
        </div>}
        {[1, 3].includes(index) && <button class="rank-tab unsolved-toggle" type="button" aria-pressed="false">미해결</button>}
      </div>
      {[1, 3].includes(index) && <div class="second-row">
        <span class="filter-label">난이도</span>
        <div class="difficulty-buttons" role="group" aria-label="난이도">
          <button class="rank-tab active" type="button" data-level="all" aria-pressed="true">전체</button>
          {levels.map(level => <button class="rank-tab" type="button" data-level={level} aria-pressed="false" aria-label={`난이도 ${level}`}><span class="filter-diamonds" aria-hidden="true">{levels.slice(0, level).map(() => <i />)}</span></button>)}
        </div>
      </div>}
      <div class="list sample-list">
        <div class="daily-card"><span class="title">Daily Sudoku</span></div>
        {puzzles.map(puzzle => <div class="sample-puzzle" data-difficulty={puzzle.difficulty} data-completed={String(puzzle.completed)}>
          <span class="title">{puzzle.title}{puzzle.completed && <span class="check-mark">✓</span>}</span>
          <span class="puzzle-difficulty" role="img" aria-label={`난이도 ${puzzle.difficulty}`}>{levels.slice(0, puzzle.difficulty).map(() => <span class="difficulty-diamond" aria-hidden="true" />)}</span>
        </div>)}
        <p class="sample-empty" role="status" hidden>선택한 조건에 맞는 문제가 없습니다.</p>
      </div>
    </section>)}
  </div>
</PageLayout>
<script>
  document.querySelectorAll<HTMLElement>('[data-example]').forEach(example => {
    const multiple = example.dataset.example === '5';
    const selected = new Set<string>();
    let unsolved = false;
    const buttons = [...example.querySelectorAll<HTMLButtonElement>('[data-level]')];
    const toggle = example.querySelector<HTMLButtonElement>('.unsolved-toggle')!;
    const update = () => {
      buttons.forEach(button => {
        const active = button.dataset.level === 'all' ? selected.size === 0 : selected.has(button.dataset.level!);
        button.classList.toggle('active', active);
        button.setAttribute('aria-pressed', String(active));
      });
      toggle.classList.toggle('active', unsolved);
      toggle.setAttribute('aria-pressed', String(unsolved));
      let count = 0;
      example.querySelectorAll<HTMLElement>('.sample-puzzle').forEach(row => {
        const visible = (!selected.size || selected.has(row.dataset.difficulty!)) && (!unsolved || row.dataset.completed !== 'true');
        row.hidden = !visible;
        if (visible) count++;
      });
      example.querySelector('[data-count]')!.textContent = `문제 (${count})`;
      (example.querySelector('.sample-empty') as HTMLElement).hidden = count !== 0;
    };
    buttons.forEach(button => button.addEventListener('click', () => {
      const level = button.dataset.level!;
      if (level === 'all') selected.clear();
      else if (multiple) {
        if (selected.has(level)) selected.delete(level);
        else selected.add(level);
      } else { selected.clear(); selected.add(level); }
      const label = example.querySelector('[data-menu-label]');
      if (label) {
        label.replaceChildren();
        if (level === 'all') label.textContent = '난이도';
        else label.append(button.querySelector('.filter-diamonds')!.cloneNode(true));
        example.querySelector('summary')!.setAttribute('aria-label', level === 'all' ? '난이도 선택: 전체' : `난이도 선택: 난이도 ${level}`);
        example.querySelector('details')!.open = false;
      }
      update();
    }));
    toggle.addEventListener('click', () => { unsolved = !unsolved; update(); });
  });
</script>
<style is:global>
.comparison-note { width:100%; margin:0 0 32px; color:#999; font-size:.75rem; line-height:1.7; }
.filter-comparison { width:100%; }
.filter-example { margin-bottom:42px; scroll-margin-top:20px; }
.filter-example h2 { margin:0 0 6px; font-size:.88rem; font-weight:700; color:#555; }
.example-description { margin:0 0 18px; font-size:.74rem; color:#999; line-height:1.7; }
.filter-example .list-head, body.home .filter-example .list { width:100%; }
.filter-example .list-head { gap:6px; }
.filter-example .list-title { white-space:nowrap; }
.head-actions { display:flex; align-items:center; gap:8px; }
.difficulty-buttons { display:flex; align-items:center; gap:4px; }
.filter-example .rank-tab { display:inline-flex; align-items:center; justify-content:center; padding:0 8px; line-height:1; }
.filter-example .rank-tab[data-level] { width:44px; padding:0; flex-shrink:0; }
.filter-example .unsolved-toggle { padding:0 10px; flex-shrink:0; }
.filter-diamonds { display:flex; align-items:center; justify-content:center; gap:5px; width:26px; height:14px; flex-shrink:0; }
.filter-diamonds i { width:5px; height:5px; flex-shrink:0; background:currentColor; transform:rotate(45deg); }
.second-row { display:flex; align-items:center; justify-content:flex-end; gap:10px; margin-bottom:8px; }
.filter-label { color:#999; font-size:.74rem; }
.option-4 .second-row { justify-content:space-between; }
.option-4 .difficulty-buttons { gap:0; }
.option-4 .difficulty-buttons .rank-tab { border-radius:0; margin-left:-1px; min-width:48px; }
.option-4 .difficulty-buttons .rank-tab:first-child { border-radius:3px 0 0 3px; margin-left:0; }
.option-4 .difficulty-buttons .rank-tab:last-child { border-radius:0 3px 3px 0; }
.option-4 .difficulty-buttons .active { position:relative; }
.difficulty-menu { position:relative; }
.difficulty-menu summary { display:flex; align-items:center; gap:8px; list-style:none; cursor:pointer; }
.difficulty-menu summary::-webkit-details-marker { display:none; }
.menu-arrow { font-size:.85rem; }
.menu-options { position:absolute; top:calc(100% + 5px); right:0; display:flex; gap:4px; padding:8px; border:1px solid #ddd8cf; border-radius:3px; background:#fff; z-index:2; }
.sample-list > .daily-card, .sample-puzzle { display:flex; align-items:center; justify-content:space-between; gap:10px; padding:14px 18px; border-bottom:1px solid #e8e5df; }
.sample-list > .daily-card { background:#f1f4f0; border-top:1px solid #e8e5df; }
.sample-list .sample-puzzle .title { font-size:.95rem; font-weight:500; display:flex; align-items:center; gap:6px; }
.sample-empty { margin:0; padding:16px 18px; color:#999; font-size:.78rem; border-bottom:1px solid #e8e5df; }
@media(max-width:540px) {
  .sample-list > .daily-card, .sample-puzzle { padding:12px 14px; }
}
@media(max-width:360px) {
  .filter-example .rank-tab { padding:0 6px; }
  .filter-example .unsolved-toggle { padding:0 7px; }
  .head-actions { gap:5px; }
}
</style>
