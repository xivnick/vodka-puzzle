---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';
import { candles261029 } from '../lib/candles.js';
const { puzzleId } = Astro.props;
const puzzle = candles261029;
const title = '261029 초';
const subtitle = '양초를 놓고 주변 숫자에 맞춰 양초의 값의 합을 만드세요';
---
<PuzzleLayout {title} {puzzleId} {subtitle} description="맞닿은 양초에 따라 값이 달라지는 퍼즐, 초">
  <div slot="rules">
    격자의 빈칸에 양초를 놓으세요.
    <ul>
      <li>각 양초의 값은 양초가 놓인 칸의 네 변 중, 다른 양초가 놓인 칸과 맞닿아 있지 않은 변의 개수입니다. 가령, 격자의 가장 왼쪽 위 칸에 양초가 놓인다면 그 값은 항상 2 이상입니다.</li>
      <li>양초의 값은 0이 될 수 없습니다. 즉, 양초가 놓인 칸의 네 변이 모두 다른 양초와 맞닿아 있어서는 안 됩니다.</li>
      <li>격자에 주어진 숫자는 해당 숫자가 적힌 칸과 변 또는 꼭짓점을 공유하는 칸들에 놓인 양초들의 값의 합을 나타냅니다.</li>
    </ul>
  </div>
  <div slot="controls">
    빈칸을 짧게 누르면 양초를 놓고, 길게 누르거나 우클릭하면 × 메모를 넣습니다.<br />
    오른쪽 위 버튼이나 M 키로 두 입력을 바꾸세요.<br />
    같은 표시를 다시 입력하거나 지우기 버튼으로 지우세요.
  </div>
  <section id="candlesGame" data-puzzle-id={puzzleId} data-puzzle={JSON.stringify(puzzle)} aria-label="초">
    <div class="board-tools"><button id="candlesNotes" type="button" aria-pressed="false">길게 눌러 × 표시</button></div>
    <div id="candlesBoard" class="candles-board" role="group" aria-label="8행 8열 초 격자">
      {Array.from({length:64}, (_, i) => {
        const clue = puzzle.clues.find(clue => clue.cell === i);
        return <button type="button" class:list={['candles-cell', {given: !!clue}]} data-cell={i}
          tabindex={i === 0 ? 0 : -1} aria-label={`${Math.floor(i / 8) + 1}행 ${i % 8 + 1}열, ${clue ? `단서 ${clue.count}` : '빈칸'}`}>
          {clue && <span class="clue" aria-hidden="true">{clue.count}</span>}
          <!-- Tabler Icons candle-filled, MIT license: public/licenses/tabler-icons.txt -->
          <svg class="candle" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M14 9a2 2 0 0 1 2 2v10a1 1 0 0 1 -1 1h-6a1 1 0 0 1 -1 -1v-10a2 2 0 0 1 2 -2z" />
            <path d="M11.254 1.334a1 1 0 0 1 1.491 0l1.452 1.623a3 3 0 0 1 -4.196 4.28c-1.195 -1.07 -1.339 -2.889 -.297 -4.166z" />
          </svg>
          <span class="mark" aria-hidden="true"></span>
        </button>;
      })}
    </div>
    <div class="bottom-buttons"><button id="candlesErase" type="button">지우기</button><button id="candlesReset" type="button" class="danger">초기화</button></div>
  </section>
  <PuzzleCompletion slot="completion" id="candlesComplete" />
  <script>import '../scripts/candles.js';</script>
</PuzzleLayout>
<style>
  #candlesGame { width:100%; }
  .board-tools { display:flex; justify-content:flex-end; margin-bottom:8px; }
  .board-tools button { background:none; border:0; border-bottom:1px solid #ccc; border-radius:0; padding:0 0 1px; color:#888; font-size:.82rem; line-height:1.5; }
  .board-tools button[aria-pressed=true] { color:#4a6fa5; border-color:#4a6fa5; }
  .candles-board { display:grid; grid-template-columns:repeat(8,minmax(0,1fr)); width:100%; border:2px solid #333; }
  .candles-cell { position:relative; display:flex; align-items:center; justify-content:center; aspect-ratio:1; padding:0; margin:0; min-width:0; border:0; border-radius:0; border-right:1px solid #aaa; border-bottom:1px solid #aaa; background:#fff; color:#333; font-family:inherit; font-size:clamp(20px,6vw,34px); line-height:1; touch-action:manipulation; user-select:none; -webkit-user-select:none; -webkit-touch-callout:none; -webkit-tap-highlight-color:transparent; }
  .candles-cell:nth-child(8n) { border-right:0; }
  .candles-cell:nth-child(n+57) { border-bottom:0; }
  .given { cursor:default; font-weight:600; }
  .candle { display:none; width:70%; height:70%; color:#444; }
  .shaded .candle { display:block; }
  .mark { color:#999; font-weight:400; }
  .matched { color:#39844a; }
  .over { background:#fbeaea; color:#c34242; }
  .conflict { background:#fbeaea; color:#c34242; }
  .candles-cell:focus { outline:none; }
  ul { padding-left:20px; margin:8px 0 0; }
</style>
