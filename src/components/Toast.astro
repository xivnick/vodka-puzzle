<div id="_toast" class="toast" role="status" aria-live="polite" aria-atomic="true"></div>
<script is:inline>
(() => {
  const element = document.getElementById('_toast');
  let timer,active=false;const pending=[],seen=new Set();
  function display(message){
    clearTimeout(timer);active=true;element.textContent=message;element.classList.add('show');
    timer=setTimeout(()=>{element.classList.remove('show');active=false;if(pending.length)timer=setTimeout(()=>display(pending.shift()),250);},2200);
  }
  window.showToast=display;
  window.showAchievementNotifications=(result,{defer=false}={})=>{
    if(!result)return;
    if(defer){
      const userId=window.puzzleAccount?.user?.id;
      if(userId&&(result.achievement_notifications?.length||result.daily_task_notifications?.length))try{sessionStorage.setItem('puzzle-mission-notice',JSON.stringify({userId,result}));}catch{}
      return;
    }
    if(result.operation_id){if(seen.has(result.operation_id))return;seen.add(result.operation_id);}
    const unique=new Map((result.achievement_notifications??[]).map(row=>[row.id,row]));
    for(const row of unique.values())pending.push(`도전 과제 달성: ${row.name}`);
    for(const row of result.daily_task_notifications??[])pending.push(`일일 과제 달성: ${row.name}`);
    if(!active&&pending.length)display(pending.shift());
  };
  window.puzzleAuthReady.then(()=>{
    try{const raw=sessionStorage.getItem('puzzle-mission-notice');if(!raw)return;sessionStorage.removeItem('puzzle-mission-notice');const notice=JSON.parse(raw);if(notice.userId===window.puzzleAccount.user?.id)window.showAchievementNotifications(notice.result);}catch{}
  });
})();
</script>
<style>
.toast {
  position: fixed;
  bottom: 28px;
  left: 50%;
  transform: translateX(-50%) translateY(12px);
  background: #333;
  color: #fff;
  font-family: 'Noto Sans KR', sans-serif;
  font-size: 0.82rem;
  padding: 9px 18px;
  border-radius: 20px;
  max-width: calc(100vw - 32px);
  box-sizing: border-box;
  width: max-content;
  text-align: center;
  overflow-wrap: anywhere;
  opacity: 0;
  pointer-events: none;
  transition: opacity 0.2s, transform 0.2s;
  z-index: 999;
}
.toast.show {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}
@media (prefers-reduced-motion: reduce) {
  .toast { transition: none; }
}
</style>
