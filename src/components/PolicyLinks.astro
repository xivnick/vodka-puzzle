---
import '../styles/site-text-link.css';
const { showArchive = false, showHomeScreenGuide = false } = Astro.props;
---
<nav class:list={['policy-links', { 'footer-links': showArchive }]} aria-label={showArchive ? '사이트 안내' : '서비스 정책'}>
  {showHomeScreenGuide && <div class="guide-link"><a class="site-text-link" href="/home-screen-guide/">홈 화면에 추가하기</a></div>}
  {showArchive && <a class="site-text-link" href="/archive/">archive</a>}
  <a class="site-text-link" href="/terms/">이용약관</a>
  <a class="site-text-link" href="/privacy/">개인정보처리방침</a>
</nav>
<style>
.policy-links{display:flex;justify-content:center;gap:16px;margin-top:16px}
.footer-links{flex-wrap:wrap;row-gap:8px;margin-top:0}
.guide-link{flex-basis:100%;text-align:center}
</style>
