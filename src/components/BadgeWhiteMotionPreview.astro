---
const {icon='star',effect='clock',id,large=false,active=false,label}=Astro.props;
const files=import.meta.glob('../../public/icons/achievement-preview/*.svg',{query:'?raw',import:'default',eager:true});
const body=String(files[`../../public/icons/achievement-preview/${icon}.svg`]).match(/<svg\b[^>]*>([\s\S]*?)<\/svg>/)?.[1]??'';
---
<span class:list={['material-badge',`white-${effect}`,{large,'active-material':active}]} role={label?'img':undefined} aria-label={label} aria-hidden={label?undefined:'true'}>
  <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <linearGradient id={`${id}-color`} gradientUnits="userSpaceOnUse" x1="0" y1="0" x2="24" y2="24"><stop stop-color="var(--tone-a)"/><stop offset="1" stop-color="var(--tone-b)"/></linearGradient>
      <mask id={`${id}-mask`} maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><g class="material-geometry" stroke="white"><Fragment set:html={body}/></g></mask>
      {effect==='cross'&&<linearGradient id={`${id}-light`}><stop stop-color="white" stop-opacity="0"/><stop offset=".42" stop-color="white" stop-opacity="0"/><stop offset=".5" stop-color="white" stop-opacity=".85"/><stop offset=".58" stop-color="white" stop-opacity="0"/><stop offset="1" stop-color="white" stop-opacity="0"/></linearGradient>}
    </defs>
    <g class="material-geometry" stroke={`url(#${id}-color)`}><Fragment set:html={body}/></g>
    <g mask={`url(#${id}-mask)`} stroke="none" fill="white">
      {effect==='clock'&&<g class="clock-beam">
        <path d="M12 12 L1 -20 L22 -20 Z" opacity=".12"/>
        <path d="M12 12 L7 -20 L19 -20 Z" opacity=".26"/>
        <path d="M12 12 L11 -20 L16 -20 Z" opacity=".92"/>
      </g>}
      {effect==='cross'&&[0,1].map(index=><g transform={`rotate(${index===0?35:-35} 12 12)`}><rect class:list={['cross-beam',{'cross-second':index===1}]} x="-72" y="-40" width="96" height="104" fill={`url(#${id}-light)`}/></g>)}
      {effect==='water'&&<g class="water-light" fill="none" stroke="white" stroke-width="2.1" opacity=".7">{[1,8,15,22].map(y=><path d={`M-24 ${y} q6 -5 12 0 t12 0 t12 0 t12 0 t12 0 t12 0`}/>)}{[4,18].map(y=><path d={`M-24 ${y} q6 5 12 0 t12 0 t12 0 t12 0 t12 0 t12 0`} stroke-width="1" opacity=".5"/>)}</g>}
      {effect==='silver'&&Array.from({length:6},(_,phase)=><g class="silver-grains" style={`animation-delay:${-phase*.53}s;animation-duration:${2.8+phase*.19}s`}>{Array.from({length:12},(_,i)=>{const seed=i+phase*12;return <rect x={(seed*37%229)/10} y={(seed*61%227)/10} width="1.1" height="1.6" rx=".3"/>})}</g>)}
      {effect==='afterglow'&&<rect class="afterglow-light" width="24" height="24"/>}
    </g>
  </svg>
</span>
