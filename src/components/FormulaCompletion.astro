---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';

const { puzzle, title = puzzle.title, puzzleId = puzzle.id, preview = false } = Astro.props;
const keys = [...puzzle.numbers.map(String), '+', '-', '*', '/', '(', ')'];
---
<PuzzleLayout
  title={title}
  puzzleId={puzzleId}
  subtitle="주어진 숫자를 모두 사용해 타겟 숫자를 만드는 수식을 완성하세요"
  description="주어진 네 숫자와 사칙연산, 괄호만 사용해 타겟 숫자를 만드는 수식 퍼즐"
  showCloud={!preview}
  showLeaderboard={!preview}
>
  <div slot="rules" class="formula-rules">
    <p>주어진 4개의 숫자를 한 번씩, 모두 사용하여 타겟 숫자를 만드는 수식을 완성하세요. 사용할 수 있는 연산 기호는 사칙연산(덧셈, 뺄셈, 곱셈, 나눗셈)과 괄호입니다.</p>
    <ul>
      <li>주어진 숫자 외의 다른 숫자는 일체 사용할 수 없습니다.</li>
      <li>숫자의 순서는 자유롭게 바꿀 수 있습니다.</li>
      <li>숫자 이어붙이기, 숫자 돌리기 같은 트릭은 사용하지 않습니다.</li>
      <li>연산 기호는 원하는 것만 자유롭게 사용할 수 있습니다.</li>
      <li>연산 기호는 부호로 사용할 수 없습니다.</li>
    </ul>
  </div>
  <div slot="controls">
    화면의 숫자와 연산 기호를 차례로 누르세요.<br />
    키보드의 숫자, +, -, *, /, (, )도 사용할 수 있으며 여러 자리 숫자는 각 자리 키를 이어서 누르세요.<br />
    Backspace 또는 Delete로 마지막 입력을 지울 수 있습니다.
  </div>
  <section
    id="formulaGame"
    class="formula-game"
    data-puzzle={JSON.stringify(puzzle)}
    data-puzzle-id={puzzleId}
    data-preview={String(preview)}
    aria-label={title}
    tabindex="0"
  >
    <div class="formula-card">
      <div class="problem-line">
        <div class="problem-value"><span>Numbers</span><strong>{puzzle.numbers.join(', ')}</strong></div>
        <div class="problem-value"><span>Target</span><strong>{puzzle.target}</strong></div>
      </div>
      <div class="formula-row">
        <div id="formulaExpression" class="expression-box" aria-label="입력한 수식">
          <span class="expression-placeholder">수식을 완성하세요</span>
        </div>
        <div id="formulaResult" class="formula-result" aria-label="계산 결과"></div>
      </div>
      <div id="formulaKeypad" class="formula-keypad" aria-label="수식 입력">
        {keys.map(key => (
          <button
            type="button"
            data-token={key}
            data-number={puzzle.numbers.map(String).includes(key) ? key : undefined}
            data-operator={'+-*/'.includes(key) ? key : undefined}
          >{key === '*' ? '×' : key === '/' ? '÷' : key}</button>
        ))}
        <button type="button" class="wide" data-action="backspace">지우기</button>
      </div>
    </div>
    <div class="bottom-buttons">
      <button id="formulaReset" class="danger" type="button">초기화</button>
    </div>
    <PuzzleCompletion id="formulaComplete" />
    <span id="formulaStatus" class="sr-only" role="status" aria-live="polite"></span>
  </section>
</PuzzleLayout>
<script>import '../scripts/formula-completion.js';</script>
<style>
.formula-rules{line-height:1.7}.formula-rules p{margin:0}.formula-rules ul{margin:8px 0 0;padding-left:1.25rem}.formula-rules li+li{margin-top:2px}
.formula-game{width:100%;max-width:480px;margin-inline:auto;outline:none}.formula-game:focus-visible{outline:2px solid #4a6fa5;outline-offset:4px;border-radius:6px}
.formula-card{width:100%;border:1px solid #e0ddd6;border-radius:6px;background:#fff;padding:18px}
.problem-line{display:flex;align-items:center;justify-content:space-between;gap:12px;margin-bottom:18px}.problem-value{display:flex;align-items:baseline;gap:7px;min-width:0;white-space:nowrap;color:#222}.problem-value span{font-size:.76rem;color:#999}.problem-value strong{font-size:1.35rem;line-height:1}
.formula-row{display:grid;grid-template-columns:minmax(0,1fr) auto;align-items:center;gap:10px}.expression-box{display:flex;align-items:center;flex-wrap:wrap;gap:6px;width:100%;min-width:0;min-height:52px;border:1.5px solid #c8c3b8;border-radius:4px;padding:7px 10px;background:#fff;color:#222;font:1.05rem ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.expression-box.solved{border-color:#6b9b5f;background:#fbfff8}.expression-box :global(.expression-placeholder){color:#aaa;font:.9rem 'Noto Sans KR',sans-serif}.expression-box :global(.expression-token){display:inline-flex;align-items:center;justify-content:center;min-width:30px;height:32px;padding:0 9px;border-radius:4px;background:#f4f1eb;color:#555;font-weight:700;line-height:1}.expression-box :global(.expression-token.number){border:1px solid #d9d4ca;background:#faf8f4;color:#222}
.formula-result{min-width:76px;color:#333;text-align:left;white-space:nowrap;font:700 1.15rem ui-monospace,SFMono-Regular,Menlo,Consolas,monospace}.formula-keypad{display:grid;grid-template-columns:repeat(6,1fr);gap:6px;margin-top:14px}.formula-keypad button{height:40px;border:1.5px solid #c8c3b8;border-radius:4px;background:#f4f1eb;color:#333;font:700 .92rem 'Noto Sans KR',sans-serif;cursor:pointer;touch-action:manipulation}.formula-keypad button:hover{background:#e8e4da}.formula-keypad button.used{border-color:#7fa972;background:#f0f7ed;color:#4f7d45}.formula-keypad button:disabled{cursor:not-allowed;opacity:.58}.formula-keypad .wide{grid-column:span 2}.formula-game .bottom-buttons{margin-top:12px!important}.formula-game .bottom-buttons button{min-width:96px}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
@media(max-width:540px){.formula-card{padding:14px}.problem-line{gap:8px}.formula-row{grid-template-columns:1fr;gap:6px}.formula-result{min-height:1.4em;padding-left:2px}.formula-keypad{grid-template-columns:repeat(4,1fr)}.formula-keypad button{height:38px}}
</style>
