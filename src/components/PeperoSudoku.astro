---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';
import NumberPad from './NumberPad.astro';
import '../styles/daily-sudoku.css';
import { givens, sticks } from '../lib/pepero-sudoku.js';
const puzzleId = '261111_01';
const cellKinds = Array(81).fill('');
for (const [handle, ...chocolate] of sticks) {
  cellKinds[handle] = '과자 칸';
  chocolate.forEach(i => { cellKinds[i] = '초코 칸'; });
}
const point = i => [i % 9 + .5, Math.floor(i / 9) + .5];
const shapes = sticks.map(cells => {
  const a = point(cells[0]), b = point(cells[2]);
  const dx = (b[0] - a[0]) / 2, dy = (b[1] - a[1]) / 2;
  return { x1:a[0] - .32*dx, y1:a[1] - .32*dy,
    x2:b[0] + .32*dx, y2:b[1] + .32*dy,
    chocolateX:a[0] + .5*dx, chocolateY:a[1] + .5*dy };
});
---
<PuzzleLayout title="261111 빼빼로 스도쿠" {puzzleId}
  subtitle="초코 칸의 합에서 과자 칸의 숫자를 빼면 11!"
  description="초코 두 칸의 합에서 과자 한 칸의 숫자를 빼면 11이 되는 빼빼로 스도쿠">
  <div slot="rules">
    각 가로줄, 세로줄, 굵은 선으로 구분된 3×3 영역에 1~9를 한 번씩 넣으세요.<br />
    각 빼빼로에서 회색으로 채워진 초코 두 칸의 숫자 합에서 흰 과자 한 칸의 숫자를 빼면 11이 됩니다.
  </div>
  <div slot="controls">
    칸을 선택하고 숫자 버튼으로 입력하세요.<br />
    메모하기 버튼이나 M 키로 메모 입력을 켜고 끄세요.<br />
    다른 칸을 눌러 이동하고 지우기 버튼으로 입력을 지우세요.
  </div>
  <section id="peperoGame" data-puzzle-id={puzzleId} data-preview="false" aria-label="빼빼로 스도쿠">
    <div class="sudoku-board-tools"><button id="peperoNotes" class="sudoku-notes-toggle" type="button" tabindex="-1" aria-pressed="false">메모하기</button></div>
    <div class="pepero-grid">
      <div id="peperoBoard" class="sudoku-board" role="group" aria-label="9행 9열 스도쿠">
        {givens.flat().map((n, i) => <button type="button"
          class:list={['sudoku-cell', { given: !!n }]}
          data-cell={i} tabindex={i === 0 ? 0 : -1}
          aria-label={`${Math.floor(i/9)+1}행 ${i%9+1}열, ${n || '빈칸'}${cellKinds[i] ? ', ' + cellKinds[i] : ''}${n ? ', 고정 숫자' : ''}`}><span class="cell-value">{n || ''}</span></button>)}
      </div>
      <svg class="pepero-sticks" viewBox="0 0 9 9" aria-hidden="true">
        {shapes.map(s => <g>
          <line class="stick-outline" x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} />
          <line class="biscuit" x1={s.x1} y1={s.y1} x2={s.x2} y2={s.y2} />
          <line class="chocolate" x1={s.chocolateX} y1={s.chocolateY} x2={s.x2} y2={s.y2} />
        </g>)}
      </svg>
    </div>
    <p class="pepero-legend"><span class="swatch chocolate"></span> 초코 ＋ 초코 − <span class="swatch biscuit"></span> 과자 ＝ 11</p>
    <NumberPad id="peperoNumbers" max={9} />
    <div class="bottom-buttons">
      <button id="peperoErase" type="button">지우기</button>
      <button id="peperoReset" type="button" class="danger">초기화</button>
    </div>
  </section>
  <PuzzleCompletion slot="completion" id="peperoComplete" />
</PuzzleLayout>
<script>import '../scripts/pepero-sudoku.js';</script>
<style>
  #peperoGame { width:100%; }
  .pepero-grid { position:relative; }
  .pepero-sticks { position:absolute; inset:2px; width:calc(100% - 4px); height:calc(100% - 4px); pointer-events:none; z-index:1; }
  .pepero-sticks line { stroke-width:.30; stroke-linecap:round; }
  .pepero-sticks .stick-outline { stroke:#555; stroke-width:.36; }
  .pepero-sticks .biscuit { stroke:#fff; }
  .pepero-sticks .chocolate { stroke:#c8c8c8; }
  #peperoBoard :global(.cell-value) { position:relative; z-index:2; }
  #peperoBoard :global(.notes) { z-index:2; }
  #peperoBoard .sudoku-cell { -webkit-tap-highlight-color:transparent; }
  #peperoGame :global(:focus) { outline:none; box-shadow:none; }
  .pepero-legend { display:flex; align-items:center; justify-content:center; gap:.25em; margin:14px 0 0; color:#777; font-size:.82rem; }
  .swatch { display:inline-block; width:.38em; height:1.1em; border:1px solid #555; box-sizing:border-box; border-radius:2px; margin-left:.15em; }
  .swatch.chocolate { background:#c8c8c8; }
  .swatch.biscuit { background:#fff; }
</style>
