---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';

const { puzzle, title = puzzle.title, puzzleId = puzzle.id, preview = false } = Astro.props;
const size = puzzle.givens.length;
const cells = Array.from({ length: size ** 2 }, (_, index) => ({
  row: Math.floor(index / size),
  column: index % size,
  given: puzzle.givens.flat()[index],
}));
---
<PuzzleLayout
  title={title}
  puzzleId={puzzleId}
  subtitle={`${size}×${size} · 바깥 단서만큼 보이도록 건물 높이를 채우세요`}
  description={`${size}×${size} 라틴방진에 각 방향의 스카이스크레이퍼 단서를 만족하도록 숫자를 채우는 퍼즐`}
  showCloud={!preview}
  showLeaderboard={!preview}
>
  <div slot="rules" class="sky-rules">
    <p>각 가로줄과 세로줄에 1~{size}이 정확히 한 번씩 나타나도록 숫자를 채우세요.</p>
    <p>격자 안의 숫자는 그만큼의 높이를 가지는 건물입니다. 격자 바깥의 숫자는 그 방향에서 봤을 때 보이는 그 줄 건물의 수입니다. 작은 건물은 큰 건물에 가려집니다.</p>
  </div>
  <div slot="controls">
    칸을 누른 뒤 숫자 버튼이나 키보드의 1~{size}을 입력하세요.<br />
    방향키로 칸을 옮기고, Backspace 또는 Delete로 지울 수 있습니다.
  </div>
  <section
    id="skyGame"
    class="sky-game"
    data-puzzle={JSON.stringify(puzzle)}
    data-puzzle-id={puzzleId}
    data-preview={String(preview)}
    style={`--sky-size:${size}`}
    aria-label={title}
  >
    <div id="skyBoard" class="sky-board" role="grid" aria-label={`${size}행 ${size}열 스카이스크레이퍼 퍼즐`}>
      <span class="sky-corner" aria-hidden="true"></span>
      {puzzle.clues.top.map((clue, index) => <span class="sky-clue" data-clue={`top-${index}`} aria-label={clue == null ? undefined : `위쪽 ${index + 1}열 단서 ${clue}`}>{clue}</span>)}
      <span class="sky-corner" aria-hidden="true"></span>
      {Array.from({ length: size }, (_, row) => (
        <>
          <span class="sky-clue" data-clue={`left-${row}`} aria-label={puzzle.clues.left[row] == null ? undefined : `왼쪽 ${row + 1}행 단서 ${puzzle.clues.left[row]}`}>{puzzle.clues.left[row]}</span>
          {cells.filter(cell => cell.row === row).map(({ column, given }) => (
            <button
              class:list={['sky-cell', { given: Boolean(given) }]}
              type="button"
              role="gridcell"
              data-row={row}
              data-column={column}
              data-given={given || undefined}
              tabindex={row === 0 && column === 0 ? '0' : '-1'}
              aria-label={`${row + 1}행 ${column + 1}열${given ? `, 주어진 숫자 ${given}` : ', 빈칸'}`}
            >{given || ''}</button>
          ))}
          <span class="sky-clue" data-clue={`right-${row}`} aria-label={puzzle.clues.right[row] == null ? undefined : `오른쪽 ${row + 1}행 단서 ${puzzle.clues.right[row]}`}>{puzzle.clues.right[row]}</span>
        </>
      ))}
      <span class="sky-corner" aria-hidden="true"></span>
      {puzzle.clues.bottom.map((clue, index) => <span class="sky-clue" data-clue={`bottom-${index}`} aria-label={clue == null ? undefined : `아래쪽 ${index + 1}열 단서 ${clue}`}>{clue}</span>)}
      <span class="sky-corner" aria-hidden="true"></span>
    </div>
    <div class="sky-numpad" aria-label="숫자 입력">
      {Array.from({ length: size }, (_, index) => <button type="button" data-number={index + 1}>{index + 1}</button>)}
    </div>
    <div class="bottom-buttons">
      <button id="skyErase" type="button">지우기</button>
      <button id="skyReset" class="danger" type="button">초기화</button>
    </div>
    <PuzzleCompletion id="skyComplete" />
    <span id="skyStatus" class="sr-only" role="status" aria-live="polite"></span>
  </section>
</PuzzleLayout>
<script>import '../scripts/skyscraper.js';</script>
<style>
.sky-rules{line-height:1.7}.sky-rules p{margin:0}.sky-rules p+p{margin-top:8px}
.sky-game{--sky-cell:min(58px,12.2vw);--sky-clue:min(34px,7.2vw);width:calc(var(--sky-size) * var(--sky-cell) + 2 * var(--sky-clue));max-width:100%}
.sky-board{display:grid;grid-template-columns:var(--sky-clue) repeat(var(--sky-size),var(--sky-cell)) var(--sky-clue);grid-template-rows:var(--sky-clue) repeat(var(--sky-size),var(--sky-cell)) var(--sky-clue);width:max-content;max-width:100%}
.sky-clue{display:flex;align-items:center;justify-content:center;font-weight:700;color:#333;font-size:1rem}.sky-clue.error{color:#b05050}.sky-corner{display:block}
.sky-cell{appearance:none;display:flex;align-items:center;justify-content:center;min-width:0;padding:0;margin:0;border:0;border-top:1px solid #aaa;border-left:1px solid #aaa;border-radius:0;background:#fff;color:#4a6fa5;font:700 1.15rem 'Noto Sans KR',sans-serif;cursor:pointer;touch-action:manipulation}
.sky-cell:nth-of-type(6n){border-right:2px solid #333}.sky-cell:nth-of-type(-n+6){border-top:2px solid #333}.sky-cell:nth-last-of-type(-n+6){border-bottom:2px solid #333}.sky-cell:nth-of-type(6n+1){border-left:2px solid #333}
.sky-cell:hover{background:#f4f1eb}.sky-cell.selected{background:#e8edf5}.sky-cell.given{color:#222}.sky-cell.conflict{background:#f5d0d0;color:#b05050}.sky-cell:focus{outline:none}.sky-cell:focus-visible{outline:2px solid #4a6fa5;outline-offset:-4px}
.sky-numpad,.bottom-buttons{display:flex;gap:6px;width:calc(var(--sky-size) * var(--sky-cell));margin-left:var(--sky-clue)}.sky-numpad{margin-top:12px}.bottom-buttons{margin-top:8px!important}
.sky-numpad button,.bottom-buttons button{flex:1;height:44px;padding:0;font-family:inherit;font-size:1rem;font-weight:600;background:#f4f1eb;border:1px solid #c8c3b8;border-radius:3px;color:#333;cursor:pointer}.sky-numpad button:hover,.bottom-buttons button:hover{background:#ebe8e1}.bottom-buttons button.danger{background:#fdf5f5;border-color:#e0bfbf;color:#b05050}.bottom-buttons button.danger:hover{background:#f8e8e8}
.sky-game :global(.message){text-align:center;margin-left:var(--sky-clue);width:calc(var(--sky-size) * var(--sky-cell))}.sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap;border:0}
@media(max-width:420px){.sky-game{--sky-cell:min(58px,11.7vw);--sky-clue:min(34px,6.8vw)}.sky-clue{font-size:.9rem}}
</style>
