---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';
import { size, regions } from '../lib/star-battle.js';
const { puzzleId } = Astro.props;
const boundaries = [];
for (let r = 0; r < size; r++) for (let c = 0; c < size; c++) {
  if (r < size - 1 && regions[r][c] !== regions[r + 1][c]) boundaries.push([c, r + 1, c + 1, r + 1]);
  if (c < size - 1 && regions[r][c] !== regions[r][c + 1]) boundaries.push([c + 1, r, c + 1, r + 1]);
}
---
<PuzzleLayout title="261010 스타배틀 1" {puzzleId}
  subtitle="규칙에 따라 일부 칸에 별을 채우세요"
  description="각 가로줄·세로줄·영역에 서로 닿지 않는 별을 2개씩 채우는 스타배틀">
  <div slot="rules">
    규칙에 따라 일부 칸에 별을 채우세요.<br />
    각 가로줄/세로줄/영역에 별이 2개씩 있습니다.<br />
    별끼리는 변으로도, 대각선으로도 닿지 않습니다.
  </div>
  <div slot="controls">
    칸을 짧게 누르면 별, 길게 누르거나 우클릭하면 × 메모를 넣습니다.<br />
    오른쪽 위 버튼이나 M 키로 두 입력을 바꾸세요.<br />
    같은 표시를 다시 입력하거나 지우기 버튼으로 지우세요.
  </div>
  <section id="starBattleGame" data-puzzle-id={puzzleId} aria-label="스타배틀">
    <div class="board-tools"><button id="starBattleNotes" type="button" aria-pressed="false">길게 눌러 x 표시</button></div>
    <div class="board-wrap">
      <div id="starBattleBoard" class="star-board" role="group" aria-label="10행 10열, 각 줄과 영역에 별 2개">
        {regions.flat().map((region, i) => <button type="button" class="star-cell" data-cell={i}
          tabindex={i === 0 ? 0 : -1} aria-label={`${Math.floor(i / size) + 1}행 ${i % size + 1}열, 영역 ${region + 1}, 빈칸`} />)}
      </div>
      <svg class="region-lines" viewBox="0 0 10 10" aria-hidden="true">
        {boundaries.map(([x1,y1,x2,y2]) => <line {x1} {y1} {x2} {y2} />)}
        <rect x="0" y="0" width="10" height="10" />
      </svg>
    </div>
    <div class="bottom-buttons">
      <button id="starBattleErase" type="button">지우기</button>
      <button id="starBattleReset" type="button" class="danger">초기화</button>
    </div>
  </section>
  <PuzzleCompletion slot="completion" id="starBattleComplete" />
<script>import '../scripts/star-battle.js';</script>
</PuzzleLayout>
<style>
  #starBattleGame { width:100%; }
  .board-tools { display:flex; justify-content:flex-end; margin-bottom:8px; }
  .board-tools button { background:none; border:0; border-bottom:1px solid #ccc; border-radius:0; padding:0 0 1px; color:#888; font-size:.82rem; line-height:1.5; }
  .board-tools button[aria-pressed=true] { color:#4a6fa5; border-color:#4a6fa5; }
  .board-wrap { width:100%; position:relative; }
  .star-board { display:grid; grid-template-columns:repeat(10,minmax(0,1fr)); width:100%; }
  .star-cell { aspect-ratio:1; padding:0; margin:0; min-width:0; border:0; border-radius:0; border-right:1px solid #aaa; border-bottom:1px solid #aaa; background:#fff; color:#333; font-family:inherit; font-size:clamp(18px,5.5vw,30px); line-height:1; touch-action:manipulation; user-select:none; -webkit-user-select:none; -webkit-touch-callout:none; -webkit-tap-highlight-color:transparent; }
  .star-cell:nth-child(10n) { border-right:0; }
  .star-cell:nth-child(n+91) { border-bottom:0; }
  .star-cell.selected { background:#e1e9f3; }
  .star-cell.note { color:#999; font-size:clamp(16px,4.5vw,24px); }
  .star-cell.conflict { color:#c34242; background:#fbeaea; }
  .star-cell:focus { outline:none; }
  .region-lines { position:absolute; inset:0; width:100%; height:100%; pointer-events:none; overflow:visible; }
  .region-lines line, .region-lines rect { fill:none; stroke:#222; stroke-width:3; vector-effect:non-scaling-stroke; stroke-linecap:square; stroke-linejoin:miter; }
</style>
