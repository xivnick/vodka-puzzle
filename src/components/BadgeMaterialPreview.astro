---
const { icon='star', effect='ribbon', id, large=false, active=false, label } = Astro.props;
const files=import.meta.glob('../../public/icons/achievement-preview/*.svg',{query:'?raw',import:'default',eager:true});
const raw=String(files[`../../public/icons/achievement-preview/${icon}.svg`]);
const body=raw.match(/<svg\b[^>]*>([\s\S]*?)<\/svg>/)?.[1]?.replace(/<(path|circle|rect|ellipse|line|polyline|polygon)\b/g,'<$1 pathLength="100"') ?? '';

---
<span class:list={['material-badge',`material-${effect}`,{large,'active-material':active}]} data-material-icon={active?icon:undefined} role={label?'img':undefined} aria-label={label} aria-hidden={label?undefined:'true'}>
  <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <linearGradient id={`${id}-color`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--tone-a)"/><stop offset="1" stop-color="var(--tone-b)"/></linearGradient>
      <mask id={`${id}-mask`} maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><g class="material-geometry" stroke="white"><Fragment set:html={body}/></g></mask>
      <linearGradient id={`${id}-ribbon`} gradientTransform="matrix(1 0 -.25 1 .125 0)"><stop offset="0" stop-color="white" stop-opacity="0"/><stop offset=".43" stop-color="white" stop-opacity="0"/><stop offset=".5" stop-color="white" stop-opacity=".95"/><stop offset=".57" stop-color="white" stop-opacity="0"/><stop offset="1" stop-color="white" stop-opacity="0"/></linearGradient>
      {effect==='lenticular'&&<linearGradient id={`${id}-lens`}><stop stop-color="white" stop-opacity="0"/><stop offset=".5" stop-color="white" stop-opacity=".85"/><stop offset="1" stop-color="white" stop-opacity="0"/></linearGradient>}
      {effect==='interference'&&<radialGradient id={`${id}-interference`} cx=".3" cy=".35" r=".9">{Array.from({length:9},(_,i)=><stop class="interference-stop" offset={i/8} stop-color="white" stop-opacity="0" style={`--phase:${-i*.26}s`}/>)}</radialGradient>}
    </defs>
    <g class="material-geometry" stroke={`url(#${id}-color)`}><Fragment set:html={body}/></g>
    {effect==='ribbon'&&<g mask={`url(#${id}-mask)`}><rect class="ribbon-light" x="-72" y="0" width="96" height="24" fill={`url(#${id}-ribbon)`} stroke="none"/></g>}
    {effect==='foil'&&<g mask={`url(#${id}-mask)`} stroke="none">{Array.from({length:18},(_,i)=>{const x=(Math.floor(i/2)%3)*8,y=Math.floor(i/6)*8;return <path class="foil-face" d={i%2?`M${x} ${y} L${x+8} ${y} L${x+8} ${y+8}Z`:`M${x} ${y} L${x} ${y+8} L${x+8} ${y+8}Z`} fill="white" style={`animation-delay:${-(i*7%18)*3.2/18}s`}/>})}</g>}
    {effect==='lenticular'&&<g mask={`url(#${id}-mask)`} stroke="none">{Array.from({length:12},(_,i)=><rect class="lenticular-slice" x={i*2} y="0" width="2" height="24" fill={`url(#${id}-lens)`} style={`animation-delay:${-i*.12}s`}/>)}</g>}
    {effect==='interference'&&<g mask={`url(#${id}-mask)`}><rect width="24" height="24" stroke="none" fill={`url(#${id}-interference)`}/></g>}
  </svg>
</span>
