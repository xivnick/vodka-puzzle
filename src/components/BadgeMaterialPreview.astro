---
const { icon='star', effect='current', id, large=false, active=false, label } = Astro.props;
const files=import.meta.glob('../../public/icons/achievement-preview/*.svg',{query:'?raw',import:'default',eager:true});
const raw=String(files[`../../public/icons/achievement-preview/${icon}.svg`]);
const body=raw.match(/<svg\b[^>]*>([\s\S]*?)<\/svg>/)?.[1]?.replace(/<(path|circle|rect|ellipse|line|polyline|polygon)\b/g,'<$1 pathLength="100"') ?? '';
const isCurrent=effect.startsWith('current');
const cells=effect==='digital'?Array.from({length:144},(_,i)=>({x:(i%12)*2,y:Math.floor(i/12)*2,delay:-((i*37)%113)/23, duration:1.8+((i*19)%47)/20})):[];
---
<span class:list={['material-badge',`material-${effect}`,{large,'active-material':active}]} data-material-icon={active?icon:undefined} role={label?'img':undefined} aria-label={label} aria-hidden={label?undefined:'true'}>
  <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <linearGradient id={`${id}-color`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--tone-a)"/><stop offset="1" stop-color="var(--tone-b)"/></linearGradient>
      <mask id={`${id}-mask`} maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><g class="material-geometry" stroke="white"><Fragment set:html={body}/></g></mask>
      <linearGradient id={`${id}-ribbon`}><stop offset="0" stop-color="white" stop-opacity="0"/><stop offset=".43" stop-color="white" stop-opacity="0"/><stop offset=".5" stop-color="white" stop-opacity=".95"/><stop offset=".57" stop-color="white" stop-opacity="0"/><stop offset="1" stop-color="white" stop-opacity="0"/></linearGradient>
      {effect==='marble'&&<filter id={`${id}-marble`} x="-50%" y="-50%" width="200%" height="200%"><feTurbulence type="fractalNoise" baseFrequency=".06" numOctaves="2" seed="7" result="noise"><animate attributeName="baseFrequency" values=".035;.095;.035" dur="6s" repeatCount="indefinite"/></feTurbulence><feDisplacementMap in="SourceGraphic" in2="noise" scale="16" xChannelSelector="R" yChannelSelector="G"/></filter>}
    </defs>
    <g class="material-geometry" stroke={effect==='current-charge'?'var(--tone-a)':`url(#${id}-color)`}><Fragment set:html={body}/></g>
    {isCurrent&&<g mask={`url(#${id}-mask)`} stroke-width="4">
      {effect==='current'&&<>
        {[0,1,2,3,4,5,6].map(segment=><g class="material-geometry current-trail" stroke="white" stroke-dasharray="5 95" style={`--trail-start:${-segment*3}px;opacity:${.06+segment*.08}`}><Fragment set:html={body}/></g>)}
        <g class="material-geometry current-head" stroke="white" stroke-dasharray="3 97" style="--trail-start:-22px"><Fragment set:html={body}/></g>
      </>}
      {effect==='current-single'&&<g class="material-geometry current-head single-head" stroke="color-mix(in srgb, var(--tone-b) 40%, white)" stroke-dasharray="12 88"><Fragment set:html={body}/></g>}
      {effect==='current-twin'&&<>
        <g class="material-geometry current-head twin-forward" stroke="white" stroke-dasharray="6 94"><Fragment set:html={body}/></g>
        <g class="material-geometry current-head twin-reverse" stroke="color-mix(in srgb, var(--tone-a) 35%, white)" stroke-dasharray="6 94"><Fragment set:html={body}/></g>
      </>}
      {effect==='current-charge'&&<g class="material-geometry charge-line" stroke-linecap="butt" stroke="var(--tone-b)" stroke-dasharray="0 100"><Fragment set:html={body}/></g>}
    </g>}
    {effect==='ribbon'&&<g mask={`url(#${id}-mask)`}><rect class="ribbon-light" x="-72" y="0" width="96" height="24" fill={`url(#${id}-ribbon)`} stroke="none"/></g>}
    {effect==='marble'&&<g mask={`url(#${id}-mask)`}><g filter={`url(#${id}-marble)`} stroke="none"><rect x="-12" y="-12" width="48" height="48" fill="var(--tone-a)"/><path d="M-10 4 Q8 -3 30 13 M-7 18 Q12 7 35 29" fill="none" stroke="var(--tone-b)" stroke-width="7"/></g></g>}
    {effect==='crackle'&&<g mask={`url(#${id}-mask)`} stroke="white" stroke-width="1.5"><path class="crackle-line" d="M1 4 L8 8 L6 13 L15 15 L18 22 M8 8 L17 5 L23 9"/><path class="crackle-line crackle-second" d="M3 22 L7 16 L16 11 L14 3 M16 11 L23 16"/></g>}
    {effect==='digital'&&<g mask={`url(#${id}-mask)`}>{cells.map((cell,i)=><rect class="digital-cell" x={cell.x} y={cell.y} width="2" height="2" fill={i%3===0?'var(--tone-a)':i%3===1?'var(--tone-b)':'color-mix(in srgb, var(--tone-b) 65%, white)'} style={`animation-delay:${cell.delay}s;animation-duration:${cell.duration}s`}/>)}</g>}
  </svg>
</span>
