---
const { icon='star', effect='current-single', id, large=false, active=false, label } = Astro.props;
const files=import.meta.glob('../../public/icons/achievement-preview/*.svg',{query:'?raw',import:'default',eager:true});
const raw=String(files[`../../public/icons/achievement-preview/${icon}.svg`]);
const body=raw.match(/<svg\b[^>]*>([\s\S]*?)<\/svg>/)?.[1]?.replace(/<(path|circle|rect|ellipse|line|polyline|polygon)\b/g,'<$1 pathLength="100"') ?? '';
const cellGroups=effect==='digital'?Array.from({length:12},(_,phase)=>({
  delay:-((phase*37)%113)/23,
  duration:1.8+((phase*19)%47)/20,
  cells:Array.from({length:144},(_,i)=>({i,x:(i%12)*2,y:Math.floor(i/12)*2})).filter(cell=>(cell.i*7+Math.floor(cell.i/12)*5)%12===phase),
})):[];

---
<span class:list={['material-badge',`material-${effect}`,{large,'active-material':active}]} data-material-icon={active?icon:undefined} role={label?'img':undefined} aria-label={label} aria-hidden={label?undefined:'true'}>
  <svg viewBox="0 0 24 24" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
    <defs>
      <linearGradient id={`${id}-color`} x1="0" y1="0" x2="1" y2="1"><stop stop-color="var(--tone-a)"/><stop offset="1" stop-color="var(--tone-b)"/></linearGradient>
      <mask id={`${id}-mask`} maskUnits="userSpaceOnUse" x="0" y="0" width="24" height="24"><g class="material-geometry" stroke="white"><Fragment set:html={body}/></g></mask>
      <linearGradient id={`${id}-ribbon`}><stop offset="0" stop-color="white" stop-opacity="0"/><stop offset=".43" stop-color="white" stop-opacity="0"/><stop offset=".5" stop-color="white" stop-opacity=".95"/><stop offset=".57" stop-color="white" stop-opacity="0"/><stop offset="1" stop-color="white" stop-opacity="0"/></linearGradient>
      {effect==='interference'&&<radialGradient id={`${id}-interference`} cx=".3" cy=".35" r=".9">{Array.from({length:9},(_,i)=><stop class="interference-stop" offset={i/8} stop-color="white" stop-opacity="0" style={`--phase:${-i*.26}s`}/>)}</radialGradient>}
    </defs>
    <g class="material-geometry" stroke={`url(#${id}-color)`}><Fragment set:html={body}/></g>
    {effect==='current-single'&&<g mask={`url(#${id}-mask)`} stroke-width="4"><g class="material-geometry current-head single-head" stroke="#fff" stroke-dasharray="12 88"><Fragment set:html={body}/></g></g>}
    {effect==='ribbon'&&<g mask={`url(#${id}-mask)`}><rect class="ribbon-light" x="-72" y="0" width="96" height="24" fill={`url(#${id}-ribbon)`} stroke="none"/></g>}
    {effect==='digital'&&<g mask={`url(#${id}-mask)`}>{cellGroups.map(group=><g class="digital-cell-group" style={`animation-delay:${group.delay}s;animation-duration:${group.duration}s`}>{group.cells.map(cell=><rect class="digital-cell" x={cell.x} y={cell.y} width="2" height="2" fill="white" opacity={.65+(cell.i*11%7)/20}/>)}</g>)}</g>}
    {effect==='foil'&&<g mask={`url(#${id}-mask)`} stroke="none">{Array.from({length:32},(_,i)=>{const x=(Math.floor(i/2)%4)*6,y=Math.floor(i/8)*6;return <path class="foil-face" d={i%2?`M${x} ${y} L${x+6} ${y} L${x+6} ${y+6}Z`:`M${x} ${y} L${x} ${y+6} L${x+6} ${y+6}Z`} fill="white" style={`animation-delay:${-(i*13%41)/10}s;animation-duration:${2+(i*7%19)/10}s`}/>})}</g>}
    {effect==='lenticular'&&<g mask={`url(#${id}-mask)`} stroke="none">{Array.from({length:12},(_,i)=><rect class="lenticular-slice" x={i*2} y="0" width="1.7" height="24" fill="white" style={`animation-delay:${-i*.13}s`}/>)}</g>}
    {effect==='weave'&&<g mask={`url(#${id}-mask)`} fill="none" stroke-width=".9"><g class="weave-thread" stroke="white">{Array.from({length:16},(_,i)=><path d={`M${i*3-24} 0 l24 24`}/>)}</g><g class="weave-thread weave-cross" stroke="white">{Array.from({length:16},(_,i)=><path d={`M${i*3-24} 24 l24 -24`}/>)}</g></g>}
    {effect==='halftone'&&<g mask={`url(#${id}-mask)`} stroke="none">{Array.from({length:15},(_,phase)=><g class="halftone-wave" style={`animation-delay:${-phase*.12}s`}>{Array.from({length:64},(_,i)=>i).filter(i=>i%8+Math.floor(i/8)===phase).map(i=><circle class="halftone-dot" cx={i%8*3+1.5} cy={Math.floor(i/8)*3+1.5} r=".9" fill="white"/>)}</g>)}</g>}
    {effect==='interference'&&<g mask={`url(#${id}-mask)`}><rect width="24" height="24" stroke="none" fill={`url(#${id}-interference)`}/></g>}
  </svg>
</span>
