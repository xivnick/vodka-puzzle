---
import chevron from '../../public/icons/achievement-preview/chevron-right.svg?raw';
const { href } = Astro.props;
---
<nav class="account-back">
  <a href={href}>
    <span aria-hidden="true"><Fragment set:html={chevron} /></span>돌아가기
  </a>
</nav>

<style>
  .account-back { text-align: left; margin-bottom: var(--space-md, 12px); }
  .account-back a { display: inline-flex; align-items: center; gap: 4px; font-size: .73rem; color: #999; text-decoration: none; }
  .account-back a:hover { color: #555; }
  .account-back span { display: block; width: 14px; height: 14px; transform: rotate(180deg); }
  .account-back :global(svg) { display: block; width: 100%; height: 100%; }
</style>
