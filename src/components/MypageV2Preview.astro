---
import PageLayout from '../layouts/PageLayout.astro';
import NicknameBadge from './NicknameBadge.astro';
import CoinAmount from './CoinAmount.astro';
import coin from '../../public/icons/coin-candidates/tabler-coins.svg?raw';
import data from '../data/mypage-v2-preview.json';
import {getAchievementGoal as goal} from '../lib/achievement-goals.js';
import '../styles/nickname.css';
import '../styles/mypage-v2-preview.css';
import '../styles/nickname-badge-effects.css';
const {customize=false}=Astro.props;
const files=import.meta.glob('../../public/icons/**/*.svg',{query:'?raw',import:'default',eager:true});
const raw=(src)=>String(files[`../../public${src}`]??'');
const initialOwned=new Set(['leaf','puzzle','flame','sword','rabbit']);
const missionPriority=(m)=>{const s=goal(m);return !s?2:m.count>=s.at?0:1;};
const orderedMissions=[...data.missions].sort((a,b)=>missionPriority(a)-missionPriority(b));
---
<PageLayout title={customize?"꾸미기":"마이페이지"}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  {customize&&<nav slot="above-title" class="customize-back"><a href="/test/mypage-v2/"><span aria-hidden="true"><Fragment set:html={raw("/icons/achievement-preview/chevron-right.svg")}/></span>돌아가기</a></nav>}
  <section class="mypage-v2" data-customize={customize?"true":"false"} aria-label="마이페이지 v2 시안">
    <section class="account-section" aria-labelledby="accountTitle" hidden={customize}>
    <div class="view-heading"><h2 id="accountTitle">계정</h2></div>
    <header class="profile">
      <div class="profile-identity"><div class="nickname-control"><div id="nicknameDisplay" class="nickname-display"><span id="accountName">퍼즐러</span><button id="editAccountNickname" class="nickname-pencil" type="button" aria-label="닉네임 편집" aria-expanded="false" aria-controls="profileNicknameForm"><span aria-hidden="true"><Fragment set:html={raw('/icons/achievement-preview/pencil.svg')}/></span></button></div><form id="profileNicknameForm" hidden><input id="accountNickname" class="nick-input" type="text" aria-label="닉네임" value="퍼즐러" maxlength="20" required autocomplete="off"/><button class="nickname-pencil nickname-save" type="submit" aria-label="닉네임 저장" title="저장"><span aria-hidden="true"><Fragment set:html={raw("/icons/achievement-preview/check.svg")}/></span></button></form></div><p class="account-email">puzzler@example.com</p></div>

      <div class="profile-wallet">{!customize&&<span class="balance" aria-label="보유 코인"><CoinAmount amount={1240} id="coinBalance"/></span>}<span class="ticket-amount" id="ticketBalanceWrapper" title="타임머신 티켓" aria-label="타임머신 티켓 0장" hidden><img src="/icons/time-machine/ticket.svg" alt="" width="16" height="16"/><span id="ticketBalance">0</span></span></div>
    </header>
      <div class="icon-overview"><div class="icon-display"><div id="profileBadge" hidden><NicknameBadge name="퍼즐러" icon="leaf" label="현재 표시 이름"/></div><span id="equippedIcon" class="equipped-icon" role="img" aria-label="현재 아이콘: 잎사귀"></span><div class="equipped-description"><span id="equippedIconName">잎사귀</span><span id="equippedColorSeparator" aria-hidden="true">·</span><span id="equippedColor" class="equipped-color-name">기본</span></div></div><a class="appearance-link" href="/test/mypage-v2/customize/"><span class="appearance-label">꾸미기</span><span class="appearance-chevron" aria-hidden="true"><Fragment set:html={raw("/icons/achievement-preview/chevron-right.svg")}/></span></a>

      </div>
    </section>
    <section class="preview-section" aria-labelledby="previewTitle" hidden={!customize}>
      <div class="view-heading"><h2 id="previewTitle">미리보기</h2></div>
      <div class="dress-preview"><div class="preview-ranking"><span class="sample-rank">3</span><span id="dressBadge"><NicknameBadge name="퍼즐러" icon="leaf" label="꾸미기 미리보기"/></span><span id="selectionLabel" class="sample-value">잎사귀 · 기본</span></div></div>
    </section>

    <section id="panel-missions" aria-labelledby="missionsTitle" hidden={customize}>
      <section class="daily-quests" aria-labelledby="dailyQuestsTitle">
        <div class="view-heading"><h2 id="dailyQuestsTitle">일일 과제</h2><span class="daily-reset">매일 갱신</span></div>
        <div class="mission-list">{data.dailyQuests.map(q=><article class="mission-row" data-daily-quest={q.id}>
          <span class="mission-icon" aria-hidden="true"><Fragment set:html={raw(`/icons/achievement-preview/${q.icon}.svg`)}/></span>
          <div class="mission-content"><div class="mission-title"><h3>{q.name}</h3><span class="mission-value" data-daily-state>{q.complete?'1/1':'0/1'}</span></div><p class="mission-condition">{q.text}</p><div class="mission-bottom"><span class="mission-reward">{q.kind==='coins'?<CoinAmount amount={q.value}/>:<span class="daily-ticket" aria-label={`타임머신 티켓 ${q.value}장`}><img src="/icons/time-machine/ticket.svg" alt="" width="14" height="14"/><span>{q.value}</span></span>}</span><button type="button" class:list={['claim-button',{'claim-ready':q.complete&&!q.unavailable}]} data-daily-claim={q.id} disabled={!q.complete||q.unavailable} title={q.unavailable?'다른 사용자가 먼저 완료했습니다.':undefined}>{q.unavailable?'기회 종료':q.complete?'받기':'진행 중'}</button></div></div>
        </article>)}</div>
      </section>
      <div class="view-heading mission-heading"><h2 id="missionsTitle" tabindex="-1">도전 과제</h2>
      <div class="filters" aria-label="도전 과제 분류">{[['all','전체'],['basic','일반'],['group','유형'],['special','특수']].map(([id,label],i)=><button type="button" data-filter={id} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div></div>
      <div class="mission-list" id="missionList">{orderedMissions.map(m=>{const s=goal(m);const ready=s&&m.count>=s.at;const icon=data.icons.find(i=>i.id===m.icon);return <article class:list={['mission-row',{'is-complete':!s}]} data-mission={m.id} data-group={m.group}>
        <span class="mission-icon" aria-hidden="true">{icon.src.endsWith('.svg')?<Fragment set:html={raw(icon.src)}/>:<img src={icon.src} alt="" width="28" height="28"/>}</span>
        <div class="mission-content"><div class="mission-title"><h3>{m.name}</h3><span class="mission-value">{s?`${m.count} / ${s.at}`:'완료'}</span></div><p class="mission-condition" aria-label={m.difficulty?`난이도 ${m.difficulty} 퍼즐 풀기`:undefined}>{m.text}</p><div class="mission-progress" role="progressbar" aria-label={`${m.name} 진행도`} aria-valuemin="0" aria-valuemax={s?.at??1} aria-valuenow={Math.min(m.count,s?.at??1)}><span style={`width:${s?Math.min(m.count/s.at,1)*100:100}%`}/></div><div class="mission-bottom"><span class="mission-reward">{s?(s.kind==='coins'?<CoinAmount amount={s.value}/>:s.kind==='effect'?'별빛 반짝임 효과':`${data.icons.find(i=>i.id===s.value)?.name} 아이콘`):'아이콘 획득 완료'}</span><button type="button" data-claim={m.id} disabled={!ready} class:list={['claim-button',{'claim-ready':ready}]}>{ready?'받기':s?'진행 중':'획득 완료'}</button></div></div>
      </article>})}</div>
      <p id="emptyMissions" class="empty-state" hidden>지금 받을 보상은 모두 받았어요.</p>
    </section>
    <section id="panel-dress" class="wardrobe-section" aria-labelledby="dressTitle" hidden={!customize}>
      <div class="view-heading" id="dress"><h2 id="dressTitle">꾸미기</h2></div>
      <div class="unified-settings">
        <details class="wardrobe-picker" name="customize-settings"><summary><span class="settings-field-label">아이콘</span><span class="selected-summary"><span id="selectedIconVisual" class="selected-icon-visual" aria-hidden="true"></span><span id="selectedIconLabel" class="picker-name">잎사귀</span></span><span class="picker-chevron" aria-hidden="true"><Fragment set:html={raw("/icons/achievement-preview/chevron-right.svg")}/></span></summary><div class="wardrobe-body">
      <div id="wardrobe-icons"><div class="item-grid icons-grid"><button type="button" class="icon-item" data-select-icon="none" aria-pressed="false"><span class="item-icon empty-icon" aria-hidden="true">—</span><span>아이콘 없음</span></button>{data.icons.map(icon=><button type="button" class="icon-item" hidden={!initialOwned.has(icon.id)} data-select-icon={icon.id} disabled={!initialOwned.has(icon.id)} aria-pressed={icon.id==='leaf'?'true':'false'} title={icon.name}><span class="item-icon" aria-hidden="true">{icon.src.endsWith('.svg')?<Fragment set:html={raw(icon.src)}/>:<img src={icon.src} alt="" width="28" height="28"/>}</span><span>{icon.name}</span></button>)}</div></div></div></details>
      <details class="wardrobe-picker" name="customize-settings"><summary><span class="settings-field-label">색깔</span><span class="selected-summary"><i id="selectedColorSwatch" class="picker-swatch" aria-hidden="true"></i><span id="selectedColorLabel" class="picker-name">기본</span></span><span class="picker-chevron" aria-hidden="true"><Fragment set:html={raw("/icons/achievement-preview/chevron-right.svg")}/></span></summary><div class="wardrobe-body" id="wardrobe-colors"><div id="colorInventory" class="color-inventory"></div></div></details>
      <div class="selected-color-options" id="selectedColorOptions" hidden><span class="settings-field-label">색 표현</span><div class="color-option-groups"><div role="group" aria-label="색 표현">{[['gradient','그라데이션'],['split','2분할']].map(([id,label],i)=><button type="button" data-style={id} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div><div role="group" aria-label="색 방향">{[['135deg','대각선'],['90deg','좌우']].map(([id,label],i)=><button type="button" data-angle={id} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div></div></div>
      <details id="effectSettings" class="wardrobe-picker" name="customize-settings" hidden><summary><span class="settings-field-label">효과</span><span class="picker-current" id="pickerEffectName">효과 없음</span><span class="picker-chevron" aria-hidden="true"><Fragment set:html={raw("/icons/achievement-preview/chevron-right.svg")}/></span></summary><div class="wardrobe-body" id="wardrobe-effects"><div id="effectInventory" class="effect-inventory"></div></div></details>
      </div>
    </section>
    <section id="panel-draw" aria-labelledby="drawTitle" hidden={!customize}>
      <div class="view-heading" id="draw"><h2 id="drawTitle">뽑기</h2>{customize&&<span class="balance" aria-label="보유 코인"><CoinAmount amount={1240} id="coinBalance"/></span>}</div>
      <div class="draw-actions"><p class="draw-description">아이콘을 꾸밀 색깔과 효과를 뽑아보세요.</p><button type="button" data-draw="1"><strong>1회 뽑기</strong><CoinAmount amount={100}/></button><button type="button" data-draw="10"><strong>10회 뽑기</strong><CoinAmount amount={1000}/></button><details class="draw-guide"><summary>확률표</summary><table class="draw-rates"><thead><tr><th scope="col">등급</th><th scope="col">등급 확률</th><th scope="col">개별 확률</th></tr></thead><tbody>{data.drawRates.map(rate=>{const count=rate.rarity==='epic'?data.effects.length:rate.rarity==='rare'?data.rare.length:data.common.length;const each=rate.probability*100/count;return <tr><th scope="row">{rate.name}<span>{count}종</span></th><td>{rate.probability*100}%</td><td>{Number(each.toFixed(4))===each?'':'약 '}{each.toLocaleString('ko-KR',{maximumFractionDigits:4})}%</td></tr>})}</tbody></table></details></div>
      <div id="drawResult" class="draw-result" hidden><div class="result-heading"><h3>뽑기 결과</h3></div><p id="drawStatus" class="draw-status" role="status"></p><div id="resultItems" class="result-items"></div></div>

    </section>
    <section id="panel-craft" class="craft-section" aria-labelledby="craftTitle" hidden={!customize}>
      <div class="view-heading"><h2 id="craftTitle">조합</h2></div>
      <div class="craft-body"><p class="craft-description">색깔 3개를 조합해 새로운 색깔을 만듭니다.</p><div id="craftSlots" class="craft-slots"></div><div id="craftSelector" class="craft-selector" data-open="false" aria-hidden="true" inert><div class="craft-selector-content"><div class="craft-selector-inner"><div class="craft-selector-heading"><button type="button" class="quiet-link" id="closeCraftSelector">닫기</button></div><div id="craftChoices" class="craft-choices"></div><p id="emptyCraftChoices" class="empty-craft-choices" hidden>선택할 재료가 없습니다.</p></div></div></div><button type="button" id="craftConfirm" disabled>조합하기</button></div><div id="craftResult" class="craft-result" hidden><div class="result-heading"><h3>조합 결과</h3></div><div id="craftResultItems" class="result-items" aria-live="polite" aria-relevant="additions"></div></div>
    </section>

    <div class="prototype-footer"><div class="preview-links"><a href="/test/achievement-badges/mission-overview/">전체 미션 기준</a><button type="button" id="resetDemo">시안 초기화</button></div><p class="icon-credit">아이콘: <a href="https://tabler.io/icons">Tabler</a> · <a href="https://lucide.dev/">Lucide</a> · <a href="https://github.com/bytedance/IconPark">IconPark</a> · <a href="https://icons8.com/">Icons8</a></p></div>
    <template id="coinIconTemplate"><span class="coin-icon" aria-hidden="true"><Fragment set:html={coin}/></span></template>
    <script id="mypagePreviewData" type="application/json" set:html={JSON.stringify(data)}/>
    {data.icons.map(icon=><template data-icon-template={icon.id}>{icon.src.endsWith('.svg')?<Fragment set:html={raw(icon.src)}/>:<img src={icon.src} alt="" width="18" height="18"/>}</template>)}
  </section>
</PageLayout>
<script>import '../scripts/mypage-v2-preview.js';</script>
