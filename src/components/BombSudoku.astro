---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';
import '../styles/daily-sudoku.css';
import '../styles/bomb-sudoku.css';
import { givens, isBomb, bombValues } from '../lib/bomb-sudoku.js';
const puzzleId = 'test-bomb-sudoku-261001';
---
<PuzzleLayout title="261001 폭탄 스도쿠" {puzzleId}
  subtitle="폭탄 위치 공개형 · 테스트 문제"
  description="폭탄의 바로 왼쪽과 오른쪽 숫자를 비교하는 스도쿠 테스트"
  preview showCloud={false} showLeaderboard={false} showPreviewLeaderboard={false}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div slot="rules">
    각 가로줄, 세로줄, 3×3 상자에는 1~8과 폭탄이 하나씩 들어갑니다.<br />
    폭탄 칸은 정해져 있습니다. 아홉 폭탄에 0.5부터 8.5까지를 각각 한 번씩 넣으세요.<br />
    폭탄의 <strong>바로 왼쪽 숫자 &lt; 폭탄 값 &lt; 바로 오른쪽 숫자</strong>여야 합니다.<br />
    판의 양끝에서는 존재하는 이웃만 비교합니다.<br />
    빨간 글자는 폭탄 값이고, 빨간 배경은 규칙 위반입니다.
  </div>
  <div slot="controls">
    칸을 선택하면 입력 버튼이 그 칸에 맞게 바뀝니다.<br />
    키보드는 일반 칸에서 1~8, 폭탄 칸에서 0~8로 입력합니다. 폭탄 칸에서 4를 누르면 4.5가 들어갑니다.<br />
    메모하기 또는 M 키로 후보를 적고, 방향키로 이동하세요.<br />
    Backspace·Delete로 지웁니다. 일반 칸에서는 0으로도 지울 수 있습니다.
  </div>
  <section id="bombGame" aria-label="폭탄 스도쿠">
    <div class="sudoku-board-tools"><button id="bombNotes" class="sudoku-notes-toggle" type="button" tabindex="-1" aria-pressed="false">메모하기</button></div>
    <div id="bombBoard" class="sudoku-board" role="group" aria-label="9행 9열 폭탄 스도쿠">
      {givens.flat().map((n, i) => <button type="button"
        class:list={['sudoku-cell', { given: !!n, bomb: isBomb(i) }]}
        data-cell={i} tabindex={i === 0 ? 0 : -1}
        aria-label={`${Math.floor(i / 9) + 1}행 ${i % 9 + 1}열, ${isBomb(i) ? '폭탄 빈칸' : n || '빈칸'}`}><span class="cell-value">{n || ''}</span></button>)}
    </div>
    <p id="bombInputLabel" class="bomb-input-label" aria-live="polite">숫자 입력 · 1~8</p>
    <div id="bombNumbers" class="bomb-number-pad" aria-label="일반 숫자 입력">
      {Array.from({length: 8}, (_, n) => <button type="button" tabindex="-1" data-number={n + 1}>{n + 1}</button>)}
    </div>
    <div id="bombValues" class="bomb-number-pad bomb-value-pad" aria-label="폭탄 값 입력" hidden>
      {bombValues.map(n => <button type="button" tabindex="-1" data-number={n}>{n}</button>)}
    </div>
    <p id="bombPadHelp" class="bomb-pad-help">폭탄 칸을 선택하면 0.5~8.5를 입력할 수 있습니다.</p>
    <div class="bottom-buttons">
      <button id="bombErase" type="button">지우기</button>
      <button id="bombReset" type="button" class="danger">초기화</button>
    </div>
    <p class="bomb-demo-note">테스트 문제는 완료 기록과 클라우드 저장에 반영되지 않습니다.</p>
  </section>
  <PuzzleCompletion slot="completion" id="bombComplete" />
</PuzzleLayout>
<script>import '../scripts/bomb-sudoku.js';</script>
