---
const { previewPuzzle } = Astro.props;
---
<p id="adminStatus" class="admin-status" role="status"></p>
<form id="adminForm" data-preview-puzzle={previewPuzzle} hidden>
  <fieldset id="adminFields" class="admin-fields">
    <div class="admin-editor-heading">
      <h2 id="adminPuzzleId"></h2>
      <a id="adminPreview" class="admin-quiet-action" target="_blank" rel="noopener" hidden={Boolean(previewPuzzle)}>문제 열기 ↗</a>
    </div>

    <div class="admin-field">
      <label for="adminTitle">제목</label>
      <input class="account-input" id="adminTitle" maxlength="120" required />
    </div>
    <div class="admin-field">
      <label for="adminSummary">요약설명</label>
      <textarea class="account-input" id="adminSummary" maxlength="500" rows="3" required></textarea>
    </div>
    <div class="admin-field-pair">
      <div class="admin-field">
        <label for="adminType">문제 종류</label>
        <input class="account-input" id="adminType" maxlength="80" required />
      </div>
      <div class="admin-field">
        <label for="adminOrder">목록 순서</label>
        <input class="account-input" id="adminOrder" type="number" min="-100000" max="100000" step="1" aria-describedby="adminOrderHelp" required />
        <p class="admin-help" id="adminOrderHelp">큰 값이 먼저 표시됩니다. 값이 같으면 최근에 공개된 문제가 먼저 표시됩니다.</p>
      </div>
    </div>
    <fieldset id="adminDifficulty" class="admin-difficulty">
      <legend>난이도</legend>
      <div class="admin-difficulty-options">
        {[0, 1, 2, 3].map(level => (
          <label>
            <input class="sr-label" type="radio" name="difficulty" value={level} aria-label={level ? `난이도 ${level}` : '표시 안 함'} checked={level === 0} />
            <span class="admin-difficulty-option" aria-hidden="true">
              {level ? <span class="puzzle-difficulty">{Array.from({length:level}, () => <span class="difficulty-diamond" />)}</span> : '표시 안 함'}
            </span>
          </label>
        ))}
      </div>
    </fieldset>

    <section class="admin-publication" aria-labelledby="adminPublicationTitle">
      <h3 id="adminPublicationTitle">공개 설정</h3>
      <div class="admin-field-pair">
        <div class="admin-field">
          <label for="adminState">공개 상태</label>
          <select class="account-input" id="adminState"><option value="draft">초안</option><option value="test">테스트</option><option value="published">즉시 공개</option><option value="scheduled">예약 공개</option></select>
        </div>
        <div class="admin-field" id="adminSchedule" hidden>
          <label for="adminDate">공개 일시 (한국 시간)</label>
          <input class="account-input" id="adminDate" type="datetime-local" step="1" />
        </div>
      </div>
      <p id="adminPublicationHelp" class="admin-help"></p>
    </section>

    <div class="admin-actions">
      <p id="adminSaveStatus" class="admin-status" role="status"></p>
      <button id="adminSave" class="account-button admin-save" type="submit" disabled>변경사항 저장</button>
    </div>
  </fieldset>
</form>
