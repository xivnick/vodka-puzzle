---
import PuzzleLayout from '../layouts/PuzzleLayout.astro';
import PuzzleCompletion from './PuzzleCompletion.astro';
import NumberPad from './NumberPad.astro';
import '../styles/daily-sudoku.css';
import { givens, tomatoes, tomatoDigits } from '../lib/tomato-sudoku.js';
const { puzzleId = '261005_01', preview = false } = Astro.props;
---
<PuzzleLayout title="261005 토마토스 스도쿠" {puzzleId}
  subtitle="토마토 열 칸에 정해진 숫자 묶음을 나누어 넣으세요"
  description="토마토 열 칸에 1, 2, 3, 3, 3, 4, 5, 5, 6, 7을 넣는 스도쿠"
  preview={preview} showCloud={!preview} showLeaderboard={!preview}>
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div slot="rules">
    각 가로줄, 세로줄, 굵은 선으로 구분된 3×3 영역에 1~9를 한 번씩 넣으세요.<br />
    열 개의 토마토 칸에는 {`{1, 2, 3, 3, 3, 4, 5, 5, 6, 7}`} 이 하나씩 들어갑니다. (3은 세개, 5는 두개)
  </div>
  <div slot="controls">
    칸을 선택하고 숫자 버튼으로 입력하세요.<br />
    메모하기 버튼이나 M 키로 메모 입력을 켜고 끄세요.<br />
    다른 칸을 눌러 이동하고 지우기 버튼으로 입력을 지우세요.
  </div>
  <section id="tomatoGame" data-puzzle-id={puzzleId} data-preview={String(preview)} aria-label="토마토스 스도쿠">
    <div class="sudoku-board-tools"><button id="tomatoNotes" class="sudoku-notes-toggle" type="button" tabindex="-1" aria-pressed="false">메모하기</button></div>
    <div id="tomatoBoard" class="sudoku-board" role="group" aria-label="9행 9열 스도쿠">
      {givens.flat().map((n, i) => <button type="button"
        class:list={['sudoku-cell', { given: !!n, tomato: tomatoes.includes(i) }]}
        data-cell={i} tabindex={i === 0 ? 0 : -1}
        aria-label={`${Math.floor(i / 9) + 1}행 ${i % 9 + 1}열, ${n || '빈칸'}${n ? ', 고정 숫자' : ''}${tomatoes.includes(i) ? ', 토마토 칸' : ''}`}>{n || ''}</button>)}
    </div>
    <p class="tomato-digits" aria-label={`토마토에 들어갈 숫자: ${tomatoDigits.join(', ')}`}>
      <img src="/icons/tomato.svg?v=4" alt="" width="16" height="16" />
      <span>=</span>
      <span>{`{${tomatoDigits.join(', ')}}`}</span>
    </p>
    <NumberPad id="tomatoNumbers" max={9} />
    <div class="bottom-buttons">
      <button id="tomatoErase" type="button">지우기</button>
      <button id="tomatoReset" type="button" class="danger">초기화</button>
    </div>
  </section>
  <PuzzleCompletion slot="completion" id="tomatoComplete" />
</PuzzleLayout>
<script>import '../scripts/tomato-sudoku.js';</script>
<style>
  #tomatoGame { width:100%; }
  .tomato-digits { display:flex; align-items:center; justify-content:center; gap:.3em; margin:14px 0 0; color:#666; font-size:clamp(.78rem,2.8vw,.95rem); line-height:1.4; }
  .tomato-digits img { width:1em; height:1em; flex-shrink:0; opacity:.5; }
  #tomatoBoard .sudoku-cell.tomato { background:#fff; }
  #tomatoBoard .sudoku-cell.selected { background:#e1e9f3; }
  #tomatoBoard .sudoku-cell.conflict { background:#fbeaea; }
  #tomatoBoard .sudoku-cell.tomato::before { content:""; position:absolute; inset:4%; background:url('/icons/tomato.svg?v=4') center / contain no-repeat; opacity:.12; pointer-events:none; }
  #tomatoBoard .sudoku-cell .cell-value { position:relative; z-index:1; }
  #tomatoBoard .sudoku-cell .notes { z-index:1; }
  #tomatoBoard .sudoku-cell { -webkit-tap-highlight-color:transparent; }
  #tomatoBoard .sudoku-cell:focus-visible { outline:2px solid #4a6fa5; outline-offset:-3px; z-index:2; }
</style>
