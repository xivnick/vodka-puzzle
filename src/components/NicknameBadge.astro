---
const { name='퍼즐러', icon='star', src, size=18, label, sparkle=false }=Astro.props;
const files=import.meta.glob('../../public/icons/**/*.svg',{query:'?raw',import:'default',eager:true});
const path=src??`/icons/achievement-preview/${icon}.svg`;
const raster=!path.endsWith('.svg');
const source=raster?'':String(files[`../../public${path}`]??'');
if(!raster&&!source) throw new Error(`Unknown nickname badge icon: ${path}`);
---
<span class="nickname-badge" data-nickname-badge style={`--badge-size:${size}px`}>
  <span class="badge-name" data-badge-name>{name}</span>
  <span class="badge-anchor"><span class="badge-visual" role={label?'img':undefined} aria-label={label} aria-hidden={label?undefined:'true'}>{raster?<img src={path} alt="" width={size} height={size}/>:<Fragment set:html={source}/>} {sparkle&&<span class="badge-sparkle" aria-hidden="true"/>}</span></span>
</span>
<script>
  import {initNicknameBadges} from '../scripts/nickname-badge-alignment.js';
  initNicknameBadges();
</script>
<style>
.nickname-badge{display:inline-flex;align-items:baseline;gap:4px;white-space:nowrap;line-height:inherit;color:inherit}
.badge-name{display:inline-block}
.badge-anchor{position:relative;display:inline-block;flex:0 0 var(--badge-size);width:var(--badge-size);height:0}
.badge-visual{position:absolute;left:0;top:var(--badge-top,calc(-.5ex - var(--badge-size)/2));display:block;width:var(--badge-size);height:var(--badge-size)}
.badge-visual :global(svg){display:block;width:100%;height:100%;overflow:visible}
.badge-visual img{display:block;width:100%;height:100%;object-fit:contain}
.badge-sparkle{position:absolute;right:-3px;top:-3px;width:7px;height:7px;background:currentColor;clip-path:polygon(50% 0,62% 38%,100% 50%,62% 62%,50% 100%,38% 62%,0 50%,38% 38%);animation:badge-sparkle 4.2s ease-in-out infinite}
@keyframes badge-sparkle{0%{opacity:.3;transform:scale(.6) rotate(0deg)}50%{opacity:1;transform:scale(1) rotate(90deg)}100%{opacity:.3;transform:scale(.6) rotate(180deg)}}
@media(prefers-reduced-motion:reduce){.badge-sparkle{animation:none}}
</style>
