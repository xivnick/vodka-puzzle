---
import PageLayout from './PageLayout.astro';
const { title, puzzleId, description, subtitle, showCloud = true, showLeaderboard = true } = Astro.props;
const hasControls = Astro.slots.has('controls');
const hasCustomLeaderboard = Astro.slots.has('leaderboard');
---
<PageLayout title={title} description={description} subtitle={subtitle} puzzle>
<slot name="head" slot="head" />
<slot name="above-title" slot="above-title" />
<div class="container">
<div class="help-toggles">
<button class="rules-toggle" id="rulesToggle" type="button" aria-expanded="false" aria-controls="rulesBox">규칙 보기</button>
{hasControls && <button class="rules-toggle" id="controlsToggle" type="button" aria-expanded="false" aria-controls="controlsBox">조작 방법</button>}
</div>
<div class="rules-box" id="rulesBox"><slot name="rules" /></div>
{hasControls && <div class="rules-box" id="controlsBox"><slot name="controls" /></div>}
<div class="puzzle-body"><slot /></div>
{showCloud && <div class="cloud-btns" id="cloudBtns" style="display:none"><button class="cloud-btn" onclick="handleCloudSave()">저장하기</button><button class="cloud-btn" onclick="handleCloudLoad()">불러오기</button></div>}
{showLeaderboard && <div class="lb-section"><div class="lb-title">푼 사람</div><div id="leaderboard"><slot name="leaderboard" /></div></div>}</div>
<script is:inline define:vars={{puzzleId, showLeaderboard, hasCustomLeaderboard}}>window.addEventListener('DOMContentLoaded',()=>{
  const panels=[['rulesToggle','rulesBox'],['controlsToggle','controlsBox']]
    .map(([buttonId,panelId])=>[document.getElementById(buttonId),document.getElementById(panelId)])
    .filter(([button,panel])=>button && panel);
  panels.forEach(([button,panel])=>button.addEventListener('click',()=>{
    const expand=button.getAttribute('aria-expanded')!=='true';
    panels.forEach(([otherButton,otherPanel])=>{
      const open=otherPanel===panel && expand;
      otherPanel.classList.toggle('open',open);
      otherButton.setAttribute('aria-expanded',String(open));
    });
  }));
  initCloudBtns();if(showLeaderboard && !hasCustomLeaderboard)renderLeaderboard(puzzleId,'leaderboard');
});</script>
</PageLayout>
<style>
.container { width:100%; }
.help-toggles { display:flex; justify-content:center; gap:20px; margin-top:6px; }
.rules-toggle {
  background:none; border:0; border-bottom:1px solid #ccc; border-radius:0;
  font-family:inherit; line-height:1.5; padding:0 0 1px;
  margin:0; align-self:center;
}
.rules-box { margin:12px 0 0; padding:12px 16px; }
.puzzle-body { width:100%; margin-top:16px; }
.puzzle-body :global(.bottom-buttons) { margin:12px 0 0; }
.cloud-btns { margin-top:12px; }
.lb-section { margin-top:24px; }
</style>
