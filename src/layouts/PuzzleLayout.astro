---
import SiteLayout from './SiteLayout.astro';
const { title, puzzleId, description } = Astro.props;
---
<SiteLayout title={title} description={description} legacy>
<slot name="head" slot="head" />
<h1>{title}</h1><div class="container"><details class="rules-box"><summary>규칙 보기</summary><slot name="rules" /></details><slot />
<div class="cloud-btns" id="cloudBtns" style="display:none"><button class="cloud-btn" onclick="handleCloudSave()">저장하기</button><button class="cloud-btn" onclick="handleCloudLoad()">불러오기</button></div>
<div class="lb-section"><div class="lb-title">푼 사람</div><div id="leaderboard"></div></div></div>
<script is:inline define:vars={{puzzleId}}>window.addEventListener('DOMContentLoaded',()=>{initCloudBtns();renderLeaderboard(puzzleId,'leaderboard');});</script>
</SiteLayout>
