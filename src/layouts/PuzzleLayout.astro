---
import PageLayout from './PageLayout.astro';
const { title, puzzleId, description, subtitle, showCloud = true, showLeaderboard = true, preview = false, showPreviewCloud = true, showPreviewLeaderboard = true } = Astro.props;
const hasControls = Astro.slots.has('controls');
const hasCustomLeaderboard = Astro.slots.has('leaderboard');
const hasCompletion = Astro.slots.has('completion');
const managed = !preview && /^\d{6}_\d{2}$/.test(puzzleId || '');
---
<PageLayout title={title} description={description} subtitle={subtitle} puzzle>
<Fragment slot="head">
  <slot name="head" />
  {managed && <script is:inline define:vars={{puzzleId}}>
    window.puzzlePage = { id: puzzleId, published: false };
    // Start metadata alongside the static puzzle and account initialization.
    getPuzzleDetails(puzzleId).catch(() => {});
  </script>}
</Fragment>
<slot name="above-title" slot="above-title" />
<div class="container">
{managed && <p id="puzzleReleaseStatus" class="release-status" role="status" hidden></p>}
<div class="help-toggles">
<button class="rules-toggle" id="rulesToggle" type="button" aria-expanded="false" aria-controls="rulesBox">규칙 보기</button>
{hasControls && <button class="rules-toggle" id="controlsToggle" type="button" aria-expanded="false" aria-controls="controlsBox">조작 방법</button>}
</div>
<div class="rules-box" id="rulesBox"><slot name="rules" /></div>
{hasControls && <div class="rules-box" id="controlsBox"><slot name="controls" /></div>}
<div class="puzzle-body"><slot /></div>
{preview && showPreviewCloud
  ? <div class="cloud-btns" aria-label="시연용 저장·불러오기"><button class="cloud-btn" type="button" disabled>저장하기</button><button class="cloud-btn" type="button" disabled>불러오기</button></div>
  : !preview && showCloud && <div class="cloud-btns" id="cloudBtns" style="display:none"><button class="cloud-btn" onclick="handleCloudSave()">저장하기</button><button class="cloud-btn" onclick="handleCloudLoad()">불러오기</button></div>}
{hasCompletion && <div class="completion"><slot name="completion" /></div>}
<slot name="after-cloud" />
{(showLeaderboard || preview && showPreviewLeaderboard) && <div class="lb-section"><div class="lb-title">푼 사람</div><div id="leaderboard"><slot name="leaderboard">{preview && <div class="lb-empty">시연에서는 완료 기록이 표시되지 않습니다.</div>}</slot></div></div>}</div>
<script is:inline define:vars={{puzzleId, showLeaderboard, hasCustomLeaderboard, preview, managed}}>window.addEventListener('DOMContentLoaded',async()=>{
  const panels=[['rulesToggle','rulesBox'],['controlsToggle','controlsBox']]
    .map(([buttonId,panelId])=>[document.getElementById(buttonId),document.getElementById(panelId)])
    .filter(([button,panel])=>button && panel);
  panels.forEach(([button,panel])=>button.addEventListener('click',()=>{
    const expand=button.getAttribute('aria-expanded')!=='true';
    panels.forEach(([otherButton,otherPanel])=>{
      const open=otherPanel===panel && expand;
      otherPanel.classList.toggle('open',open);
      otherButton.setAttribute('aria-expanded',String(open));
    });
  }));
  if(managed)await applyPuzzleDetails(puzzleId);
  if(!preview) initCloudBtns();if(showLeaderboard && !preview && !hasCustomLeaderboard)renderLeaderboard(puzzleId,'leaderboard');
});</script>
</PageLayout>
<style>
.container { width:100%; }
.release-status { margin:8px 0 12px; color:#888; font-size:.8rem; text-align:center; line-height:1.6; }
.help-toggles { display:flex; justify-content:center; gap:20px; margin-top:6px; }
.rules-toggle {
  background:none; border:0; border-bottom:1px solid #ccc; border-radius:0;
  font-family:inherit; line-height:1.5; padding:0 0 1px;
  margin:0; align-self:center;
}
.rules-box { margin:12px 0 0; padding:12px 16px; }
.puzzle-body { width:100%; margin-top:16px; }
.puzzle-body :global(.bottom-buttons) { margin:12px 0 0; }
.cloud-btns { margin-top:12px; }
.cloud-btn:disabled { cursor:default; }
.completion { width:100%; text-align:center; }
.lb-section { margin-top:24px; }
</style>
