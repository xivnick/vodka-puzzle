---
const designs = [
  { name: '데일리 스도쿠', kind: 'daily', cells: ['8', { note: '1 7' }, '', '', { text: '3', state: 'selected' }, '', '', '6', ''] },
  { name: '카쿠로', kind: 'kakuro', cells: [{ state: 'shade' }, { down: '15' }, { down: '9' }, { right: '12' }, { text: '7', state: 'entry' }, '', { right: '12' }, '', { right: '7', down: '4' }] },
  { name: '야지린', kind: 'yajilin', cells: [{ text: '1', state: 'yajilin-clue' }, '', '', '', { state: 'shade' }, '', { text: '×', state: 'excluded' }, '', ''], paths: [[1.5, .5, 2.5, .5], [2.5, .5, 2.5, 2.5], [2.5, 2.5, 1.5, 2.5]] },
  { name: '크롶키', kind: 'kropki', size: 2, cells: ['', { text: '2', state: 'selected' }, '', { text: '4', state: 'entry' }], marks: [['black-dot', 1, .5], ['white-dot', 1.5, 1], ['white-dot', 1, 1.5]] },
  { name: '온도계 스도쿠', kind: 'thermo', cells: ['', '', { text: '7', state: 'entry' }, '', '', '', '2', '', ''], paths: [[.5, 2.5, 2.5, .5]], marks: [['bulb', .5, 2.5]] },
  { name: '사각형을 지나라', kind: 'through', cells: [{ text: 'S', state: 'endpoint' }, '', '', '', '', '', '', '', { text: 'F', state: 'endpoint' }], paths: [[.5, .5, 1.5, .5], [1.5, .5, 1.5, 2.5], [1.5, 2.5, 2.5, 2.5]], marks: [['square', 1, 1], ['visited-square', 2, 2]] },
  { name: '사풍', kind: 'four-winds', cells: [{ state: 'cut' }, '', { state: 'cut' }, { state: 'wind-exact' }, { text: '2', state: 'wind-exact' }, '', { state: 'cut' }, { state: 'wind-exact' }, { state: 'cut' }], paths: [[1.23, 1.5, .48, 1.5, true], [1.5, 1.77, 1.5, 2.52, true]] },
  { name: '폴리그래프', kind: 'polygraph', size: 2, cells: ['3', '2', '2', '1'], paths: [[0, 0, 2, 0], [2, 0, 2, 1], [2, 1, 1, 1], [1, 1, 1, 2], [1, 2, 0, 2], [0, 2, 0, 0]],
    marks: Array.from({ length: 9 }, (_, i) => ['vertex', i % 3, Math.floor(i / 3)]) },
  { name: '토마토 스도쿠', kind: 'tomato', cells: [{ state: 'tomato-cell' }, '', '7', '', '5', { state: 'tomato-cell' }, '9', { text: '2', state: 'selected' }, { state: 'tomato-cell' }] },
];

const percent = (value, size) => `${100 * value / size}%`;
const position = (x, y, size) => `left:${percent(x, size)};top:${percent(y, size)}`;
function pathStyle([x, y, endX, endY], size) {
  const dx = endX - x;
  const dy = endY - y;
  return `${position(x, y, size)};width:${percent(Math.hypot(dx, dy), size)};--angle:${Math.atan2(dy, dx)}rad`;
}
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>보드카 퍼즐 로고 시안</title>
    <link rel="stylesheet" href="/css/common.css?v=31" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main id="logo-sheet">
      <h1>보드카 퍼즐 로고 시안</h1>
      <div class="designs">
        {designs.map(({ name, kind, size = 3, cells, paths = [], marks = [] }, index) => (
          <figure>
            <div class="icon" aria-hidden="true">
              <div class:list={['pattern', kind]} style={`--size:${size}`}>
                <div class="cells">
                  {cells.map(cell => {
                    const { text, state, note, right, down } = typeof cell === 'string' ? { text: cell } : cell;
                    return (
                      <div class:list={['cell', state, { clue: right || down, 'has-right': right, 'has-down': down }]}>
                        {text && <span class="digit">{text}</span>}
                        {note && <span class="notes">{note}</span>}
                        {right && <span class="right-sum">{right}</span>}
                        {down && <span class="down-sum">{down}</span>}
                      </div>
                    );
                  })}
                </div>
                {paths.map(path => <span class:list={['path', { arrow: path[4] }]} style={pathStyle(path, size)} />)}
                {marks.map(([mark, x, y]) => <span class:list={['mark', mark]} style={position(x, y, size)} />)}
              </div>
              <span class="wordmark" lang="en">vodka</span>
            </div>
            <figcaption>{index + 1}. {name}</figcaption>
          </figure>
        ))}
      </div>
    </main>
  </body>
</html>

<style>
  body {
    background: #fff;
    color: #222;
    font-family: 'Noto Sans KR', sans-serif;
  }
  main {
    width: min(100%, 840px);
    margin: 0 auto;
    padding: clamp(14px, 5vw, 46px);
  }
  h1 {
    margin: 0 0 clamp(18px, 4vw, 32px);
    font-size: clamp(17px, 3vw, 24px);
    font-weight: 500;
  }
  .designs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 4vw, 32px);
  }
  figure { min-width: 0; container-type: inline-size; }
  figcaption {
    margin-top: 8px;
    color: #555;
    font-size: clamp(9px, 1.65vw, 14px);
    text-align: center;
  }
  .icon {
    aspect-ratio: 1;
    display: grid;
    grid-template-rows: 1fr auto;
    justify-items: center;
    align-items: center;
    padding: 11cqw 0 8cqw;
    background: #fff;
    border: 1px solid #e8e5df;
    border-radius: 14cqw;
  }
  .wordmark { font-size: 14cqw; font-weight: 400; line-height: 1.1; }
  .pattern {
    --edge: #555;
    --grid: #ddd;
    --selected: #e1e9f3;
    --blue: #4a6fa5;
    --line: max(1px, .75cqw);
    position: relative;
    width: 60cqw;
    aspect-ratio: 1;
    font-variant-numeric: tabular-nums;
  }
  .cells {
    display: grid;
    width: 100%;
    height: 100%;
    grid-template: repeat(var(--size), minmax(0, 1fr)) / repeat(var(--size), minmax(0, 1fr));
    box-shadow: 0 0 0 var(--line) var(--edge);
  }
  .cell {
    position: relative;
    display: grid;
    place-items: center;
    min-width: 0;
    box-shadow: inset -1px -1px 0 var(--grid);
    color: #333;
    font-size: 11cqw;
    font-weight: 700;
    line-height: 1;
  }
  .digit { position: relative; z-index: 2; }
  .entry, .selected { color: var(--blue); }
  .selected { background: var(--selected); }
  .daily .cell:has(.digit):not(.selected), .tomato .cell:has(.digit):not(.selected) { background: #f8f8f6; }
  .notes { position: absolute; top: 13%; left: 12%; font-size: 4.5cqw; color: #777; }

  .kakuro { --edge: #444; --grid: #aaa; }
  .kakuro .shade, .clue { background: #575757; }
  .clue {
    --upper: #575757;
    --lower: #575757;
    background: linear-gradient(to top right, var(--lower) calc(50% - .65px), #444 50%, var(--upper) calc(50% + .65px));
    color: #181818;
    font-size: 6cqw;
  }
  .has-right { --upper: #ccc; }
  .has-down { --lower: #ccc; }
  .right-sum, .down-sum { position: absolute; }
  .right-sum { right: 7%; top: 9%; }
  .down-sum { left: 7%; bottom: 8%; }

  .path {
    position: absolute;
    z-index: 1;
    height: var(--path-thickness, max(1.5px, 2.1cqw));
    border-radius: 999px;
    background: var(--path-color, var(--blue));
    transform: translateY(-50%) rotate(var(--angle));
    transform-origin: left center;
  }
  .arrow::after {
    content: '';
    position: absolute;
    inset: 50% -.5cqw auto auto;
    transform: translateY(-50%);
    border-top: 2.7cqw solid transparent;
    border-bottom: 2.7cqw solid transparent;
    border-left: 4.2cqw solid var(--path-color);
  }
  .mark { position: absolute; transform: translate(-50%, -50%); }

  .yajilin { --edge: #505c66; --grid: #c8cfd5; }
  .yajilin .shade { background: #303940; }
  .excluded { color: #99a4ae; font-weight: 400; }
  .yajilin-clue .digit { color: #28343e; font-weight: 500; text-shadow: 0 0 2px #fff; }
  .yajilin-clue::before {
    content: '';
    position: absolute;
    inset: 23% 12%;
    background: #a5b2be;
    clip-path: polygon(0 32%, 55% 32%, 55% 0, 100% 50%, 55% 100%, 55% 68%, 0 68%);
  }

  .kropki { --edge: #444; --grid: #777; --selected: #e8edf5; width: 53cqw; }
  .black-dot, .white-dot {
    z-index: 3;
    width: 6.8cqw;
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid #222;
    background: #fff;
  }
  .black-dot { background: #222; }

  .thermo { --grid: #c9ced4; --path-color: #d6dde7; --path-thickness: 6.5cqw; }
  .thermo .path, .bulb { z-index: 0; }
  .bulb { width: 14cqw; aspect-ratio: 1; border-radius: 50%; background: var(--path-color); }

  .through, .polygraph { isolation: isolate; }
  .through .cells, .polygraph .cells, .four-winds .cells { box-shadow: none; }
  .through .cell, .polygraph .cell, .four-winds .cell { box-shadow: none; }
  .through .cell, .polygraph .cell {
    border-top: 1px dashed var(--grid);
    border-left: 1px dashed var(--grid);
  }
  .through { --grid: #b8b8b8; border-right: 1px dashed var(--grid); border-bottom: 1px dashed var(--grid); }
  .square, .visited-square { z-index: -1; width: 29cqw; aspect-ratio: 1; background: #c4c4c6; }
  .visited-square { background: #c7dfc7; }
  .endpoint { color: #222; font-size: 9cqw; }
  .endpoint .digit { paint-order: stroke fill; -webkit-text-stroke: 3px white; }

  .four-winds { --grid: #b7b9bb; --path-color: #5b8c64; }
  .four-winds .cell:not(.cut) { border: 1px solid #333; font-size: 10cqw; }
  .four-winds .cell:nth-child(2) { border-bottom: 1px dashed var(--grid); }
  .four-winds .cell:nth-child(4) { border-right: 1px dashed var(--grid); }
  .four-winds .cell:nth-child(5) { border: 0; }
  .four-winds .cell:nth-child(6) { border-left: 1px dashed var(--grid); }
  .four-winds .cell:nth-child(8) { border-top: 1px dashed var(--grid); }
  .wind-exact { background: #dcebdc; }
  .wind-exact .digit { font-weight: 500; }

  .polygraph { --grid: #b6b6b6; width: 50cqw; border-right: 1px dashed var(--grid); border-bottom: 1px dashed var(--grid); }
  .polygraph .cell { font-weight: 400; }
  .vertex { z-index: 2; width: 4.2cqw; aspect-ratio: 1; background: white; border: 1px solid #888; border-radius: 50%; }

  .tomato-cell::before {
    content: '';
    position: absolute;
    inset: 4%;
    background: url('/icons/tomato.svg?v=4') center / contain no-repeat;
    opacity: .12;
  }
</style>
