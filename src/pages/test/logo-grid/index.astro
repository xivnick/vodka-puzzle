---
const designs = [
  { name: '오른쪽 연결선', digits: ['8', '', '', '', '', ''], green: 4, paths: [[1.5, .5, 2.5, .5]] },
  { name: '왼쪽 연결선', digits: ['', '', '5', '', '', ''], green: 1, paths: [[.5, 2.5, 1.5, 2.5]] },
  { name: '두 숫자와 꺾인 선', digits: ['2', '', '7', '', '', ''], green: 5, paths: [[.5, 2.25, .5, 2.5], [.5, 2.5, 1.5, 2.5]] },
  { name: '초록 칸의 숫자', digits: ['4', '', '', '', '', '7'], green: 0, paths: [[1.52, .75, 2.48, .25]] },
  { name: '초록 칸까지 연결', digits: ['', '6', '', '', '', ''], green: 5, paths: [[1.5, 2.5, 2.5, 2.5]] },
  { name: '대각선 배치', digits: ['', '', '8', '3', '', ''], green: 3, paths: [[.5, .5, 1.5, .5]] },
  { name: '짧은 세로선', digits: ['', '', '', '', '2', ''], green: 2, paths: [[2.5, .21, 2.5, .79]] },
  { name: '짧은 가로선', digits: ['', '', '', '9', '', ''], green: 1, paths: [[2.2, 2.5, 2.8, 2.5]] },
  { name: '왼쪽 모서리 경로', digits: ['', '', '7', '5', '', ''], green: 2, paths: [[.5, .5, 1.5, .5], [1.5, .5, 1.5, .77]] },
];

const percent = value => `${100 * value / 3}%`;
const position = (x, y) => `left:${percent(x)};top:${percent(y)}`;

function pathStyle([x, y, endX, endY]) {
  const dx = endX - x;
  const dy = endY - y;
  return `${position(x, y)};width:${percent(Math.hypot(dx, dy))};--angle:${Math.atan2(dy, dx)}rad`;
}
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>보드카 퍼즐 로고 시안</title>
    <link rel="stylesheet" href="/css/common.css?v=31" />
    <link href="https://fonts.googleapis.com/css2?family=Noto+Sans+KR:wght@400;500;700&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main id="logo-sheet">
      <h1>보드카 퍼즐 로고 시안</h1>
      <div class="designs">
        {designs.map(({ name, digits, green, paths }, index) => (
          <figure>
            <div class="icon" aria-hidden="true">
              <div class="pattern">
                {digits.map((digit, cellIndex) => (
                  <Fragment>
                    {cellIndex === 3 && <div class="wordmark" lang="en">vodka</div>}
                    <div class:list={['paint-grid-cell', 'cell', {
                      correct: cellIndex === green,
                      divider: cellIndex % 3 !== 2,
                    }]}>
                      {digit && <span class="digit">{digit}</span>}
                    </div>
                  </Fragment>
                ))}
                {paths.map(path => <span class="path" style={pathStyle(path)} />)}
              </div>
            </div>
            <figcaption>{index + 1}. {name}</figcaption>
          </figure>
        ))}
      </div>
    </main>
  </body>
</html>

<style>
  body {
    background: #fff;
    color: #222;
    font-family: 'Noto Sans KR', sans-serif;
  }
  main {
    width: min(100%, 840px);
    margin: 0 auto;
    padding: clamp(14px, 5vw, 46px);
  }
  h1 {
    margin: 0 0 clamp(18px, 4vw, 32px);
    font-size: clamp(17px, 3vw, 24px);
    font-weight: 500;
  }
  .designs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(10px, 4vw, 32px);
  }
  figure { min-width: 0; container-type: inline-size; }
  figcaption {
    margin-top: 8px;
    color: #555;
    font-size: clamp(9px, 1.65vw, 14px);
    text-align: center;
  }
  .icon {
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    background: #fff;
    border: 1px solid #e8e5df;
    border-radius: 14cqw;
  }
  .pattern {
    --edge: #555;
    --grid: #bbb;
    --blue: #4a6fa5;
    --line: max(1px, .85cqw);
    position: relative;
    display: grid;
    grid-template: repeat(3, minmax(0, 1fr)) / repeat(3, minmax(0, 1fr));
    width: 76cqw;
    aspect-ratio: 1;
    box-shadow: 0 0 0 var(--line) var(--edge);
    font-variant-numeric: tabular-nums;
  }
  .wordmark {
    grid-column: 1 / -1;
    display: grid;
    place-items: center;
    border-block: var(--line) solid var(--edge);
    font-size: 16cqw;
    font-weight: 400;
    line-height: 1;
  }
  .cell {
    aspect-ratio: auto;
    min-width: 0;
    cursor: inherit;
    border: 0;
    font-size: 16cqw;
    font-weight: 500;
    line-height: 1;
  }
  .cell.divider { box-shadow: inset -1px 0 0 var(--grid); }
  .digit { position: relative; z-index: 2; }
  .path {
    position: absolute;
    z-index: 1;
    height: max(1.5px, 1.7cqw);
    border-radius: 999px;
    background: var(--blue);
    transform: translateY(-50%) rotate(var(--angle));
    transform-origin: left center;
  }
</style>
