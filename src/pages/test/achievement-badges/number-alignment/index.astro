---
import PageLayout from '../../../../layouts/PageLayout.astro';
import NicknameBadge from '../../../../components/NicknameBadge.astro';
import number from '../../../../../public/icons/achievement-preview/number-123.svg?raw';
const icons=[['number-123','숫자'],['star','별'],['temperature','온도계'],['calculator','계산기'],['moon','달'],['pencil','연필']];
---
<PageLayout title="아이콘 공통 정렬 비교" subtitle="실제 글자 높이와 SVG 그림 영역을 기준으로 자동 정렬">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="comparison" aria-label="공통 아이콘 정렬 비교">
    <p class="intro">모든 아이콘의 기존 크기를 유지하고, 글자와 그림의 중심만 맞췄습니다. 숫자만을 위한 위치 보정은 없습니다.</p>
    <div class="cards">
      <article><h2>기존</h2><p>아이콘 박스끼리 중앙 정렬</p>{[12,14,16].map(size=><div class="sample" style={`font-size:${size}px`}><span class="old-name">퍼즐러 <span class="old-badge" aria-hidden="true"><Fragment set:html={number}/></span></span><span class="size">{size}px</span></div>)}</article>
      <article><h2>공통 정렬</h2><p>실제 글자와 그림 영역으로 계산</p>{[12,14,16].map(size=><div class="sample" style={`font-size:${size}px`}><NicknameBadge icon="number-123"/><span class="size">{size}px</span></div>)}</article>
    </div>
    <h2 class="section-title">아이콘별 비교</h2>
    <div class="ranking">{icons.map(([icon,label],i)=><div class="row"><span class="rank">{i+1}</span><NicknameBadge name="숫자산책" icon={icon} label={label}/><span class="description">{label}</span></div>)}</div>
    <h2 class="section-title">글꼴·닉네임이 달라져도 같은 기준</h2>
    <div class="ranking">{[['퍼즐러','inherit'],['Puzzle123','inherit'],['별헤는밤','serif'],['Puzzle123','monospace']].map(([name,font])=><div class="row" style={`font-family:${font}`}><NicknameBadge name={name} icon="number-123"/><NicknameBadge name={name} icon="star"/></div>)}</div>
    <p class="caption">모든 아이콘은 같은 18px 영역 안에서 원래 비율과 크기를 유지합니다.<br /><a href="/test/achievement-badges/math-icons-more/">전체 후보에서 보기</a></p>
  </section>
</PageLayout>
<style>
.comparison{width:100%;color:#444}.intro{margin:0 0 18px;font-size:.75rem;line-height:1.8;color:#888}
.cards{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
article{padding:20px 12px;border:1px solid #e8e5df;border-radius:4px}
h2{margin:0;font-size:.84rem;font-weight:500}article p{margin:8px 0 24px;font-size:.62rem;color:#999;line-height:1.7}
.sample{display:flex;align-items:center;gap:4px;margin:22px 0;line-height:1.5;white-space:nowrap}
.old-name{display:inline-flex;align-items:center;gap:4px}.old-badge{display:block;width:18px;height:18px}.old-badge :global(svg){display:block;width:100%;height:100%}
.size{margin-left:auto;font-size:10px;color:#aaa}.section-title{margin:28px 0 12px}.row{display:flex;align-items:center;gap:14px;padding:14px 8px;border-bottom:1px solid #eee;font-size:.84rem;line-height:1.5}
.rank{font-size:.72rem;color:#aaa;width:14px;text-align:center}.description{margin-left:auto;font-size:.65rem;color:#aaa}
.caption{font-size:.68rem;color:#999;line-height:1.8;margin-top:20px}.caption a{color:inherit}
@media(max-width:360px){article{padding:18px 8px}.size{display:none}}
</style>
