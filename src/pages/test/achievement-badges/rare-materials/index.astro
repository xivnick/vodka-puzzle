---
import PageLayout from '../../../../layouts/PageLayout.astro';
import Badge from '../../../../components/BadgeMaterialPreview.astro';
const effects=[
  ['current-single','전류 · 한 줄','순백색의 짧은 빛이 선을 따라 순환.'],
  ['digital','디지털 노이즈','작은 흰색 픽셀의 투명도가 제각각 변화.'],
  ['ribbon','빛의 띠','빠르게 한 번 지나가는 광택.'],
  ['foil','포일','작은 삼각 면들이 다른 각도로 빛을 받는 질감.'],
  ['lenticular','렌티큘러','촘촘한 세로 결의 흰색 광택이 교대로 나타남.'],
  ['weave','직조광','교차하는 실의 광택이 번갈아 드러남.'],
  ['halftone','망점','고정된 흰색 입자가 촘촘하게 밝아졌다 사라짐.'],
  ['interference','간섭광','곡선 무늬의 흰색 광택이 물결처럼 밝아짐.'],
];
const palettes=[['berry','베리 소다','#BB6B98','#527BC0'],['gold','금빛','#A99231','#C57543'],['sea','바다','#368B91','#79A9C8'],['petal','꽃잎','#CF91B2','#674B8D'],['mint','민트','#42977D','#578761'],['ink','먹색','#485360','#727C8B']];
const icons=[['star','별'],['flower','꽃'],['flame','불꽃'],['trophy','트로피'],['medal','메달'],['puzzle','퍼즐'],['plant','새싹'],['bolt','번개'],['moon','달'],['diamond','다이아몬드'],['crown','왕관'],['rosette','로제트']];
const names=['네모왕','소금빵','퍼즐러','모눈종이','연필한자루','숫자산책','초록','빈칸수집가','달빛산책','번뜩','유리구슬','꾸준한오후','조각모음','민트초코','불씨','별헤는밤','라일락','종이비행기','귤한조각','베리소다','새벽달','한칸더','오로라','봄바람','잔별','꽃갈피','해질녘','복숭아','숲속산책','파란수첩'];

const files=import.meta.glob('../../../../../public/icons/achievement-preview/*.svg',{query:'?raw',import:'default',eager:true});
const geometry=(id)=>String(files[`../../../../../public/icons/achievement-preview/${id}.svg`]).match(/<svg\b[^>]*>([\s\S]*?)<\/svg>/)?.[1]?.replace(/<(path|circle|rect|ellipse|line|polyline|polygon)\b/g,'<$1 pathLength="100"')??'';
---
<PageLayout title="레어 재질 비교" subtitle="전류 · 디지털 노이즈 · 빛의 띠 + 새 시안 5종">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="material-preview" style="--tone-a:#BB6B98;--tone-b:#527BC0" aria-label="레어 재질 비교">
    {icons.map(([id])=><template data-icon-template={id}><svg viewBox="0 0 24 24"><Fragment set:html={geometry(id)}/></svg></template>)}
    <p class="intro">기본 두 색은 고정하고, 흰색 레이어의 투명도로만 효과를 냈습니다.<br />확대 예시와 이름 옆 실제 크기(18px)를 함께 비교해보세요.</p>
    <div class="section-heading">비교할 아이콘 <span>확대 36px · 이름 뒤 18px</span></div>
    <div class="icon-picker">{icons.map(([id,label],i)=><button type="button" data-icon-choice={id} title={label} aria-label={label} aria-pressed={i===0?'true':'false'}><span class="picker-icon" style={`mask-image:url('/icons/achievement-preview/${id}.svg');-webkit-mask-image:url('/icons/achievement-preview/${id}.svg')`}/></button>)}</div>
    <div class="palette-picker" aria-label="비교 색 선택">{palettes.map(([id,label,a,b],i)=><button type="button" data-palette={id} data-a={a} data-b={b} aria-pressed={i===0?'true':'false'}><i style={`background:linear-gradient(135deg,${a},${b})`}/>{label}</button>)}</div>
    <div class="playback"><span>색 선택은 위 비교표에 적용됩니다.</span><button id="pauseMaterials" type="button" aria-pressed="false">일시정지</button></div>
    <div class="effect-grid">{effects.map(([effect,label,description],i)=><article class="effect-card">
      <Badge effect={effect} id={`card-${i}-big`} large active/>
      <span class="sample-name">퍼즐러 <Badge effect={effect} id={`card-${i}-name`} active/></span>
      <div class="mini-icons">{['flower','flame','crown'].map((icon,j)=><Badge icon={icon} effect={effect} id={`card-${i}-mini-${j}`}/>)}</div>
      <h2>{label}</h2><p>{description}</p>
    </article>)}</div>
    <div class="section-heading ranking-heading">가상 랭킹 (30) <span>8개 시안 · 6가지 색</span></div>
    <div class="lb-list">{names.map((name,i)=>{const effect=effects[i%effects.length];const palette=palettes[(i*5+Math.floor(i/effects.length))%6];return <div class:list={['lb-row',{'lb-me':i===2}]}>
      <span class="lb-rank">{i+1}</span><span class="lb-name rank-name"><span>{name}</span><span class="rank-badge" style={`--tone-a:${palette[2]};--tone-b:${palette[3]}`}><Badge icon={icons[i*5%12][0]} effect={effect[0]} id={`rank-${i}`} label={`${effect[1]} · ${palette[1]}`}/></span></span><span class="effect-label">{effect[1]}</span><span class="lb-time">{90-i*3}개</span>
    </div>})}</div>
    <p class="caption">닉네임과 기록은 예시입니다.</p>
    <p class="credit"><a href="/test/achievement-badges/rare-effects/">이전 10종 비교</a> · <a href="https://tabler.io/icons">Tabler Icons</a> · <a href="/icons/achievement-preview/LICENSE">MIT</a></p>
  </section>
</PageLayout>
<script>import '../../../../scripts/achievement-materials.js';</script>
<style is:global>
  .material-preview { width:100%; }
  .material-preview .intro { margin:0 0 22px; color:#888; font-size:.78rem; line-height:1.8; }
  .material-preview .section-heading { display:flex; justify-content:space-between; gap:8px; margin-bottom:10px; font-size:.78rem; color:#555; }
  .material-preview .section-heading > span { color:#999; font-size:.64rem; }
  .material-preview .icon-picker { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:4px; margin-bottom:12px; }
  .material-preview button { border:1px solid #e8e5df; border-radius:4px; background:white; color:#888; cursor:pointer; }
  .material-preview .icon-picker button { display:flex; align-items:center; justify-content:center; height:34px; padding:0; }
  .material-preview button[aria-pressed="true"] { background:#eee9e1; border-color:#b8b1a6; color:#555; }
  .material-preview .palette-picker { display:flex; flex-wrap:wrap; gap:5px; }
  .material-preview .palette-picker button { display:flex; align-items:center; gap:5px; padding:6px 8px; font-size:.68rem; }
  .material-preview .palette-picker i { width:12px; height:12px; border-radius:50%; }
  .material-preview .playback { display:flex; align-items:center; justify-content:space-between; margin:14px 0 18px; color:#999; font-size:.68rem; }
  .material-preview .playback button { padding:5px 10px; font-size:.68rem; }
  .material-preview .effect-grid { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:8px; }
  .material-preview .effect-card { display:flex; flex-direction:column; align-items:center; gap:14px; min-width:0; padding:20px 8px 14px; border:1px solid #e8e5df; border-radius:4px; }
  .material-preview .sample-name { display:flex; align-items:center; gap:4px; font-size:.84rem; color:#333; }
  .material-preview .mini-icons { display:flex; gap:14px; }
  .material-preview h2 { margin:2px 0 -8px; font-size:.79rem; font-weight:500; color:#555; }
  .material-preview .effect-card p { margin:0; color:#999; font-size:.65rem; line-height:1.6; text-align:center; word-break:keep-all; }
  .material-preview .ranking-heading { margin-top:30px; }
  .material-preview .rank-name { display:flex; align-items:center; gap:4px; min-width:0; }
  .material-preview .rank-name > span:first-child { overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .material-preview .effect-label { color:#aaa; font-size:.63rem; flex-shrink:0; }
  .material-preview .caption { margin-top:14px; color:#999; font-size:.7rem; line-height:1.8; }
  .material-preview .credit { color:#aaa; font-size:.65rem; line-height:1.8; }
  .material-preview .credit a { color:inherit; }

  .material-preview .picker-icon { width:18px;height:18px;background:#727c8b;mask-size:contain;mask-repeat:no-repeat;-webkit-mask-size:contain;-webkit-mask-repeat:no-repeat; }
  .material-preview .material-badge { display:inline-flex;flex:0 0 auto;width:18px;height:18px;vertical-align:middle;isolation:isolate; }
  .material-preview .material-badge.large { width:36px;height:36px; }
  .material-badge svg { display:block;width:100%;height:100%;overflow:hidden; }
  .material-preview .current-head { animation:material-current 1.6s linear infinite;opacity:1; }
  .material-preview .ribbon-light { animation:material-ribbon 1.9s linear infinite; }
  @keyframes material-ribbon { from { x:-72px; } to { x:0px; } }
  .material-preview .foil-face { animation:material-foil 2.8s ease-in-out infinite; }
  .material-preview .lenticular-slice { animation:material-lenticular 2.6s ease-in-out infinite; }
  .material-preview .weave-thread { animation:material-weave 2.8s ease-in-out infinite; }
  .material-preview .weave-cross { animation-delay:-1.4s; }
  .material-preview .halftone-wave { animation:material-halftone 2.4s ease-in-out infinite; }
  .material-preview .interference-stop { animation:material-interference 3.2s ease-in-out infinite;animation-delay:var(--phase); }
  @keyframes material-foil { 0%,100% { opacity:.08; } 35% { opacity:.8; } 65% { opacity:.3; } }
  @keyframes material-lenticular { 0%,100% { opacity:.05; } 50% { opacity:1; } }
  @keyframes material-weave { 0%,100% { opacity:.12; } 50% { opacity:.8; } }
  @keyframes material-halftone { 0%,100% { opacity:.05; } 50% { opacity:.9; } }
  @keyframes material-interference { 0%,100% { stop-opacity:0; } 50% { stop-opacity:.8; } }
  .material-preview .digital-cell-group { animation:material-pixel 2.8s ease-in-out infinite; }
  .material-preview .rank-badge { display:inline-flex; }
  @keyframes material-current { from { stroke-dashoffset:var(--trail-start,0px); } to { stroke-dashoffset:calc(var(--trail-start,0px) - 100px); } }
  @keyframes material-pixel { 0%,12%,100% { opacity:.04; } 36% { opacity:.76; } 57% { opacity:.22; } 74% { opacity:.58; } 90% { opacity:.08; } }
  .material-preview.paused .material-badge *,
  .material-preview.page-hidden .material-badge *,
  .material-preview.visibility-managed .material-badge:not(.is-visible) * { animation-play-state:paused; }
  @media(max-width:400px) { .material-preview .icon-picker { grid-template-columns:repeat(6,minmax(0,1fr)); } }
</style>
