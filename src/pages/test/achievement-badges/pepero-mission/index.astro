---
import PageLayout from '../../../../layouts/PageLayout.astro';
import NicknameBadge from '../../../../components/NicknameBadge.astro';
import icon from '../../../../../public/icons/achievement-preview/number-11.svg?raw';
import '../../../../styles/mypage-v2-preview.css';
---
<PageLayout title="빼빼로데이" subtitle="특수 도전과제 · 빼빼로 스도쿠 1개 완료">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="pepero-mission mypage-v2" aria-label="빼빼로데이 도전과제 시연">
    <div class="badge-preview"><NicknameBadge name="퍼즐러" icon="number-11" label="숫자 11" /></div>
    <div class="mission-list">{[0,1].map(count=><article class="mission-row">
      <span class="mission-icon" aria-hidden="true"><Fragment set:html={icon}/></span>
      <div class="mission-content">
        <div class="mission-title"><h3>빼빼로데이</h3><span class="mission-value">{count} / 1</span></div>
        <p class="mission-condition">『빼빼로 스도쿠』 풀기</p>
        <div class="mission-progress" role="progressbar" aria-label="빼빼로데이 진행도" aria-valuemin="0" aria-valuemax="1" aria-valuenow={count}><span style={`width:${count*100}%`}/></div>
        <div class="mission-bottom"><span class="mission-reward">숫자 11 아이콘</span><button type="button" class:list={['claim-button',{'claim-ready':count===1}]} disabled>{count?'받기':'진행 중'}</button></div>
      </div>
    </article>)}</div>
    <p class="note">미완료와 달성 시의 표시 예시입니다. 기존 완료 기록도 포함하며, 보상은 한 번만 받을 수 있습니다.</p>
    <a class="account-link" href="/nickname/">내 도전과제 보기</a>
  </section>
</PageLayout>
<style>
.pepero-mission{width:100%}.badge-preview{display:flex;justify-content:center;margin:0 0 28px;color:#555;font-size:.85rem}.note{margin:20px 0 12px;color:#999;font-size:.72rem;line-height:1.8}.account-link{font-size:.73rem;color:#75839a}.pepero-mission :global(:focus){outline:none;box-shadow:none}
</style>
