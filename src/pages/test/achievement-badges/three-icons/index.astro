---
import PageLayout from '../../../../layouts/PageLayout.astro';
const icons=[['temperature','온도계'],['calculator','계산기'],['star','별']];
const sources=import.meta.glob('../../../../../public/icons/achievement-preview/*.svg',{query:'?raw',import:'default',eager:true});
const svg=(id)=>String(sources[`../../../../../public/icons/achievement-preview/${id}.svg`]);
---
<PageLayout title="도전과제 아이콘 비교" subtitle="온도계 · 계산기 · 별">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="icon-comparison" aria-label="아이콘 세 종류 비교">
    <div class="icon-grid">{icons.map(([id,label])=><article>
      <span class="big" aria-hidden="true"><Fragment set:html={svg(id)} /></span>
      <h2>{label}</h2>
      <span class="nickname">퍼즐러 <span class="small" role="img" aria-label={label}><Fragment set:html={svg(id)} /></span></span>
    </article>)}</div>
    <p>위는 56px 확대, 이름 옆은 실제 표시 크기인 18px입니다.</p>
    <p class="credit">아이콘: <a href="https://tabler.io/icons">Tabler Icons</a> · <a href="/icons/achievement-preview/LICENSE">MIT</a></p>
  </section>
</PageLayout>
<style>
.icon-comparison{width:100%;color:#444}
.icon-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:8px}
article{display:flex;flex-direction:column;align-items:center;gap:22px;padding:30px 6px 24px;border:1px solid #e8e5df;border-radius:4px;background:white}
h2{font-size:.84rem;font-weight:500;margin:0}
.big{display:block;width:56px;height:56px}
.small{display:block;width:18px;height:18px}
.big :global(svg),.small :global(svg){display:block;width:100%;height:100%}
.nickname{display:flex;align-items:center;gap:4px;font-size:.8rem;white-space:nowrap}
p{margin:18px 0 0;font-size:.71rem;line-height:1.8;color:#999}
.credit{font-size:.63rem;margin-top:10px}.credit a{color:inherit}
</style>
