---
import PageLayout from '../../../../layouts/PageLayout.astro';
import NicknameBadge from '../../../../components/NicknameBadge.astro';
import data from '../../../../data/mypage-v2-preview.json';
import '../../../../styles/mypage-v2-preview.css';
import '../../../../styles/nickname-badge-effects.css';
---
<PageLayout title="확정 효과 확인">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="mypage-v2 effects-check">
    <div class="view-heading"><h2>효과 5종</h2><button type="button" id="pauseEffects" aria-pressed="false">일시정지</button></div>
    <div class="effect-examples">{data.effects.map((effect,index)=><section class="effect-example"><h3>{effect.name}</h3><div class="live-effect" data-effect={effect.id} data-icon="star"><NicknameBadge name="퍼즐러" icon="star" size={18}/></div><div class="live-effect large" data-effect={effect.id} data-icon="star"><NicknameBadge name="" icon="star" size={36}/></div></section>)}</div>
    <div class="view-heading stress-heading"><h2>여러 개 표시</h2><div class="counts">{[30,100].map((count,index)=><button type="button" data-count={count} aria-pressed={index===0?'true':'false'}>{count}개</button>)}</div></div>
    <p class="activity" id="activeEffectCount" aria-live="polite"></p>
    <div class="stress-list" id="effectStressList"></div>
    <p class="reference"><a href="/test/achievement-badges/selected-effects/">확정 당시 시안</a> · <a href="/test/mypage-v2/customize/">꾸미기</a></p>
  </div>
</PageLayout>
<script>
import {createBadgeEffect} from '../../../../scripts/nickname-badge-effects.js';
const root=document.querySelector('.effects-check');
if(root){
  const types=['ribbon','foil','interference','lenticular','afterglow'];
  const status=document.querySelector('#activeEffectCount');
  const paused=()=>root.classList.contains('effects-paused')||document.hidden||matchMedia('(prefers-reduced-motion: reduce)').matches;
  function report(){const all=[...root.querySelectorAll('.custom-badge-effect')],active=paused()?0:all.filter(e=>!e.classList.contains('is-offscreen')).length;status.textContent=`화면 안에서 동작 중 ${active}개 · 전체 ${all.length}개`;}
  const visibility=new IntersectionObserver(entries=>{for(const entry of entries)entry.target.classList.toggle('is-offscreen',!entry.isIntersecting);report();});
  function paint(visual,effect,icon){
    const mask=`url('/icons/achievement-preview/${icon}.svg')`,base=document.createElement('span');
    base.className='custom-badge-base';base.style.background='linear-gradient(135deg,#BB6B98,#527BC0)';base.style.maskImage=mask;base.style.webkitMaskImage=mask;
    const overlay=createBadgeEffect(effect);overlay.style.maskImage=mask;overlay.style.webkitMaskImage=mask;
    visual.append(base,overlay);visibility.observe(overlay);
  }
  root.querySelectorAll('.live-effect').forEach(sample=>{const visual=sample.querySelector('.badge-visual');visual.querySelector('svg').style.opacity='0';paint(visual,sample.dataset.effect,sample.dataset.icon);});
  function showCount(count){
    const list=document.querySelector('#effectStressList');list.querySelectorAll('.custom-badge-effect').forEach(e=>visibility.unobserve(e));list.replaceChildren();
    for(let index=0;index<count;index++){
      const row=document.createElement('div'),name=document.createElement('span'),visual=document.createElement('span');
      row.className='stress-row';name.textContent=`퍼즐러 ${index+1}`;visual.className='stress-visual';row.append(name,visual);list.append(row);paint(visual,types[index%5],'star');
    }
    root.querySelectorAll('[data-count]').forEach(button=>button.setAttribute('aria-pressed',String(Number(button.dataset.count)===count)));report();
  }
  root.querySelectorAll('[data-count]').forEach(button=>button.addEventListener('click',()=>showCount(Number(button.dataset.count))));
  document.querySelector('#pauseEffects').addEventListener('click',event=>{const paused=root.classList.toggle('effects-paused');event.currentTarget.setAttribute('aria-pressed',String(paused));event.currentTarget.textContent=paused?'재생':'일시정지';report();});
  const updateVisibility=()=>{root.classList.toggle('page-hidden',document.hidden);report();};document.addEventListener('visibilitychange',updateVisibility);updateVisibility();showCount(30);
}
</script>
<style>
.effects-check button{border:0;background:none;padding:4px 0;color:#999;font-size:.7rem;text-decoration:underline;text-underline-offset:3px}
.effect-examples{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:20px 16px;border-top:1px solid #e8e5df;padding-top:18px}
.effects-check .effect-example h3{font-size:.8rem;font-weight:500;margin-bottom:14px}.live-effect{font-size:.84rem}.live-effect.large{margin-top:16px}.effect-example{padding-bottom:18px;border-bottom:1px solid #e8e5df}
.effects-check .stress-heading{margin-top:32px}.counts{display:flex;gap:14px}.counts [aria-pressed=true]{color:#444}.effects-check .activity{font-size:.7rem;color:#999;margin:10px 0 16px}
.stress-list{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:18px 12px}.stress-row{display:flex;align-items:center;gap:5px;font-size:.72rem;white-space:nowrap}.stress-visual{position:relative;display:block;flex-shrink:0;width:18px;height:18px}
.effects-check .reference{font-size:.7rem;margin-top:24px}
</style>
