---
import PageLayout from '../../../../layouts/PageLayout.astro';
import NicknameBadge from '../../../../components/NicknameBadge.astro';
const candidates=[
 ['history','되돌아가는 시계','현재 타임머신 메뉴와 같은 모양'],
 ['hourglass','모래시계','시간을 상징하는 간결한 모양'],
 ['clock-bolt','시계와 번개','시간을 뛰어넘는 느낌'],
 ['calendar-time','달력과 시계','과거 날짜로 이동하는 기능과 연결'],
 ['rocket','로켓','시간 여행자의 여행을 강조'],
];
const files=import.meta.glob('../../../../../public/icons/achievement-preview/*.svg',{query:'?raw',import:'default',eager:true});
---
<PageLayout title="시간 여행자">
  <meta slot="head" name="robots" content="noindex, nofollow"/>
  <section class="time-traveler-icons">
    <p class="mission-condition">타임머신 3회 이용 · 아이콘 1회 지급</p>
    <div class="candidates">{candidates.map(([icon,name,note],index)=><article>
      <div class="candidate-heading"><span class="candidate-icon" aria-hidden="true"><Fragment set:html={String(files[`../../../../../public/icons/achievement-preview/${icon}.svg`])}/></span><div><h2>{index+1}. {name}{icon==='clock-bolt'&&<span class="selected">확정</span>}</h2><p>{note}</p></div></div>
      <div class="nickname-example"><NicknameBadge name="퍼즐러" icon={icon} size={18}/></div>
    </article>)}</div>
    <p class="record-note">이용 기록이 남은 날짜를 셉니다. 같은 날짜에 다시 들어가도 횟수는 늘지 않습니다.</p>
    <p class="links"><a href="/test/mypage-v2/">마이페이지</a> · <a href="/test/achievement-badges/mission-overview/">전체 미션 기준</a></p>
    <p class="credits"><a href="https://github.com/tabler/tabler-icons/tree/v3.40.0/icons/outline">Tabler Icons</a> · <a href="/icons/achievement-preview/LICENSE">MIT</a></p>
  </section>
</PageLayout>
<style is:global>
.time-traveler-icons{width:100%;color:#555}.time-traveler-icons .mission-condition{font-size:.76rem;color:#888;margin:0 0 18px}
.time-traveler-icons .candidates{border-top:1px solid #e8e5df}
.time-traveler-icons article{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:22px 12px;border-bottom:1px solid #eee}
.time-traveler-icons .candidate-heading{display:flex;align-items:center;gap:14px;min-width:0}.time-traveler-icons .candidate-icon{display:block;width:36px;height:36px;flex-shrink:0;color:#666}.time-traveler-icons .candidate-icon svg{display:block;width:100%;height:100%}
.time-traveler-icons h2{font-size:.78rem;font-weight:400;margin:0}.time-traveler-icons .candidate-heading p{font-size:.65rem;color:#999;margin:6px 0 0;line-height:1.6}.time-traveler-icons .nickname-example{font-size:.8rem;color:#666;flex-shrink:0}
.time-traveler-icons .record-note{font-size:.7rem;color:#999;line-height:1.8;margin:20px 0}.time-traveler-icons .links{font-size:.7rem;margin:18px 0}.time-traveler-icons .credits{font-size:.6rem;color:#aaa}
@media(max-width:380px){.time-traveler-icons article{padding-inline:0;gap:8px}.time-traveler-icons .candidate-heading{gap:10px}}
</style>

<style>.selected{margin-left:8px;color:#888;font-size:.65rem}</style>
