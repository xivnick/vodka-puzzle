---
import PageLayout from '../../../layouts/PageLayout.astro';
import '../../../styles/account-controls.css';
import '../../../styles/site-text-link.css';

const options = [
  { id: 'daily', name: '데일리 스도쿠 알림', detail: '매일 자정에 알려드립니다.' },
  { id: 'new-puzzle', name: '새 문제 알림', detail: '새 문제 공개 시 알려드립니다.' },
  { id: 'daily-reminder', name: '데일리 스도쿠 미완료 알림', detail: '오늘 스도쿠를 아직 풀지 않았다면 오후 11시에 알려드립니다.' },
];

const environments = [
  { id: 'iphone-browser', name: '아이폰 브라우저', blocker: '홈 화면에 추가한 페이지에서 알림을 받을 수 있습니다.' },
  { id: 'iphone-app', name: '아이폰 홈 화면 앱' },
  { id: 'android', name: '안드로이드 Chrome' },
  { id: 'desktop', name: '컴퓨터' },
  { id: 'blocked', name: '알림 권한 차단', blocker: '브라우저나 기기 설정에서 알림을 허용해 주세요.' },
  { id: 'unsupported', name: '미지원 브라우저', blocker: '알림을 지원하는 브라우저에서 다시 열어 주세요.' },
];
const previewPath = '/test/notification-settings/';
---
<PageLayout title="알림 설정" subtitle="이 기기에서 받을 알림을 설정합니다.">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow" />
    <link rel="manifest" href={`${previewPath}manifest.json`} />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/vodka-puzzle-icon-180.png?v=2" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/vodka-puzzle-icon-192.png?v=2" />
  </Fragment>
  <div class="notification-settings">
    <section class="device-settings" aria-label="이 기기의 알림">
      <div class="setting-row device-toggle">
        <div>
          <label class="setting-name" for="device-notifications">이 기기에서 알림 받기</label>
          <p id="notification-message" role="alert"></p>
          <a id="notification-install-guide" class="site-text-link" href="/home-screen-guide/" hidden>홈 화면에 추가하기</a>
          <a id="notification-test-login" class="site-text-link" href={`/nickname/?${new URLSearchParams({ next: previewPath })}`} hidden>관리자 계정으로 로그인</a>
        </div>
        <input id="device-notifications" class="switch" type="checkbox" role="switch" aria-describedby="notification-message" />
      </div>
      <div class="setting-row">
        <div>
          <p class="setting-name">알림 테스트</p>
          <p class="setting-detail">이 기기로 시험 알림을 보냅니다.</p>
        </div>
        <button id="test-notification" class="account-button" type="button" disabled>시험 발송</button>
      </div>
    </section>

    <fieldset id="notification-types" disabled>
      <legend>받을 알림</legend>
      {options.map(({ id, name, detail }) => (
        <label class="setting-row">
          <span>
            <span id={`${id}-label`} class="setting-name">{name}</span>
            <span id={`${id}-detail`} class="setting-detail">{detail}</span>
          </span>
          <input class="switch" type="checkbox" role="switch"
            aria-labelledby={`${id}-label`} aria-describedby={`${id}-detail`} />
        </label>
      ))}
      <p class="timezone">시간은 한국 기준입니다.</p>
    </fieldset>

    <div class="settings-footer">
      <a class="site-text-link" href="/nickname/">마이페이지</a>
      <details class="environment-preview">
        <summary>다른 환경 미리보기</summary>
        <label for="notification-environment">환경을 고른 뒤 위에서 알림을 켜 보세요.</label>
        <select id="notification-environment">
          <option value="">현재 환경</option>
          {environments.map(({ id, name, blocker }) => (
            <option id={id} value={id} data-blocker={blocker}>{name}</option>
          ))}
        </select>
      </details>
      <section class="environment-copy" aria-labelledby="environment-copy-title">
        <h2 id="environment-copy-title">알림을 켤 수 없을 때</h2>
        <ul>
          {environments.filter(({ blocker }) => blocker).map(({ name, blocker }) => <li><strong>{name}</strong> {blocker}</li>)}
        </ul>
      </section>
    </div>
  </div>
</PageLayout>

<script>
  import { invokePushTest, preparePushTest } from '../../../lib/push-test.js';

  const device = document.querySelector<HTMLInputElement>('#device-notifications');
  const types = document.querySelector<HTMLFieldSetElement>('#notification-types');
  const send = document.querySelector<HTMLButtonElement>('#test-notification');
  const message = document.getElementById('notification-message');
  const installGuide = document.getElementById('notification-install-guide');
  const login = document.getElementById('notification-test-login');
  const environment = document.querySelector<HTMLSelectElement>('#notification-environment');

  function currentEnvironment() {
    const appleMobile = /iPhone|iPad|iPod/.test(navigator.userAgent) ||
      (navigator.platform === 'MacIntel' && navigator.maxTouchPoints > 1);
    const standalone = ('standalone' in navigator && navigator.standalone === true) ||
      matchMedia('(display-mode: standalone)').matches;
    if (appleMobile && !standalone) return 'iphone-browser';
    if (!(window.isSecureContext && 'serviceWorker' in navigator && 'PushManager' in window && 'Notification' in window)) {
      return 'unsupported';
    }
    return Notification.permission === 'denied' ? 'blocked' : 'available';
  }

  if (device && types && send && message && installGuide && login && environment) {
    let push: Awaited<ReturnType<typeof preparePushTest>> | undefined;
    let subscription: PushSubscription | null = null;
    let needsLogin = false;
    let busy = false;
    let setupMessage = '알림을 준비하고 있습니다. 잠시 후 다시 시도해 주세요.';

    const updateControls = () => {
      device.disabled = environment.disabled = busy;
      types.disabled = send.disabled = busy || !device.checked;
      send.textContent = environment.value ? '시험 발송 미리보기' : '시험 발송';
    };
    const showNotice = (text = '', mode = '') => {
      message.textContent = text;
      installGuide.hidden = mode !== 'iphone-browser';
      login.hidden = mode !== 'login';
    };
    const blockerFor = (mode: string) => environment.options.namedItem(mode)?.dataset.blocker;

    const initialize = async () => {
      await window.puzzleAuthReady;
      if (currentEnvironment() !== 'available') return;
      needsLogin = !window.puzzleAccount.user;
      if (needsLogin) {
        setupMessage = '시험 알림을 보내려면 관리자 계정으로 로그인해 주세요.';
        return;
      }
      try {
        const ready = await preparePushTest('/test/notification-settings/');
        subscription = await ready.registration.pushManager.getSubscription();
        push = ready;
        if (!environment.value) {
          device.checked = !!subscription;
          showNotice();
          updateControls();
        }
      } catch (error) {
        setupMessage = error instanceof Error && error.message === 'ADMIN_REQUIRED'
          ? '시험 발송은 관리자 계정에서 사용할 수 있습니다.'
          : '알림을 준비하지 못했습니다. 새로고침 후 다시 시도해 주세요.';
      }
    };

    device.addEventListener('change', async () => {
      const mode = environment.value || currentEnvironment();
      const blocker = device.checked ? blockerFor(mode) : undefined;
      if (blocker) {
        device.checked = false;
        showNotice(blocker, mode);
        updateControls();
        return;
      }
      showNotice();
      if (environment.value) {
        updateControls();
        return;
      }
      if (!push) {
        device.checked = false;
        showNotice(setupMessage, needsLogin ? 'login' : '');
        updateControls();
        return;
      }
      busy = true;
      updateControls();
      try {
        if (device.checked) {
          subscription = await push.registration.pushManager.subscribe({
            userVisibleOnly: true, applicationServerKey: push.applicationServerKey,
          });
        } else {
          await subscription?.unsubscribe();
          subscription = await push.registration.pushManager.getSubscription();
          if (subscription) showNotice('알림을 끄지 못했습니다. 다시 시도해 주세요.');
        }
      } catch {
        showNotice(blockerFor(currentEnvironment()) ?? '알림 설정을 변경하지 못했습니다. 다시 시도해 주세요.');
      } finally {
        device.checked = !!subscription;
        busy = false;
        updateControls();
      }
    });
    environment.addEventListener('change', () => {
      device.checked = !environment.value && !!subscription;
      showNotice();
      updateControls();
    });
    send.addEventListener('click', async () => {
      if (environment.value) {
        window.showToast('보드카 퍼즐 시험 알림 미리보기입니다.');
        return;
      }
      if (!subscription) return;
      busy = true;
      updateControls();
      try {
        await invokePushTest('send', subscription);
        window.showToast('시험 알림을 접수했습니다. 이 기기의 알림을 확인해 주세요.');
      } catch (error) {
        window.showToast(error instanceof Error && error.message === 'SUBSCRIPTION_EXPIRED'
          ? '구독이 만료되었습니다. 알림을 껐다가 다시 켜 주세요.'
          : '시험 발송에 실패했습니다. 다시 시도해 주세요.');
      } finally {
        busy = false;
        updateControls();
      }
    });
    updateControls();
    void initialize();
  }
</script>

<style>
  .notification-settings { width: 100%; color: #555; }
  .device-settings { border-top: 1px solid #e8e5df; }
  .setting-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 0;
    border-bottom: 1px solid #e8e5df;
  }
  .setting-name, .setting-detail { display: block; line-height: 1.6; }
  .setting-name { color: #333; font-size: .86rem; }
  .setting-detail { margin-top: 4px; color: #777; font-size: .75rem; }
  .device-toggle { align-items: flex-start; }
  #notification-message:not(:empty) { margin-top: 4px; color: #777; font-size: .75rem; line-height: 1.6; }
  .device-toggle a:not([hidden]) { display: inline-block; margin-top: 4px; }
  fieldset { min-width: 0; margin: 28px 0 0; border: 0; }
  legend { padding: 0 0 6px; color: #555; font-size: .85rem; font-weight: 500; }
  .timezone { margin-top: 8px; color: #777; font-size: .72rem; }
  .account-button { flex-shrink: 0; min-height: 36px; padding: 0 10px; font-size: .75rem; }
  .switch {
    appearance: none;
    flex: 0 0 36px;
    width: 36px;
    height: 22px;
    display: grid;
    align-items: center;
    padding: 3px;
    border: 0;
    border-radius: 11px;
    background: #ccc8c0;
    cursor: pointer;
  }
  .switch::after {
    content: '';
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: #fff;
  }
  .switch:checked { background: #5b8c64; }
  .switch:checked::after { transform: translateX(14px); }
  .switch:disabled { opacity: .45; cursor: default; }
  .settings-footer {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
    margin-top: 26px;
    color: #777;
    font-size: .72rem;
    line-height: 1.6;
  }
  .environment-preview summary { cursor: pointer; }
  .environment-preview label { display: block; margin: 6px 0 4px; }
  .environment-preview select { max-width: 100%; padding: 5px; font: inherit; color: #555; }
  .environment-copy { margin-top: 10px; }
  .environment-copy h2 { margin: 0 0 4px; color: #555; font-size: .85rem; font-weight: 500; }
  .environment-copy ul { display: grid; gap: 4px; list-style: none; }
  .environment-copy strong { margin-right: 4px; color: #555; font-weight: 500; }
</style>
