---
import PageLayout from '../../../../layouts/PageLayout.astro';
import '../../../../styles/daily-retry-ticket-preview.css';
import '../../../../styles/nickname.css';
---
<PageLayout title="타임머신" subtitle="티켓을 사용하여 지나간 문제를 풀 수 있습니다">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="time-machine-page">
    <section id="dateSelection">
      <div class="time-machine-toolbar">
        <span class="time-machine-tickets" aria-label="보유 티켓"><img src="/icons/time-machine/ticket.svg" width="18" height="18" alt="" /><span id="remainingUses">2</span></span>
        <div class="time-machine-month-nav">
          <button id="previousMonth" type="button" aria-label="이전 달"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m15 6-6 6 6 6" /></svg></button>
          <select id="calendarMonth" aria-label="달력 월 선택"></select>
          <button id="nextMonth" type="button" aria-label="다음 달"><svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg></button>
        </div>
        <button id="todayMonth" class="time-machine-today-button" type="button">오늘</button>
      </div>
      <div id="pastDates" class="time-machine-calendars"></div>
    </section>
    <section id="departure" class="time-machine-selection" aria-live="polite">
      <div class="time-machine-selection-heading"><h2 id="departureTitle">2026년 10월 11일</h2><span id="departureStatus">오늘의 문제</span></div>
      <p id="departureDescription" class="time-machine-note">티켓 없이 풀 수 있습니다.</p>
      <button id="departButton" class="use-btn" type="button">데일리 스도쿠 풀기</button>
    </section>
    <p class="time-machine-test-note">테스트 화면 · 실제 기록에는 반영되지 않습니다.</p>
  </div>
</PageLayout>
<script>import '../../../../scripts/time-machine-calendar-preview.js';</script>
