---
import PuzzleLayout from '../../../layouts/PuzzleLayout.astro';
import PuzzleCompletion from '../../../components/PuzzleCompletion.astro';
import {puzzles} from '../../../lib/thermo-sudoku.js';
export function getStaticPaths(){return puzzles.map(puzzle=>({params:{difficulty:puzzle.id},props:{puzzle}}));}
const {puzzle}=Astro.props;
const point=([r,c])=>[(c-.5)*50,(r-.5)*50];
function points(path){const coords=path.map(point);const last=coords.at(-1),prev=coords.at(-2);coords[coords.length-1]=last.map((n,i)=>n+(prev[i]-n)*.28);return coords.map(p=>p.join(',')).join(' ');}
const bulbs=[...new Map(puzzle.thermometers.map(p=>[p[0].join(','),p[0]])).values()];
---
<PuzzleLayout title={`스도쿠 (온도계) · ${puzzle.difficulty}`} puzzleId={`test-thermo-${puzzle.id}`} subtitle="온도계의 큰 원에서 끝으로 갈수록 숫자가 커져야 합니다" description="온도계의 큰 원에서 끝으로 갈수록 숫자가 커지는 스도쿠" showCloud={false} showLeaderboard={false}>
  <div slot="rules">각 가로줄, 세로줄, 3×3 영역에 1부터 9까지의 숫자가 한 번씩 들어가도록 채우세요.<br />온도계의 숫자는 중심(큰 원)에서 끝으로 갈수록 커져야 합니다. 같은 숫자는 들어갈 수 없습니다.</div>
  <div slot="controls">칸을 선택한 뒤 숫자 버튼이나 키보드의 1~9로 입력하세요. 방향키로 이동하고 Backspace·Delete·0으로 지울 수 있습니다. 메모하기 버튼이나 M키로 메모 입력을 켜고 끕니다.</div>
  <section id="thermoGame" data-difficulty={puzzle.id} aria-label={`온도계 스도쿠 ${puzzle.difficulty}`}>
    <div class="thermo-board-tools"><button id="thermoNotes" class="thermo-notes-toggle" type="button" aria-pressed="false">메모하기</button></div>
    <div class="thermo-board">
      <svg viewBox="0 0 450 450" aria-hidden="true">
        {puzzle.thermometers.map(path=><polyline points={points(path)} fill="none" stroke="#d6dde7" stroke-width="14" stroke-linecap="round" stroke-linejoin="round" />)}
        {bulbs.map(cell=>{const [cx,cy]=point(cell);return <circle cx={cx} cy={cy} r="17" fill="#d6dde7" />;})}
      </svg>
      <div id="thermoCells" role="group" aria-label="9행 9열 스도쿠">
        {puzzle.givens.flat().map((n,i)=><button type="button" class:list={['thermo-cell',{given:!!n}]} data-cell={i} tabindex={i===0?0:-1} aria-label={`${Math.floor(i/9)+1}행 ${i%9+1}열, ${n||'빈칸'}${n?', 고정 숫자':''}`}>{n||''}</button>)}
      </div>
    </div>
    <div id="thermoNumbers" class="thermo-numbers">{Array.from({length:9},(_,i)=><button type="button" data-number={i+1}>{i+1}</button>)}</div>
    <div class="bottom-buttons"><button id="thermoErase" type="button">지우기</button><button id="thermoReset" type="button" class="danger">초기화</button></div>
    <PuzzleCompletion id="thermoComplete" />
  </section>
</PuzzleLayout>
<script>import '../../../scripts/thermo-sudoku.js';</script>
<style>
[hidden]{display:none!important}#thermoGame{width:100%}.thermo-board{position:relative;width:100%;border:2px solid #555;box-sizing:border-box;background:#fff}.thermo-board svg{position:absolute;inset:0;width:100%;height:100%;pointer-events:none}#thermoCells{position:relative;display:grid;grid-template-columns:repeat(9,minmax(0,1fr))}.thermo-cell{aspect-ratio:1;border:0;border-right:1px solid #c9ced4;border-bottom:1px solid #c9ced4;border-radius:0;background:transparent;padding:0;position:relative;font-family:inherit;font-weight:700;font-size:clamp(18px,5vw,27px);color:#4a6fa5;touch-action:manipulation;line-height:1}.thermo-cell:nth-child(3n){border-right:2px solid #555}.thermo-cell:nth-child(9n){border-right:0}.thermo-cell:nth-child(n+19):nth-child(-n+27),.thermo-cell:nth-child(n+46):nth-child(-n+54){border-bottom:2px solid #555}.thermo-cell:nth-child(n+73){border-bottom:0}.thermo-cell.given{color:#333;font-weight:700}.thermo-cell.selected{background:rgba(111,155,208,.22)}.thermo-cell.conflict{color:#bc4141;background:rgba(225,133,133,.18)}.thermo-cell:focus-visible{outline:2px solid #4a6fa5;outline-offset:-3px}.thermo-cell :global(.notes){position:absolute;inset:2px;display:grid;grid-template-columns:repeat(3,1fr);grid-template-rows:repeat(3,1fr);font-size:clamp(9px,2.4vw,13px);color:#606975}.thermo-cell :global(.notes span){display:flex;align-items:center;justify-content:center}.thermo-numbers{display:grid;grid-template-columns:repeat(9,minmax(0,1fr));gap:4px;margin-top:14px}.thermo-numbers button{padding:8px 0;border:1px solid #d6d4cd;border-radius:3px;background:#faf8f4;color:#555}.thermo-board-tools{display:flex;justify-content:flex-end;margin-bottom:8px}.thermo-notes-toggle{background:none;border:0;border-bottom:1px solid #ccc;border-radius:0;padding:0 0 1px;color:#888;font-size:.82rem;line-height:1.5}.thermo-notes-toggle[aria-pressed=true]{color:#4a6fa5;border-color:#4a6fa5;font-weight:700}
</style>
