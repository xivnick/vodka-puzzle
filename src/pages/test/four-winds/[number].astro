---
import FourWinds from '../../../components/FourWinds.astro';
import { fourWindsPuzzles } from '../../../lib/four-winds.js';

export function getStaticPaths() {
  return fourWindsPuzzles.map((puzzle, index) => ({ params: { number: String(index + 1) }, props: { puzzle } }));
}

const { puzzle } = Astro.props;
---
<FourWinds puzzle={puzzle} puzzleId={`test-four-winds-${Astro.params.number}`} preview />
