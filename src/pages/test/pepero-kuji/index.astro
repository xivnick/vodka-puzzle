---
import PageLayout from '../../../layouts/PageLayout.astro';
import '../../../styles/pepero-kuji-preview.css';
---
<PageLayout title="빼빼로 쿠지">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section id="kujiPreview" class="kuji" aria-label="빼빼로 쿠지 예시">
    <div class="draw-heading"><h2>뽑기</h2><span id="ticketWallet" class="ticket-wallet" aria-label="내 남은 티켓 1장"><span id="ticketBalance">1</span><img src="/icons/time-machine/ticket.svg" width="18" height="18" alt="" /></span></div>
    <div class="draw-actions"><div id="couponGrid" class="coupon-grid" aria-label="뽑기 쿠폰"></div></div>
    <section id="drawResult" class="draw-result" aria-labelledby="resultHeading" hidden>
      <h2 id="resultHeading">뽑기 결과</h2>
      <div id="resultItem" class="result-item" role="status" aria-live="polite"></div>
    </section>
    <section aria-labelledby="prizeHeading"><div class="section-heading"><h2 id="prizeHeading">상품</h2></div><div id="prizeList"></div></section>
    <section aria-labelledby="winnerHeading"><div class="section-heading"><h2 id="winnerHeading">당첨자</h2><span id="winnerCount"></span></div><ol id="winnerList" class="winner-list"></ol></section>
    <details class="demo-tools"><summary>예시</summary><select id="demoPlayer" aria-label="참여 상태"><option value="ready">퍼즐러 · 스도쿠 완료</option><option value="locked">초코 · 스도쿠 미완료</option><option value="drawn">모카 · 뽑기 완료</option></select><button id="resetDemo" type="button">초기화</button></details>
  </section>
</PageLayout>
<script>import '../../../scripts/pepero-kuji-preview.js';</script>
