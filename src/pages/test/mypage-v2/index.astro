---
import PageLayout from '../../../layouts/PageLayout.astro';
import NicknameBadge from '../../../components/NicknameBadge.astro';
import data from '../../../data/mypage-v2-preview.json';
const files=import.meta.glob('../../../../public/icons/**/*.svg',{query:'?raw',import:'default',eager:true});
const raw=(src)=>String(files[`../../../../public${src}`]??'');
const initialOwned=new Set(['leaf','puzzle','flame','sword','rabbit']);
const goal=(m)=>m.stages.find(s=>!m.claimed.includes(s.at));
const initialReady=data.missions.filter(m=>{const s=goal(m);return s&&m.count>=s.at}).length;
---
<PageLayout title="마이페이지" subtitle="미션 · 뽑기 · 꾸미기">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <section class="mypage-v2" aria-label="마이페이지 v2 시안">
    <div class="preview-label"><span>V2 PREVIEW</span><button type="button" id="resetDemo">시안 초기화</button></div>
    <header class="profile">
      <div><span class="season">{data.season}</span><div class="profile-name" id="profileBadge"><NicknameBadge name="퍼즐러" icon="leaf" label="현재 대표 배지"/></div><button type="button" class="quiet-link" data-open-tab="dress">내 배지 꾸미기 <span aria-hidden="true">↗</span></button></div>
      <button type="button" class="balance" data-open-tab="draw" aria-label="보유 코인, 뽑기로 이동"><span class="coin-mark" aria-hidden="true">C</span><span id="coinBalance">1,240</span><small>보유 코인</small></button>
    </header>
    <div class="stats"><div><strong>22</strong><span>일반 완료</span></div><div><strong>12</strong><span>현재 데일리 연속</span></div><div><strong>3</strong><span>일반 1등</span></div></div>
    <div class="main-tabs" role="tablist" aria-label="마이페이지 메뉴">{[['missions','미션'],['draw','뽑기'],['dress','꾸미기']].map(([id,name],i)=><button type="button" id={`tab-${id}`} role="tab" aria-selected={i===0?'true':'false'} aria-controls={`panel-${id}`} tabindex={i===0?'0':'-1'} data-tab={id}>{name}{id==='missions'&&<span class="tab-count" id="readyCount">{initialReady}</span>}</button>)}</div>
    <section id="panel-missions" role="tabpanel" aria-labelledby="tab-missions">
      <div class="panel-heading"><div><h2>나의 미션</h2><p>미션을 달성하고 아이콘과 코인을 모아보세요.</p></div><span class="collection-count"><b id="ownedCount">5</b> / 18 <small>아이콘</small></span></div>
      <div class="filters" aria-label="미션 분류">{[['all','전체'],['ready','받을 수 있음'],['basic','기본'],['group','문제 묶음'],['special','특수']].map(([id,label],i)=><button type="button" data-filter={id} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div>
      <div class="mission-list">{data.missions.map(m=>{const s=goal(m);const ready=s&&m.count>=s.at;const icon=data.icons.find(i=>i.id===m.icon);return <article class:list={['mission-row',{'is-complete':!s}]} data-mission={m.id} data-group={m.group}>
        <span class="mission-icon" aria-hidden="true">{icon.src.endsWith('.svg')?<Fragment set:html={raw(icon.src)}/>:<img src={icon.src} alt="" width="28" height="28"/>}</span>
        <div class="mission-content"><div class="mission-title"><h3>{m.name}</h3><span class="mission-value">{s?`${m.count} / ${s.at}`:'완료'}</span></div><p class="mission-condition">{m.text}</p><div class="mission-progress" role="progressbar" aria-label={`${m.name} 진행도`} aria-valuemin="0" aria-valuemax={s?.at??1} aria-valuenow={Math.min(m.count,s?.at??1)}><span style={`width:${s?Math.min(m.count/s.at,1)*100:100}%`}/></div><div class="mission-bottom"><span class="mission-reward">{s?(s.kind==='coins'?`${s.value} 코인`:s.kind==='effect'?'별빛 반짝임 효과':`${data.icons.find(i=>i.id===s.value)?.name} 아이콘`):'아이콘 획득 완료'}</span><button type="button" data-claim={m.id} disabled={!ready} class:list={['claim-button',{'claim-ready':ready}]}>{ready?'받기':s?'진행 중':'획득 완료'}</button></div></div>
      </article>})}</div>
      <p id="emptyMissions" class="empty-state" hidden>지금 받을 보상은 모두 받았어요.</p>
    </section>
    <section id="panel-draw" role="tabpanel" aria-labelledby="tab-draw" hidden>
      <div class="panel-heading"><div><h2>색상과 효과 뽑기</h2><p>모은 코인으로 배지에 새로운 색을 더하세요.</p></div></div>
      <div class="draw-stage"><span class="draw-badge" aria-hidden="true"><Fragment set:html={raw('/icons/achievement-preview/rosette.svg')}/></span><span class="draw-caption">색상 & 효과 뽑기</span><h3>내 배지에 새로운 색을</h3><div class="draw-swatches" aria-hidden="true">{data.rare.slice(0,6).map(c=><i style={`background:linear-gradient(135deg,${c.a},${c.b})`}/>)}</div><p>커먼 색상 · 레어 조합 · 에픽 효과</p></div>
      <div class="draw-actions"><button type="button" data-draw="1"><strong>1회 뽑기</strong><span>100 C</span></button><button type="button" data-draw="10"><strong>10회 뽑기</strong><span>1,000 C</span></button></div>
      <div id="drawResult" class="draw-result" aria-live="polite" hidden><div class="result-heading"><h3>새로 만난 색과 효과</h3><button type="button" data-open-tab="dress">꾸미러 가기 ↗</button></div><div id="resultItems" class="result-items"></div></div>
      <details class="draw-guide"><summary>무엇을 얻을 수 있나요?</summary><ul><li>커먼: 기본 단색 36종</li><li>레어: 선정된 두 색 조합 24종</li><li>에픽: 빛의 띠·포일·간섭광·렌티큘러·잔광</li><li>언커먼은 커먼 색 3개를 조합해서 만듭니다.</li></ul></details>
      <p class="demo-note">뽑기 가격과 결과 구성은 시연용입니다. 실제 코인은 사용되지 않습니다.</p>
    </section>
    <section id="panel-dress" role="tabpanel" aria-labelledby="tab-dress" hidden>
      <div class="panel-heading"><div><h2>내 배지 꾸미기</h2><p>아이콘에 색과 효과를 조합해보세요.</p></div><button type="button" class="quiet-link" id="resetStyle">기본으로</button></div>
      <div class="dress-preview"><span class="eyebrow">랭킹에서는 이렇게 보여요</span><div class="preview-ranking"><span class="sample-rank">3</span><span id="dressBadge"><NicknameBadge name="퍼즐러" icon="leaf" label="꾸미기 미리보기"/></span><span class="sample-value">22개</span></div><p id="selectionLabel">잎사귀 · 기본색</p></div>
      <div class="wardrobe-tabs" role="tablist" aria-label="꾸미기 항목">{[['icons','아이콘'],['colors','색상'],['effects','효과']].map(([id,name],i)=><button type="button" role="tab" id={`wardrobe-tab-${id}`} aria-controls={`wardrobe-${id}`} aria-selected={i===0?'true':'false'} tabindex={i===0?'0':'-1'} data-wardrobe={id}>{name}</button>)}</div>
      <section id="wardrobe-icons" role="tabpanel" aria-labelledby="wardrobe-tab-icons"><div class="item-grid icons-grid">{data.icons.map(icon=><button type="button" class:list={['icon-item',{'locked':!initialOwned.has(icon.id)}]} data-select-icon={icon.id} disabled={!initialOwned.has(icon.id)} aria-pressed={icon.id==='leaf'?'true':'false'} title={icon.mission}><span class="item-icon" aria-hidden="true">{icon.src.endsWith('.svg')?<Fragment set:html={raw(icon.src)}/>:<img src={icon.src} alt="" width="28" height="28"/>}</span><span>{icon.name}</span><small>{initialOwned.has(icon.id)?'보유':icon.mission}</small></button>)}</div><p class="helper">아이콘은 미션을 달성해서 얻습니다.</p></section>
      <section id="wardrobe-colors" role="tabpanel" aria-labelledby="wardrobe-tab-colors" hidden><div class="color-tools"><span>내 색상</span><button type="button" id="openCraft">커먼 3개 조합하기 ↗</button></div><div id="colorInventory" class="color-inventory"></div><fieldset class="appearance-options"><legend>색 표현</legend><div>{[['gradient','그라데이션'],['split','2분할']].map(([id,label],i)=><button type="button" data-style={id} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div><div>{[['135deg','대각선'],['90deg','좌우']].map(([id,label],i)=><button type="button" data-angle={id} aria-pressed={i===0?'true':'false'}>{label}</button>)}</div></fieldset></section>
      <section id="wardrobe-effects" role="tabpanel" aria-labelledby="wardrobe-tab-effects" hidden><p id="effectHint" class="helper">효과는 언커먼·레어 색상에 적용할 수 있어요.</p><div id="effectInventory" class="effect-inventory"></div></section>
      <div class="dress-footer"><span id="saveStatus">선택한 조합을 미리보고 있어요.</span><button type="button" id="saveStyle">적용하기</button></div>
    </section>
    <div class="prototype-footer"><p>가상 기록으로 만든 마이페이지 v2 시안입니다.<br />코인 보상량·뽑기 가격·결과 구성은 예시이며, 실제 계정에 저장되지 않습니다.</p><a href="/test/achievement-badges/mission-overview/">전체 미션 기준 보기 ↗</a><p class="icon-credit">아이콘: <a href="https://tabler.io/icons">Tabler</a> · <a href="https://lucide.dev/">Lucide</a> · <a href="https://github.com/bytedance/IconPark">IconPark</a> · <a href="https://icons8.com/">Icons8</a></p></div>
    <div id="previewToast" role="status" aria-live="polite" hidden></div>
    <dialog id="craftDialog" aria-labelledby="craftTitle"><div class="dialog-heading"><h2 id="craftTitle">색 조합</h2><button type="button" id="closeCraft" aria-label="닫기">×</button></div><p>커먼 색상 3개를 골라 언커먼을 만들어보세요.</p><div id="craftSlots" class="craft-slots"></div><div id="craftChoices" class="craft-choices"></div><div class="craft-outcome"><span>결과</span><span id="craftOutcome">세 가지 색을 선택해주세요.</span></div><p class="helper">서로 다른 색이 세 가지면, 시안에서는 앞의 두 색을 사용합니다. 같은 색 세 개는 언커먼 단색이 됩니다.</p><button type="button" id="craftConfirm" disabled>조합하기</button></dialog>
    <script id="mypagePreviewData" type="application/json" set:html={JSON.stringify(data)}/>
    {data.icons.map(icon=><template data-icon-template={icon.id}>{icon.src.endsWith('.svg')?<Fragment set:html={raw(icon.src)}/>:<img src={icon.src} alt="" width="18" height="18"/>}</template>)}
  </section>
</PageLayout>
<script>import '../../../scripts/mypage-v2-preview.js';</script>
<style is:global>
.mypage-v2{width:100%;--ink:#444;--muted:#999;--line:#e8e5df;--soft:#faf8f4;color:var(--ink)}
.mypage-v2 [hidden]{display:none!important}.mypage-v2 button{font:inherit;cursor:pointer}.mypage-v2 button:disabled{cursor:default}.mypage-v2 h2,.mypage-v2 h3,.mypage-v2 p{margin:0}.mypage-v2 a{color:inherit}
.mypage-v2 .preview-label{display:flex;justify-content:space-between;align-items:center;margin-bottom:20px;font-size:.58rem;letter-spacing:.12em;color:#aaa}.preview-label button{border:0;background:none;color:#aaa;font-size:.62rem;letter-spacing:0;padding:0}
.mypage-v2 .profile{display:flex;align-items:center;justify-content:space-between;padding-bottom:22px}.mypage-v2 .season{font-size:.66rem;color:#aaa}.mypage-v2 .profile-name{font-size:1.25rem;line-height:1.6;font-weight:500;margin:5px 0 8px}.mypage-v2 .quiet-link{border:0;background:none;padding:0;color:#999;font-size:.66rem}.quiet-link span{margin-left:5px}
.mypage-v2 .balance{display:grid;grid-template-columns:auto auto;column-gap:7px;align-items:center;border:0;background:none;padding:12px 0 12px 12px;color:#555}.balance #coinBalance{font-size:1.14rem;font-variant-numeric:tabular-nums;letter-spacing:-.03em}.balance small{grid-column:1/-1;text-align:right;color:#aaa;font-size:.61rem;margin-top:4px}.coin-mark{display:inline-flex;align-items:center;justify-content:center;border:1px solid #c6bda9;border-radius:50%;width:17px;height:17px;font-size:10px;color:#9d9075}
.mypage-v2 .stats{display:grid;grid-template-columns:repeat(3,1fr);padding:16px 0;margin-bottom:25px;background:var(--soft);border-radius:4px}.stats>div{display:flex;flex-direction:column;align-items:center;gap:6px;border-right:1px solid var(--line)}.stats>div:last-child{border-right:0}.stats strong{font-size:1rem;font-weight:500;font-variant-numeric:tabular-nums}.stats span{font-size:.62rem;color:#999}
.mypage-v2 .main-tabs{display:flex;gap:26px;border-bottom:1px solid var(--line);margin-bottom:24px}.main-tabs button{display:flex;align-items:center;gap:6px;position:relative;padding:0 0 13px;border:0;background:none;font-size:.82rem;color:#aaa}.main-tabs button[aria-selected=true]{color:#444}.main-tabs button[aria-selected=true]::after{content:'';position:absolute;bottom:-1px;left:0;right:0;height:2px;background:#625c51}.tab-count{font-size:.58rem;background:#eee9df;padding:1px 5px;border-radius:3px;color:#8c7a5b}
.mypage-v2 .panel-heading{display:flex;justify-content:space-between;align-items:center;gap:12px;margin-bottom:22px}.panel-heading h2{font-size:.86rem;font-weight:500;line-height:1.6}.panel-heading p{font-size:.66rem;color:#999;line-height:1.8;margin-top:5px}.collection-count{font-size:.72rem;white-space:nowrap;color:#aaa}.collection-count b{font-weight:500;color:#555}.collection-count small{display:block;text-align:right;margin-top:5px;font-size:.59rem}
.mypage-v2 .filters{display:flex;flex-wrap:wrap;gap:5px;margin-bottom:10px}.filters button{padding:5px 9px;border:1px solid transparent;border-radius:3px;background:none;color:#aaa;font-size:.64rem}.filters button[aria-pressed=true]{background:#f3f0e9;color:#625c51}
.mypage-v2 .mission-row{display:flex;gap:14px;padding:19px 2px;border-bottom:1px solid #eee}.mission-icon{flex:0 0 28px;width:28px;height:28px;color:#777;margin-top:3px}.mission-icon svg,.mission-icon img{display:block;width:100%;height:100%;object-fit:contain}.mission-content{flex:1;min-width:0}.mission-title{display:flex;justify-content:space-between;align-items:center;gap:10px}.mission-title h3{font-size:.78rem;font-weight:500;line-height:1.6}.mission-value{font-size:.65rem;color:#aaa;font-variant-numeric:tabular-nums}.mission-condition{font-size:.63rem;line-height:1.8;color:#999;margin-top:3px!important}.mission-progress{height:3px;background:#efede8;border-radius:2px;margin-top:12px;overflow:hidden}.mission-progress>span{display:block;height:100%;background:#b5ad9e}.mission-bottom{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-top:10px;min-height:26px}.mission-reward{font-size:.64rem;color:#999}.claim-button{padding:4px 10px;border:1px solid transparent;border-radius:3px;background:none;color:#aaa;font-size:.63rem!important}.claim-button.claim-ready{border-color:#d8d0bf;background:#f6f2e9;color:#776648}.is-complete .mission-icon{color:#aaa}.is-complete .mission-progress>span{background:#d7d2c9}.is-complete .mission-condition{color:#aaa}
.mypage-v2 .draw-stage{display:flex;flex-direction:column;align-items:center;padding:36px 20px 28px;background:var(--soft);border:1px solid #eee9df;border-radius:5px}.draw-badge{display:block;width:54px;height:54px;color:#9c8b6a;margin-bottom:22px}.draw-badge svg{width:100%;height:100%}.draw-caption{font-size:.61rem;letter-spacing:.05em;color:#aa9c84}.draw-stage h3{font-weight:500;font-size:.92rem;margin-top:8px}.draw-swatches{display:flex;gap:9px;margin:22px 0 15px}.draw-swatches i{display:block;width:21px;height:21px;border-radius:50%}.draw-stage p{color:#aaa;font-size:.65rem}.draw-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px;margin-top:12px}.draw-actions button{display:flex;align-items:center;justify-content:space-between;padding:14px 12px;border:1px solid #dcd7cd;border-radius:4px;background:white;color:#555}.draw-actions button:last-child{background:#676155;border-color:#676155;color:white}.draw-actions strong{font-size:.76rem;font-weight:500}.draw-actions span{font-size:.66rem;opacity:.7}.draw-actions button:disabled{opacity:.4}.draw-result{margin-top:25px}.result-heading{display:flex;justify-content:space-between;align-items:center;gap:8px;margin-bottom:12px}.result-heading h3{font-size:.76rem;font-weight:500}.result-heading button{border:0;background:none;padding:0;color:#999;font-size:.64rem}.result-items{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:7px}.result-item{display:flex;gap:10px;align-items:center;padding:12px;border:1px solid var(--line);border-radius:4px}.result-dot{width:24px;height:24px;border-radius:50%;flex:0 0 auto}.result-item b{display:block;font-size:.7rem;font-weight:500}.result-item small{display:block;font-size:.59rem;color:#aaa;margin-top:4px}.result-item.is-epic{background:#f8f5fa}.result-item.is-rare{background:#f5f7fa}.draw-guide{margin-top:25px;font-size:.68rem;color:#999}.draw-guide summary{cursor:pointer}.draw-guide ul{padding-left:17px;line-height:2;margin-top:10px}.demo-note{font-size:.62rem;color:#aaa;line-height:1.8;margin-top:16px!important}
.mypage-v2 .dress-preview{border:1px solid #e8e5df;border-radius:4px;background:var(--soft);padding:20px 18px;margin-bottom:22px}.eyebrow{font-size:.59rem;color:#aaa}.preview-ranking{display:flex;align-items:center;gap:14px;margin:18px 0;font-size:.9rem;line-height:1.5}.sample-rank{font-size:.7rem;color:#aaa}.sample-value{margin-left:auto;font-size:.7rem;color:#999}.dress-preview p{font-size:.62rem;color:#999}.wardrobe-tabs{display:flex;gap:20px;margin-bottom:18px}.wardrobe-tabs button{padding:0 0 7px;border:0;border-bottom:1px solid transparent;background:none;color:#aaa;font-size:.72rem}.wardrobe-tabs button[aria-selected=true]{color:#555;border-bottom-color:#888}.item-grid{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:6px}.icon-item{display:flex;flex-direction:column;align-items:center;gap:9px;padding:15px 4px 11px;border:1px solid var(--line);border-radius:4px;background:white;color:#666;min-width:0}.icon-item[aria-pressed=true]{border-color:#a9a08e;background:#faf8f4}.item-icon{display:block;width:28px;height:28px}.item-icon svg,.item-icon img{display:block;width:100%;height:100%;object-fit:contain}.icon-item>span:last-of-type{font-size:.63rem}.icon-item small{font-size:.52rem;color:#aaa;word-break:keep-all;line-height:1.5;text-align:center}.icon-item.locked{color:#d2cec7;background:#fdfdfc}.icon-item.locked img{opacity:.25}
.mypage-v2 .helper{font-size:.64rem;color:#999;line-height:1.8;margin:14px 0!important}.color-tools{display:flex;justify-content:space-between;align-items:center;font-size:.7rem;color:#888;margin-bottom:12px}.color-tools button{padding:0;border:0;background:none;color:#999;font-size:.62rem}.color-inventory{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:6px}.color-item{display:flex;flex-direction:column;align-items:center;gap:8px;padding:12px 5px;border:1px solid var(--line);border-radius:4px;background:white;color:#666}.color-item[aria-pressed=true]{border-color:#a9a08e;background:#faf8f4}.color-item i{width:26px;height:26px;border-radius:50%;display:block}.color-item b{font-size:.65rem;font-weight:400}.color-item small{font-size:.53rem;color:#aaa}.appearance-options{margin:22px 0 0;padding:0;border:0}.appearance-options legend{font-size:.65rem;color:#999;margin-bottom:10px}.appearance-options>div{display:flex;gap:6px;margin-bottom:7px}.appearance-options button{padding:5px 10px;border:1px solid var(--line);border-radius:3px;background:white;color:#999;font-size:.62rem}.appearance-options button[aria-pressed=true]{border-color:#a9a08e;color:#555;background:#faf8f4}
.mypage-v2 .effect-inventory{display:flex;flex-direction:column;gap:6px}.effect-item{display:flex;align-items:center;gap:10px;padding:12px;border:1px solid var(--line);border-radius:4px;background:white;color:#777;text-align:left}.effect-item[aria-pressed=true]{border-color:#a9a08e;background:#faf8f4}.effect-item>span{font-size:.7rem}.effect-item small{margin-left:auto;color:#aaa;font-size:.59rem}.effect-item:disabled{opacity:.4}.effect-mark{display:block;width:20px;height:20px;border-radius:50%;background:linear-gradient(135deg,#999 35%,#eee 50%,#999 65%)}
.mypage-v2 .dress-footer{display:flex;align-items:center;justify-content:space-between;gap:12px;border-top:1px solid var(--line);margin-top:24px;padding-top:16px}.dress-footer span{font-size:.63rem;color:#999;line-height:1.7}.dress-footer button{flex:0 0 auto;padding:9px 18px;border:0;border-radius:4px;background:#676155;color:white;font-size:.7rem}.prototype-footer{border-top:1px solid var(--line);margin-top:35px;padding-top:18px;font-size:.59rem;color:#aaa;line-height:1.9}.prototype-footer a{display:inline-block;margin-top:9px}.prototype-footer .icon-credit{margin-top:8px}.prototype-footer .icon-credit a{margin-top:0}
.mypage-v2 #previewToast{position:fixed;bottom:24px;left:50%;transform:translateX(-50%);z-index:1000;max-width:85vw;padding:11px 18px;border-radius:5px;background:#565147;color:white;font-size:.72rem;line-height:1.6;box-shadow:0 3px 20px #0001}
