---
import PageLayout from '../../../layouts/PageLayout.astro';
const files=import.meta.glob('../../../../public/icons/**/*.svg',{query:'?raw',import:'default',eager:true});
const candidates=[
 {name:'현재 · C 동전',source:'Akar · coin',file:'akar/coin.svg',note:'옆면이 있는 동전'},
 {name:'납작한 동전',source:'Phosphor · coin',file:'coin-candidates/phosphor-coin.svg',note:'추천 · 작은 크기에서도 두께가 잘 보임'},
 {name:'동전 두 개',source:'Phosphor · coins',file:'coin-candidates/phosphor-coins.svg',note:'겹친 동전으로 재화 느낌'},
 {name:'얇은 동전',source:'Remix · coin-line',file:'coin-candidates/remix-coin.svg',note:'문양 없이 단순한 모양'},
 {name:'동전 더미',source:'Tabler · coins',file:'coin-candidates/tabler-coins.svg',note:'여러 개 쌓인 모양'},
 {name:'달러 동전',source:'Tabler · coin',file:'coin-candidates/tabler-coin.svg',note:'기존 사이트 아이콘과 같은 선 스타일'},
];
const raw=(file)=>String(files[`../../../../public/icons/${file}`]??'');
---
<PageLayout title="코인 아이콘 후보">
  <meta slot="head" name="robots" content="noindex, nofollow"/>
  <section class="candidates">
    <p class="intro">아이콘 형태는 원본 그대로입니다. 잔액과 뽑기 비용에서 쓰는 크기로 비교합니다.</p>
    {candidates.map((c,i)=><article>
      <div class="candidate-heading"><span class="large-icon" aria-hidden="true"><Fragment set:html={raw(c.file)}/></span><div><h2>{i+1}. {c.name}</h2><p>{c.source}</p></div></div>
      <div class="examples"><span class="amount balance" aria-label="1,240 코인"><span class="icon" aria-hidden="true"><Fragment set:html={raw(c.file)}/></span><span>1,240</span></span><div class="draw"><span>1회 뽑기</span><span class="amount price" aria-label="100 코인"><span class="icon" aria-hidden="true"><Fragment set:html={raw(c.file)}/></span><span>100</span></span></div><span class="amount reward" aria-label="80 코인"><span class="icon" aria-hidden="true"><Fragment set:html={raw(c.file)}/></span><span>80</span></span></div>
      <p class="note">{c.note}</p>
    </article>)}
    <p class="links"><a href="/test/mypage-v2/">마이페이지 시안</a></p>
    <p class="credits"><a href="https://akaricons.com/">Akar</a> · <a href="https://phosphoricons.com/">Phosphor</a> · <a href="https://remixicon.com/">Remix</a> · <a href="https://tabler.io/icons">Tabler</a></p>
  </section>
</PageLayout>
<style is:global>
.candidates{width:100%;color:#555}.candidates .intro{font-size:.73rem;color:#999;line-height:1.8;margin:0 0 8px}
.candidates article{padding:18px 0;border-bottom:1px solid #eee}.candidates .candidate-heading{display:flex;align-items:center;gap:12px}.candidates h2{font-size:.8rem;font-weight:400;margin:0}.candidates .candidate-heading p{font-size:.63rem;color:#999;margin:4px 0 0}.candidates .large-icon{display:block;width:24px;height:24px;color:#777;flex-shrink:0}.candidates svg{display:block;width:100%;height:100%;overflow:visible}
.candidates .examples{display:flex;align-items:center;justify-content:space-between;gap:16px;margin-top:16px}.candidates .amount{display:inline-flex;align-items:center;gap:5px;white-space:nowrap;font-variant-numeric:tabular-nums}.candidates .amount>span:last-child{text-box:trim-both cap alphabetic}.candidates .icon{display:block;width:1em;height:1em;flex-shrink:0}.candidates .balance{font-size:.85rem}.candidates .price{font-size:.7rem;color:#999}.candidates .reward{font-size:.66rem;color:#999}.candidates .draw{display:flex;align-items:center;justify-content:center;gap:12px;background:#f4f1eb;border:1px solid #c8c3b8;border-radius:2px;padding:10px 18px;font-size:.8rem;color:#444}.candidates .note{font-size:.66rem;color:#999;margin:12px 0 0}.candidates .links{font-size:.73rem;margin-top:24px}.candidates a{color:#999}.candidates .credits{font-size:.62rem;margin-top:16px}
</style>
