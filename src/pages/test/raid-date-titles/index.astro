---
import PageLayout from '../../../layouts/PageLayout.astro';
import { raids } from '../../../lib/raid-sudoku.js';
---
<PageLayout title="날짜 포함 제목 미리보기" subtitle="261109를 붙인 스도쿠 레이드 제목 · 기존 퍼즐과 같은 글꼴·너비">
  <meta slot="head" name="robots" content="noindex, nofollow" />
  <div class="title-samples">
    {raids.map((puzzle,index) => <section class="title-sample" aria-labelledby={`sample-title-${index}`}>
      <div class="page-heading">
        <h1 id={`sample-title-${index}`} data-sample-title>261109 스도쿠 레이드 {index+1}({puzzle.name})</h1>
        <p class="page-subtitle">{puzzle.summary}</p>
      </div>
      <p class="line-count" aria-live="polite"></p>
    </section>)}
  </div>
</PageLayout>
<style>
  .title-samples { width:100%; }
  .title-sample { width:100%; padding:24px 0; border-top:1px solid #e8e5df; }
  .title-sample .page-heading { margin-bottom:8px; }
  .line-count { min-height:18px; margin:0; color:#999; font-size:.72rem; line-height:18px; text-align:center; }
</style>
<script>
  const samples = [...document.querySelectorAll('.title-sample')];
  function updateLineCounts() {
    for (const sample of samples) {
      const title = sample.querySelector('[data-sample-title]');
      const lines = Math.round(title.getBoundingClientRect().height / parseFloat(getComputedStyle(title).lineHeight));
      sample.querySelector('.line-count').textContent = `현재 화면에서 제목 ${lines}줄`;
    }
  }
  updateLineCounts();
  document.fonts.ready.then(updateLineCounts);
  window.addEventListener('resize', updateLineCounts);
</script>
