---
import PageLayout from '../../layouts/PageLayout.astro';
import '../../styles/nickname.css';
---
<PageLayout title="닉네임">
  <div class="form-wrap">
    <p id="accountLoading" class="nick-status">불러오는 중...</p>
    <button id="googleLogin" class="use-btn" disabled hidden>Google로 로그인</button>
    <form id="nicknameForm" hidden>
      <label for="nickInput" class="nick-label">닉네임</label>
      <input id="nickInput" class="nick-input" type="text" placeholder="닉네임 입력" maxlength="20" required autocomplete="nickname" />
      <button id="useBtn" class="use-btn" type="submit">저장</button>
    </form>
    <p id="nickStatus" class="nick-status" role="status" aria-live="polite"></p>
    <button id="logout" class="logout" hidden>로그아웃</button>
  </div>
</PageLayout>
<style>
[hidden]{display:none!important}.nick-label{font-size:.82rem;color:#888}.logout{display:block;margin:24px auto 0;background:none;border:0;color:#999;font-size:.82rem;text-decoration:underline}
</style>
