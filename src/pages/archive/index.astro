---
import PageLayout from '../../layouts/PageLayout.astro';
const snapshots = import.meta.glob('../../../public/archive/*/snapshot.json', { eager: true, import: 'default' });
const semesters = Object.values(snapshots).sort((a, b) => b.season.localeCompare(a.season));
---
<PageLayout title="archive">
<ul class="list">{semesters.map(({season}) => {
  const [year, term] = season.split('-');
  return <li><a href={`/archive/${season}/`}>{year}년 {term}학기</a></li>;
})}</ul>
</PageLayout>
