---
import PuzzleLayout from '../../layouts/PuzzleLayout.astro';
import PuzzleCompletion from '../../components/PuzzleCompletion.astro';
import NumberPad from '../../components/NumberPad.astro';
import { givens } from '../../lib/liar-sudoku.js';
import '../../styles/daily-sudoku.css';

const puzzleId = '261124_01';
const title = '261124 라이어 스도쿠';
const subtitle = '각 가로줄, 세로줄, 3×3 박스에서 거짓 단서 하나를 고치세요';
---
<PuzzleLayout {title} {puzzleId} {subtitle} description={subtitle}>
  <div slot="rules">
    빈칸을 채워 각 가로줄, 세로줄, 3×3 박스에 1부터 9까지 한 번씩 들어가게 하세요.<br />
    각 가로줄, 세로줄, 3×3 박스에서 주어진 숫자 중 정확히 하나를 다른 숫자로 바꿔야 합니다. 바뀌는 단서는 모두 9개입니다.
  </div>
  <div slot="controls">
    칸을 누른 뒤 숫자 버튼으로 입력하고, 지우기로 입력을 지우세요.<br />
    단서와 같은 숫자를 입력하면 그 단서가 확정됩니다. 단서 칸에 다른 숫자를 직접 입력하면 같은 행·열·3×3 박스의 나머지 단서도 확정됩니다.<br />
    메모하기 버튼이나 M 키로 메모 입력을 켜고 끄세요.
  </div>
  <section id="liarGame" data-puzzle-id={puzzleId} aria-label="라이어 스도쿠">
    <div class="sudoku-board-tools"><button id="liarNotes" class="sudoku-notes-toggle" type="button" aria-pressed="false">메모하기</button></div>
    <div id="liarBoard" class="sudoku-board" role="group" aria-label="9행 9열 라이어 스도쿠">
      {givens.map((clue, index) => <button type="button"
        class:list={['sudoku-cell', { given: !!clue }]}
        data-cell={index} tabindex={index === 0 ? 0 : -1}
        aria-label={`${Math.floor(index / 9) + 1}행 ${index % 9 + 1}열, ${clue ? '단서 ' + clue : '빈칸'}`}>
        {clue ? <span class="liar-clue" aria-hidden="true">{clue}</span> : null}
        <span class="liar-value" aria-hidden="true"></span>
        <span class="notes" aria-hidden="true" hidden>
          {Array.from({ length: 9 }, () => <span></span>)}
        </span>
      </button>)}
    </div>
    <NumberPad id="liarNumbers" max={9} />
    <div class="bottom-buttons">
      <button id="liarErase" type="button">지우기</button>
      <button id="liarReset" type="button" class="danger">초기화</button>
    </div>
  </section>
  <PuzzleCompletion slot="completion" id="liarComplete" />
</PuzzleLayout>

<script>import '../../scripts/liar-sudoku.js';</script>

<style>
  .sudoku-cell { line-height: 1; -webkit-tap-highlight-color: transparent; }
  .sudoku-cell .liar-value { color: #4a6fa5; }
  .sudoku-cell.conflict .liar-value { color: #c34242; }
  @supports (-webkit-text-stroke: 1px) {
    .sudoku-cell:not(.annotated, .confirmed) .liar-clue {
      -webkit-text-stroke: clamp(.75px, .22vw, 1px) currentColor;
      -webkit-text-fill-color: transparent;
    }
  }
  .sudoku-cell.annotated .liar-clue {
    position: absolute;
    top: 7%;
    left: 8%;
    color: #666;
    font-size: 46%;
  }
  .sudoku-cell.given .notes {
    top: 28%;
    bottom: 1px;
    font-size: clamp(7px, 1.9vw, 11px);
  }
</style>
